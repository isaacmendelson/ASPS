{
  "name": "antiscam-extension-tests",
  "version": "0.0.0.2",
  "description": "Test suite for AntiScam Chrome Extension",
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=unit",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathPattern=integration",
    "lint": "eslint ../**.js"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "jest": "29.7.0",
    "jest-chrome": "0.8.0",
    "jest-environment-jsdom": "29.7.0",
    "eslint": "8.56.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/setup/jest.setup.cjs"],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/../$1"
    },
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "../**/*.js",
      "!../tests/**",
      "!../node_modules/**"
    ],
    "transform": {}
  }
}
