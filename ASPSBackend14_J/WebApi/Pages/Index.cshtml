@page
@model WebApi.Pages.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .sidebar { background: #1A2255 !important; }
        .nav-link:hover { background: #0F1238; }
        .nav-link.active { background: #22C55E !important; }
        h1, h2, h3 { font-family: 'Syne', sans-serif; color: #1A2255; }
        .card { border-left: 4px solid #22C55E !important; }
        .btn-primary { background: #1A2255; border-color: #1A2255; }
        .btn-success { background: #22C55E; border-color: #22C55E; }
        .hover-card { transition: transform 0.2s; }
        .hover-card:hover { transform: translateY(-5px); }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-2 d-md-block sidebar vh-100">
                <div class="position-sticky pt-3">
                    <h4 class="text-white px-3">ASPS Admin</h4>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link active text-white" href="/">
                                <i class="fas fa-home"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Users">
                                <i class="fas fa-users"></i> Users
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Devices">
                                <i class="fas fa-mobile-alt"></i> Devices
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/DeviceAlerts">
                                <i class="fas fa-exclamation-triangle"></i> Alerts
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-10 ms-sm-auto px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2">Dashboard</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Error!</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <div class="alert alert-info mt-2">
        <strong>Troubleshooting:</strong>
        <ul class="mb-0">
            <li>Ensure ASPSBackend is running: <code>dotnet run --project ASPSBackend</code></li>
            <li>Check logs for "CQRS Gateway started (tcp://*:5556)"</li>
            <li>Verify port 5556 is listening: <code>netstat -an | grep 5556</code></li>
        </ul>
    </div>
}
                    <div class="text-muted">
                        <i class="fas fa-clock"></i> @DateTime.Now.ToString("MMM dd, yyyy HH:mm")
                    </div>
                </div>

                <!-- Dashboard Cards -->
                <div class="row">
                    <div class="col-xl-3 col-md-6 mb-4">
                        <a href="/Users" class="text-decoration-none">
                            <div class="card shadow h-100 py-2 hover-card">
                                <div class="card-body">
                                    <div class="row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #22C55E;">Total Users</div>
                                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.UsersCount</div>
                                        </div>
                                        <div class="col-auto">
                                            <i class="fas fa-users fa-2x" style="color: #22C55E;"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <a href="/Devices" class="text-decoration-none">
                            <div class="card shadow h-100 py-2 hover-card">
                                <div class="card-body">
                                    <div class="row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #1A2255;">Total Devices</div>
                                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.DevicesCount</div>
                                        </div>
                                        <div class="col-auto">
                                            <i class="fas fa-mobile-alt fa-2x" style="color: #1A2255;"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <a href="/DeviceAlerts" class="text-decoration-none">
                            <div class="card shadow h-100 py-2 hover-card">
                                <div class="card-body">
                                    <div class="row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Alerts (24h)</div>
                                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.AlertsCount</div>
                                        </div>
                                        <div class="col-auto">
                                            <i class="fas fa-exclamation-triangle fa-2x text-warning"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card shadow h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Phishing Sites</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.PhishingWebsitesCount</div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-shield-alt fa-2x text-danger"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="row">
                    <div class="col-12">
                        <div class="card shadow mb-4">
                            <div class="card-header py-3" style="background: #1A2255; color: white;">
                                <h6 class="m-0 font-weight-bold">Quick Actions</h6>
                            </div>
                            <div class="card-body">
                                <a href="/Users" class="btn btn-success me-2">
                                    <i class="fas fa-users"></i> Manage Users
                                </a>
                                <a href="/Devices" class="btn btn-primary me-2">
                                    <i class="fas fa-mobile-alt"></i> View Devices
                                </a>
                                <a href="/DeviceAlerts" class="btn btn-warning me-2">
                                    <i class="fas fa-list"></i> View Alerts
                                </a>
                                <button class="btn btn-secondary" onclick="location.reload()">
                                    <i class="fas fa-sync"></i> Refresh
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
