@page
@model WebApi.Pages.WebsiteCategories.IndexModel
@{
    ViewData["Title"] = "Website Categories";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Website Categories</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a asp-page="Create" class="btn btn-sm btn-primary">
            <i class="fas fa-plus"></i> Add Category
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.Categories == null || !Model.Categories.Any())
{
    <div class="alert alert-info">No categories found.</div>
}
else
{
    var topLevelParents = Model.Categories.Where(c => string.IsNullOrEmpty(c.ParentId)).OrderBy(c => c.Name).ToList();
    var childCategories = Model.Categories.Where(c => !string.IsNullOrEmpty(c.ParentId)).ToList();
    
    <div class="mb-3">
        <span class="badge bg-primary">@Model.Categories.Count categories</span>
        <span class="badge bg-secondary">@topLevelParents.Count groups</span>
    </div>

    <div class="accordion" id="categoriesAccordion">
        @for (int i = 0; i < topLevelParents.Count; i++)
        {
            var parent = topLevelParents[i];
            var children = childCategories.Where(c => c.ParentId == parent.KeyField).OrderBy(c => c.Name).ToList();
            var accordionId = "collapse-" + i;
            
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@accordionId" aria-expanded="@(i == 0 ? "true" : "false")">
                        <i class="fas fa-folder me-2"></i>
                        <strong>@parent.Name</strong>
                        <span class="badge bg-primary ms-2">@children.Count</span>
                    </button>
                </h2>
                <div id="@accordionId" class="accordion-collapse collapse @(i == 0 ? "show" : "")">
                    <div class="accordion-body p-0">
                        @if (children.Any())
                        {
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Category Name</th>
                                        <th>Source</th>
                                        <th>Date Created</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var child in children)
                                    {
                                        <tr>
                                            <td><span class="text-muted me-2">└</span> @child.Name</td>
                                            <td><code>@(child.Source ?? "-")</code></td>
                                            <td>@child.DateCreated.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                <a asp-page="Edit" asp-route-name="@child.Name" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="p-3 text-muted">No child categories</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .accordion-item {
        border: 1px solid #dee2e6;
        margin-bottom: 0.5rem;
        border-radius: 0.5rem !important;
    }
    .accordion-button {
        font-size: 1rem;
    }
    .accordion-button:not(.collapsed) {
        background-color: #e7f1ff;
        color: #0d6efd;
    }
</style>