<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<link rel="icon" href="../favicon.svg" type="image/svg+xml"/>
<meta name="description" content="ASPS for Individuals & Families - Real-time protection against scams for you and your loved ones."/>
<title>Pour les particuliers - ASPS</title>
<link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700;800;900&family=Newsreader:ital,opsz,wght@0,16..72,400;0,16..72,500;0,16..72,600;0,16..72,700;1,16..72,400;1,16..72,500&family=Instrument+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet"/>
<style>
:root {
  --bg-dark: #100E0B;
  --bg-navy: #1A1814;
  --bg-navy-2: #1A1814;
  --bg-navy-3: #1A1814;
  --bg-white: #FFFFFF;
  --bg-light: #F3EFE8;
  --bg-light-2: #E4DDD2;
  --bg-warm-pink: #F3EFE8;
  --bg-warm-purple: #F3EFE8;
  --green-600: #8E1A2A;
  --green-500: #BE3A4B;
  --green-400: #BE3A4B;
  --green-dim: rgba(190, 58, 75, 0.12);
  --purple: #7C3AED;
  --purple-dim: rgba(124,58,237,0.12);
  --cyan: #00D4FF;
  --orange: #FF6B35;
  --orange-dim: rgba(255,107,53,0.12);
  --pink: #EC4899;
  --pink-dim: rgba(236,72,153,0.12);
  --text-white: #FFFFFF;
  --text-light: #E2E8F0;
  --text-muted: #94A3B8;
  --text-dark: #1A1814;
  --text-dark-2: #4A4640;
  --text-dark-3: #6B655C;
  --on-dark-heading: #FFFFFF;
  --on-dark-body: #94A3B8;
  --on-dark-muted: #64748B;
  --on-light-heading: #1A1814;
  --on-light-body: #475569;
  --on-light-muted: #94A3B8;
  --border-dark: rgba(255,255,255,0.08);
  --border-dark-2: rgba(255,255,255,0.12);
  --border-light: #E4DDD2;
  --font-body: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-display: 'Syne', Georgia, serif;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --radius-full: 9999px;
  --transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-body);
  background: var(--bg-white);
  color: var(--text-dark);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; }

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}
@media (min-width: 768px) { .container { padding: 0 40px; } }
@media (min-width: 1024px) { .container { padding: 0 60px; } }

/* Navigation */
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  height: 72px;
  background: rgba(26,24,20,0.97);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border-dark);
}
.nav-inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 40px;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
}
.nav-logo { display: flex; align-items: center; }
.nav-links { display: none; align-items: center; gap: 8px; }
@media (min-width: 1024px) { .nav-links { display: flex; } }
.nav-link {
  padding: 8px 16px;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-muted);
  border-radius: var(--radius-sm);
  transition: var(--transition);
}
.nav-link:hover { color: var(--text-white); background: rgba(255,255,255,0.05); }
.nav-link.active { color: var(--green-400); }
.nav-actions { display: flex; align-items: center; gap: 12px; }
.nav-btn {
  display: inline-flex;
  align-items: center;
  padding: 10px 20px;
  font-size: 0.875rem;
  font-weight: 600;
  border-radius: var(--radius-sm);
  transition: var(--transition);
  border: none;
}
.nav-btn-ghost {
  background: transparent;
  color: var(--text-muted);
  border: 1px solid var(--border-dark-2);
}
.nav-btn-ghost:hover { color: var(--text-white); border-color: rgba(255,255,255,0.25); }
.nav-btn-primary { background: var(--text-white); color: var(--bg-navy); }
.nav-btn-primary:hover { background: var(--bg-light); }

/* Hero */
.hero {
  padding: 160px 0 100px;
  background: linear-gradient(135deg, var(--bg-warm-pink) 0%, var(--bg-warm-purple) 100%);
  position: relative;
  overflow: hidden;
}
.hero-pattern {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle at 2px 2px, rgba(124,58,237,0.06) 1px, transparent 0);
  background-size: 40px 40px;
  pointer-events: none;
}
.hero-inner {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr;
  gap: 60px;
  align-items: center;
}
@media (min-width: 1024px) { .hero-inner { grid-template-columns: 1fr 1fr; } }

.hero-content { text-align: center; }
@media (min-width: 1024px) { .hero-content { text-align: left; } }

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 16px;
  background: var(--purple-dim);
  border: 1px solid rgba(124,58,237,0.25);
  border-radius: var(--radius-full);
  margin-bottom: 28px;
}
.hero-badge-icon { font-size: 1rem; }
.hero-badge-text {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--purple);
}

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(2.25rem, 5vw, 3.25rem);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.03em;
  color: var(--on-light-heading);
  margin-bottom: 24px;
}
.hero-title-accent { color: var(--purple); }

.hero-subtitle {
  font-size: 1.1875rem;
  line-height: 1.8;
  color: var(--on-light-body);
  max-width: 520px;
  margin-bottom: 40px;
}
@media (min-width: 1024px) { .hero-subtitle { margin-left: 0; } }
@media (max-width: 1023px) { .hero-subtitle { margin-left: auto; margin-right: auto; } }

.hero-cta { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; }
@media (min-width: 1024px) { .hero-cta { justify-content: flex-start; } }

.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 28px;
  font-size: 0.9375rem;
  font-weight: 600;
  border-radius: var(--radius-md);
  border: none;
  transition: var(--transition);
}
.btn-purple {
  background: linear-gradient(135deg, var(--purple), #9333EA);
  color: var(--text-white);
  box-shadow: 0 4px 20px rgba(124,58,237,0.35);
}
.btn-purple:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(124,58,237,0.45); }
.btn-outline {
  background: var(--bg-white);
  color: var(--on-light-heading);
  border: 1.5px solid var(--border-light);
}
.btn-outline:hover { border-color: var(--purple); color: var(--purple); }
.btn-green {
  background: linear-gradient(135deg, var(--green-500), var(--green-400));
  color: var(--text-white);
  box-shadow: 0 4px 20px rgba(190, 58, 75, 0.35);
}
.btn-green:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(190, 58, 75, 0.45); }

.hero-visual {
  display: none;
  justify-content: center;
}
@media (min-width: 1024px) { .hero-visual { display: flex; } }

.hero-illustration {
  font-size: 12rem;
  filter: drop-shadow(0 20px 40px rgba(124,58,237,0.2));
}

/* Section Styling */
.section { padding: 100px 0; }
.section-light { background: var(--bg-white); }
.section-gray { background: var(--bg-light); }
.section-dark { background: linear-gradient(180deg, var(--bg-navy) 0%, var(--bg-navy-2) 100%); }

.section-header { max-width: 700px; margin-bottom: 60px; }
.section-header.center { text-align: center; margin-left: auto; margin-right: auto; }

.section-label {
  display: inline-flex;
  padding: 8px 16px;
  background: var(--green-dim);
  border-radius: var(--radius-full);
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--green-500);
  margin-bottom: 20px;
}
.section-label.purple { background: var(--purple-dim); color: var(--purple); }
.section-label.pink { background: var(--pink-dim); color: var(--pink); }
.section-label.light { background: rgba(255,255,255,0.1); color: var(--green-400); }

.section-title {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.03em;
  color: var(--on-light-heading);
  margin-bottom: 16px;
}
.section-title.light { color: var(--text-white); }

.section-subtitle {
  font-size: 1.125rem;
  line-height: 1.8;
  color: var(--on-light-body);
}
.section-subtitle.light { color: var(--text-light); }

/* Audience Tabs */
.audience-tabs {
  display: flex;
  justify-content: center;
  gap: 16px;
  margin-bottom: 60px;
}

.audience-tab {
  padding: 16px 32px;
  background: var(--bg-white);
  border: 2px solid var(--border-light);
  border-radius: var(--radius-lg);
  font-size: 1rem;
  font-weight: 600;
  color: var(--on-light-body);
  cursor: pointer;
  transition: var(--transition);
}
.audience-tab:hover { border-color: var(--purple); color: var(--purple); }
.audience-tab.active {
  background: var(--purple);
  border-color: var(--purple);
  color: var(--text-white);
}

/* Features Grid */
.features-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}
@media (min-width: 768px) { .features-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .features-grid { grid-template-columns: repeat(3, 1fr); } }

.feature-card {
  padding: 36px 28px;
  background: var(--bg-white);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-xl);
  transition: var(--transition);
}
.feature-card:hover {
  border-color: var(--purple);
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(124,58,237,0.1);
}

.feature-icon {
  width: 64px;
  height: 64px;
  background: var(--bg-light);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.75rem;
  margin-bottom: 24px;
}

.feature-card h3 {
  font-size: 1.1875rem;
  font-weight: 700;
  color: var(--on-light-heading);
  margin-bottom: 12px;
}

.feature-card p {
  font-size: 1rem;
  color: var(--on-light-body);
  line-height: 1.7;
}

/* Use Cases */
.use-cases-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
}
@media (min-width: 768px) { .use-cases-grid { grid-template-columns: repeat(2, 1fr); } }

.use-case-card {
  padding: 40px 32px;
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border-dark);
  border-radius: var(--radius-xl);
  transition: var(--transition);
}
.use-case-card:hover {
  background: rgba(124,58,237,0.08);
  border-color: rgba(124,58,237,0.3);
}

.use-case-icon {
  width: 72px;
  height: 72px;
  background: var(--purple-dim);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  margin-bottom: 24px;
}

.use-case-card h3 {
  font-family: var(--font-display);
  font-size: 1.375rem;
  font-weight: 800;
  color: var(--text-white);
  margin-bottom: 12px;
}

.use-case-card p {
  font-size: 1.0625rem;
  color: var(--text-light);
  line-height: 1.75;
  margin-bottom: 20px;
}

.use-case-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.use-case-list li {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.9375rem;
  color: var(--text-light);
}
.use-case-list li::before {
  content: '✓';
  color: var(--green-400);
  font-weight: 700;
}

/* CTA Section */
.cta-section {
  padding: 100px 0;
  background: linear-gradient(135deg, var(--bg-warm-pink) 0%, var(--bg-warm-purple) 100%);
  text-align: center;
}
.cta-inner {
  max-width: 600px;
  margin: 0 auto;
}
.cta-inner h2 {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 3vw, 2.25rem);
  font-weight: 800;
  color: var(--on-light-heading);
  margin-bottom: 16px;
}
.cta-inner p {
  font-size: 1.125rem;
  color: var(--on-light-body);
  line-height: 1.75;
  margin-bottom: 40px;
}
.cta-buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; }

/* Footer */
.footer {
  padding: 80px 0 40px;
  background: var(--bg-dark);
}
.footer-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 48px;
  margin-bottom: 64px;
}
@media (min-width: 768px) { .footer-grid { grid-template-columns: 2fr 1fr 1fr 1fr; } }
.footer-brand p {
  font-size: 0.9375rem;
  color: var(--on-dark-body);
  line-height: 1.75;
  max-width: 320px;
  margin-top: 20px;
}
.footer-col h4 {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--text-light);
  margin-bottom: 20px;
}
.footer-col a {
  display: block;
  font-size: 0.9375rem;
  color: var(--on-dark-body);
  margin-bottom: 14px;
  transition: var(--transition);
}
.footer-col a:hover { color: var(--green-400); }
.footer-bottom {
  padding-top: 32px;
  border-top: 1px solid var(--border-dark);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
}
.footer-bottom p { font-size: 0.875rem; color: var(--on-dark-muted); }
.footer-links { display: flex; gap: 24px; }
.footer-links a { font-size: 0.875rem; color: var(--on-dark-muted); transition: var(--transition); }
.footer-links a:hover { color: var(--text-light); }
/* Language Dropdown */
.lang-dropdown {
  position: relative;
}
.lang-dropdown-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 8px;
  color: #E2E8F0;
  font-size: 0.8125rem;
  font-weight: 600;
  cursor: pointer;
  transition: 0.25s;
}
.lang-dropdown-btn:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.25);
}
.lang-dropdown-menu {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  min-width: 140px;
  padding: 8px 0;
  background: #1A1814;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 12px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px);
  transition: 0.25s;
  z-index: 100;
}
.lang-dropdown:hover .lang-dropdown-menu,
.lang-dropdown:focus-within .lang-dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}
.lang-option {
  display: block;
  padding: 10px 16px;
  font-size: 0.875rem;
  color: #94A3B8;
  transition: 0.25s;
  text-decoration: none;
}
.lang-option:hover {
  background: rgba(255,255,255,0.05);
  color: #FFFFFF;
}
.lang-option.active {
  color: #BE3A4B;
  font-weight: 600;
}

</style>

<style>
/* EDITORIAL THEME OVERRIDE */
:root{--ed-paper:#FAF7F2;--ed-paper-2:#F3EFE8;--ed-ink:#1A1814;--ed-ink-2:#4A4640;--ed-ink-3:#6B655C;--ed-accent:#BE3A4B;--ed-accent-strong:#8E1A2A;--ed-rule:#E4DDD2;--ed-rule-2:#D7CFC2;--ed-serif:'Frank Ruhl Libre','Newsreader',Georgia,serif}
body{background:var(--ed-paper) !important;color:var(--ed-ink)}
h1,h2,h3,h4,h5,.hero-title,.section-title,.page-hero h1{font-family:var(--ed-serif) !important;font-weight:500 !important;letter-spacing:0 !important}
.hero-title,.section-title{letter-spacing:-.01em !important}
.section-eyebrow,.hero-eyebrow,.hero-badge,.stat-label,.step-num,.stat-value,.footer-col h4,.nav-link,.nav-btn,.btn{font-family:'Syne',Georgia,serif !important}
.why-now,.human-section,.pain-cards-grid,.stats,section[class*="warm"]{background:var(--ed-paper-2) !important}
.hero,.partners,.how-it-works,.footer,footer.footer{background-color:var(--ed-ink) !important}
.hero{background-image:linear-gradient(145deg,var(--ed-ink) 0%,#2A2620 60%,var(--ed-ink) 100%) !important}
.partners,.how-it-works{background-image:none !important}
.nav{background:rgba(26,24,20,0.96) !important}
.nav-link.active{color:var(--ed-accent) !important}
.nav-link.active::after{background:var(--ed-accent) !important}
.btn-green,.cf-btn,button[type="submit"].cf-btn{background:var(--ed-accent) !important;background-image:linear-gradient(135deg,var(--ed-accent),var(--ed-accent-strong)) !important;color:#fff !important;box-shadow:0 4px 20px rgba(190,58,75,0.30) !important}
.hero-badge{background:rgba(190,58,75,0.10) !important;border-color:rgba(190,58,75,0.30) !important}
.hero-badge-dot{background:var(--ed-accent) !important;box-shadow:0 0 12px var(--ed-accent) !important}
.threat-pill-dot.green{background:var(--ed-accent) !important;box-shadow:0 0 8px var(--ed-accent) !important}
.stat-value.green,.stat-value.dark{color:var(--ed-accent) !important}
.hero-stat-value,.hero-title-accent{color:var(--ed-accent) !important}
.pain-card:hover,.intel-card:hover{border-color:var(--ed-accent) !important;box-shadow:0 8px 30px rgba(190,58,75,0.10) !important}
.footer-col a:hover,a:hover{color:var(--ed-accent)}
.origin-body p,.mission-statement,.princ-body,.pullquote-text,.pain-card p,.step-card p,.intel-card p,.human-section p,.epidemic p{font-family:'Newsreader',Georgia,serif}
.cf-input,.cf-textarea,input[type="text"],input[type="email"],textarea,select{background:#FFFFFF !important;border-color:var(--ed-rule-2) !important;color:var(--ed-ink) !important}
.cf-input:focus,.cf-textarea:focus,input:focus,textarea:focus,select:focus{border-color:var(--ed-accent) !important;outline:none !important}
.pain-card,.intel-card,.step-card,.partner-logo{background:#FFFFFF !important;border-color:var(--ed-rule) !important}
.footer a{color:#94A3B8}
.footer a:hover{color:var(--ed-accent)}
section[style*="background:#fff"],section[style*="background:#FFFFFF"],main[style*="background:#fff"]{background:var(--ed-paper) !important}
.page-hero{background:var(--ed-ink) !important}
.contact-info-label,.contact-press strong{color:var(--ed-ink) !important}
.ci-icon{background:rgba(190,58,75,0.10) !important}
.ci-icon svg{stroke:var(--ed-accent) !important}
.contact-press{border-left-color:var(--ed-accent) !important}
.ci-row:hover{color:var(--ed-accent) !important}
html[lang="he"] body{font-family:'Heebo',sans-serif}
.skip-link{background:var(--ed-accent) !important}
</style>
</head>
<body>

<!-- Navigation -->
<nav class="nav">
  <div class="nav-inner">
    <a href="index.html" class="nav-logo">
      <svg width="120" height="32" viewBox="0 0 148 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="0" y="0" width="3" height="40" rx="1.5" fill="url(#logoGrad)"/>
        <text x="12" y="27" font-family="'Syne', serif" font-weight="800" font-size="22" fill="#FFFFFF" letter-spacing="-0.5">ASPS</text>
        <circle cx="20" cy="6" r="4" fill="#BE3A4B"/>
        <circle cx="20" cy="6" r="4" fill="#BE3A4B" opacity="0.4">
          <animate attributeName="r" values="4;8;4" dur="2.5s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.4;0;0.4" dur="2.5s" repeatCount="indefinite"/>
        </circle>
        <circle cx="20" cy="6" r="2" fill="#FFFFFF"/>
        <defs>
          <linearGradient id="logoGrad" x1="0" y1="0" x2="0" y2="40" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#BE3A4B"/>
            <stop offset="100%" stop-color="#8E1A2A"/>
          </linearGradient>
        </defs>
      </svg>
    </a>
    
    <div class="nav-links">
