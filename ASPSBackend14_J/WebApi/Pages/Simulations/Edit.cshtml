@page
@model WebApi.Pages.Simulations.EditModel
@{
    ViewData["Title"] = "Edit Simulation";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-edit"></i> Edit Simulation</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a href="/Simulations" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Simulation Details</h6>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" name="Key" value="@Model.Key" />
                    
                    <div class="mb-3">
                        <label for="Name" class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Name" name="Name" asp-for="Name" required maxlength="200" 
                               placeholder="e.g., Phishing Test Scenario" />
                        <div class="form-text">Give your simulation a descriptive name.</div>
                    </div>

                    <div class="mb-3">
                        <label for="Description" class="form-label">Description</label>
                        <textarea class="form-control" id="Description" name="Description" asp-for="Description" rows="3" maxlength="1000"
                                  placeholder="Describe what this simulation will test..."></textarea>
                        <div class="form-text">Optional: Provide details about the simulation's purpose.</div>
                    </div>

                    <hr class="my-4" />

                    <div class="mb-3">
                        <label class="form-label">Simulation Steps</label>
                        <div id="steps-container">
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> Loading steps...
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="add-step-btn">
                            <i class="fas fa-plus"></i> Add Step
                        </button>
                    </div>

                    <input type="hidden" id="StepsJson" name="StepsJson" asp-for="StepsJson" />

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Update Simulation
                        </button>
                        <a href="/Simulations" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-info">Help</h6>
            </div>
            <div class="card-body">
                <h6><i class="fas fa-question-circle"></i> Editing Simulation</h6>
                <p class="small">Modify the simulation name, description, and steps. Changes will take effect on the next run.</p>
                
                <h6><i class="fas fa-list-ol"></i> Steps</h6>
                <p class="small">Each step defines:</p>
                <ul class="small">
                    <li><strong>Sequence:</strong> Order of execution</li>
                    <li><strong>Delay:</strong> Wait time before step (ms)</li>
                    <li><strong>Target User:</strong> Recipient user</li>
                    <li><strong>Target Device:</strong> Recipient device</li>
                    <li><strong>Alert Type:</strong> UrlAlert, RemoteAccessAlert, TrackUrlAlert</li>
                    <li><strong>Alert Data:</strong> JSON configuration</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Step Editor Modal (Partial) -->
@await Html.PartialAsync("_StepEditorDialog")

@section Scripts {
<script>
    let steps = [];
    let userSearchTimeout = null;

    // DOM elements
    const userSearchInput = document.getElementById('step-user-search');
    const userIdInput = document.getElementById('step-user-id');
    const deviceSelect = document.getElementById('step-device-uid');
    const autocompleteList = document.getElementById('user-autocomplete-list');

    // Load existing steps on page load
    document.addEventListener('DOMContentLoaded', function() {
        const stepsJsonInput = document.getElementById('StepsJson');
        if (stepsJsonInput && stepsJsonInput.value) {
            try {
                steps = JSON.parse(stepsJsonInput.value) || [];
                renderSteps();
            } catch (e) {
                console.error('Failed to parse existing steps:', e);
                renderSteps();
            }
        } else {
            renderSteps();
        }

        // Setup autocomplete
        setupUserAutocomplete();
        
        // Setup save button
        document.getElementById('save-step-btn').addEventListener('click', saveStep);
    });

    // Add Step Button
    document.getElementById('add-step-btn').addEventListener('click', function() {
        openStepEditor(null);
    });

    function setupUserAutocomplete() {
        userSearchInput.addEventListener('input', function() {
            clearTimeout(userSearchTimeout);
            const searchText = this.value.trim();
            
            if (searchText.length < 2) {
                autocompleteList.innerHTML = '';
                return;
            }
            
            userSearchTimeout = setTimeout(() => {
                searchUsers(searchText);
            }, 300);
        });

        userSearchInput.addEventListener('blur', function() {
            // Delay hiding to allow click on autocomplete item
            setTimeout(() => {
                autocompleteList.innerHTML = '';
            }, 200);
        });
    }

    async function searchUsers(searchText) {
        try {
            console.log('Searching users:', searchText);
            const response = await fetch(`/api/simulations/users?search=${encodeURIComponent(searchText)}`);
            
            if (!response.ok) {
                const errorText = await response.text();
                console.error('Search users failed:', response.status, errorText);
                autocompleteList.innerHTML = '<div class="text-danger p-2">Error loading users</div>';
                return;
            }
            
            const users = await response.json();
            console.log('Found users:', users);
            renderUserAutocomplete(users);
        } catch (error) {
            console.error('Error searching users:', error);
            autocompleteList.innerHTML = '<div class="text-danger p-2">Error loading users</div>';
        }
    }

    function renderUserAutocomplete(users) {
        if (users.length === 0) {
            autocompleteList.innerHTML = '<div class="text-muted p-2">No users found</div>';
            return;
        }
        
        let html = '';
        users.forEach(user => {
            const displayName = `${user.firstName || ''} ${user.lastName || ''}`.trim() || 'Unnamed User';
            const details = [user.email, user.phoneNumber].filter(x => x).join(' | ');
            const keyField = user.userKey?.keyField || user.userId || '';
            
            html += `<div onclick="selectUser('${escapeHtml(keyField)}', '${escapeHtml(displayName)}', '${escapeHtml(details)}')" class="user-info">
                <div class="name">${escapeHtml(displayName)}</div>
                <div class="details">${escapeHtml(details)}</div>
            </div>`;
        });
        
        autocompleteList.innerHTML = html;
    }

    function selectUser(userKeyField, displayName, details) {
        userIdInput.value = userKeyField;
        userSearchInput.value = displayName + (details ? ` (${details})` : '');
        autocompleteList.innerHTML = '';
        
        // Load devices for selected user
        loadUserDevices(userKeyField);
    }

    async function loadUserDevices(userKeyField) {
        deviceSelect.innerHTML = '<option value="">Loading devices...</option>';
        deviceSelect.disabled = true;
        
        try {
            console.log('Loading devices for user:', userKeyField);
            const response = await fetch(`/api/simulations/users/${encodeURIComponent(userKeyField)}/devices`);
            
            if (!response.ok) {
                const errorText = await response.text();
                console.error('Load devices failed:', response.status, errorText);
                deviceSelect.innerHTML = '<option value="">Error loading devices</option>';
                return;
            }
            
            const devices = await response.json();
            console.log('Found devices:', devices);
            renderDeviceOptions(devices);
        } catch (error) {
            console.error('Error loading devices:', error);
            deviceSelect.innerHTML = '<option value="">Error loading devices</option>';
        }
    }

    function renderDeviceOptions(devices) {
        if (devices.length === 0) {
            deviceSelect.innerHTML = '<option value="">No devices found for this user</option>';
            deviceSelect.disabled = true;
            return;
        }
        
        let html = '<option value="">-- Select a device --</option>';
        devices.forEach(device => {
            const deviceType = getDeviceTypeDisplay(device.deviceType);
            const osInfo = device.operatingSystem ? ` (${device.operatingSystem})` : '';
            const displayText = `${device.deviceUid} - ${deviceType}${osInfo}`;
            
            html += `<option value="${escapeHtml(device.deviceUid)}">${escapeHtml(displayText)}</option>`;
        });
        
        deviceSelect.innerHTML = html;
        deviceSelect.disabled = false;
    }

    function getDeviceTypeDisplay(deviceType) {
        const types = {
            'Desktop': '🖥️ Desktop',
            'Laptop': '💻 Laptop',
            'Mobile': '📱 Mobile',
            'Tablet': '📱 Tablet',
            'Phone': '📱 Phone',
            'Computer': '🖥️ Computer',
            'Unknown': '❓ Unknown'
        };
        return types[deviceType] || deviceType || 'Unknown';
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function openStepEditor(stepIndex) {
        const modal = new bootstrap.Modal(document.getElementById('stepEditorModal'));
        
        // Clear form
        document.getElementById('step-sequence').value = steps.length + 1;
        document.getElementById('step-delay-ms').value = '0';
        userIdInput.value = '';
        userSearchInput.value = '';
        deviceSelect.innerHTML = '<option value="">-- Select a user first --</option>';
        deviceSelect.disabled = true;
        document.getElementById('step-alert-type').value = 'UrlAlert';
        document.getElementById('step-alert-json').value = '{}';
        document.getElementById('step-priority').value = 'High';
        
        // If editing, populate form
        if (stepIndex !== null && steps[stepIndex]) {
            const step = steps[stepIndex];
            document.getElementById('step-sequence').value = step.Sequence;
            document.getElementById('step-delay-ms').value = step.DelayMs;
            userIdInput.value = step.UserId;
            userSearchInput.value = step.UserId; // Will show ID, can be improved
            document.getElementById('step-alert-type').value = step.AlertType;
            document.getElementById('step-alert-json').value = step.AlertJson;
            document.getElementById('step-priority').value = step.Priority;
            
            // Load devices if we have a user ID
            if (step.UserId) {
                loadUserDevices(step.UserId).then(() => {
                    if (step.DeviceUid) {
                        deviceSelect.value = step.DeviceUid;
                    }
                });
            }
        }
        
        // Store current index for save
        document.getElementById('stepEditorModal').dataset.editingIndex = stepIndex;
        
        modal.show();
    }

    function saveStep() {
        // Validate user selection
        if (!userIdInput.value) {
            alert('Please select a user from the autocomplete list');
            userSearchInput.focus();
            return;
        }
        
        // Validate device selection
        if (!deviceSelect.value) {
            alert('Please select a device');
            deviceSelect.focus();
            return;
        }
        
        const editingIndex = document.getElementById('stepEditorModal').dataset.editingIndex;
        
        const step = {
            Sequence: parseInt(document.getElementById('step-sequence').value),
            DelayMs: parseInt(document.getElementById('step-delay-ms').value),
            UserId: userIdInput.value,
            DeviceUid: deviceSelect.value,
            AlertType: document.getElementById('step-alert-type').value,
            AlertJson: document.getElementById('step-alert-json').value,
            Priority: document.getElementById('step-priority').value
        };
        
        if (editingIndex !== null && editingIndex !== 'null') {
            steps[parseInt(editingIndex)] = step;
        } else {
            steps.push(step);
        }
        
        renderSteps();
        updateStepsJson();
        
        const modal = bootstrap.Modal.getInstance(document.getElementById('stepEditorModal'));
        modal.hide();
    }

    function deleteStep(index) {
        if (confirm('Delete this step?')) {
            steps.splice(index, 1);
            // Renumber sequences
            steps.forEach((s, i) => s.Sequence = i + 1);
            renderSteps();
            updateStepsJson();
        }
    }

    function renderSteps() {
        const container = document.getElementById('steps-container');
        
        if (steps.length === 0) {
            container.innerHTML = '<div class="alert alert-info"><i class="fas fa-info-circle"></i> No steps added yet. Click "Add Step" below.</div>';
            return;
        }
        
        let html = '<table class="table table-sm table-bordered">';
        html += '<thead><tr><th>#</th><th>Delay (ms)</th><th>User</th><th>Device</th><th>Alert Type</th><th>Actions</th></tr></thead>';
        html += '<tbody>';
        
        steps.forEach((step, index) => {
            html += '<tr>';
            html += `<td>${step.Sequence}</td>`;
            html += `<td>${step.DelayMs}</td>`;
            html += `<td><small>${step.UserId}</small></td>`;
            html += `<td><small>${step.DeviceUid}</small></td>`;
            html += `<td><span class="badge bg-info">${step.AlertType}</span></td>`;
            html += `<td>
                <button type="button" class="btn btn-xs btn-sm btn-outline-primary" onclick="openStepEditor(${index})">
                    <i class="fas fa-edit"></i>
                </button>
                <button type="button" class="btn btn-xs btn-sm btn-outline-danger" onclick="deleteStep(${index})">
                    <i class="fas fa-trash"></i>
                </button>
            </td>`;
            html += '</tr>';
        });
        
        html += '</tbody></table>';
        container.innerHTML = html;
    }

    function updateStepsJson() {
        document.getElementById('StepsJson').value = JSON.stringify(steps);
    }
</script>
}
