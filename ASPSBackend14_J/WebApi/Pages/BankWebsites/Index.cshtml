@page
@model WebApi.Pages.BankWebsites.IndexModel
@{
    ViewData["Title"] = "Bank Websites";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Bank Websites</h1>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Bank Websites (@Model.TotalCount)</h6>
        <form method="get" class="d-flex" style="max-width: 500px;">
            <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm me-2" placeholder="Search domain, bank name, country..." />
            <select name="isActive" class="form-select form-select-sm me-2" style="width: 120px;">
                <option value="">All</option>
                <option value="true" selected="@(Model.IsActive == true)">Active</option>
                <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
            </select>
            <button type="submit" class="btn btn-sm btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(Model.Search) || Model.IsActive != null)
            {
                <a href="/BankWebsites" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            }
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="bankWebsitesTable">
                <thead>
                    <tr>
                        <th>Key</th>
                        <th>Domain</th>
                        <th>Bank Name</th>
                        <th>Country</th>
                        <th>Status</th>
                        <th>Date Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bank in Model.BankWebsites)
                    {
                        <tr>
                            <td>@bank.Id</td>
                            <td><code>@bank.Domain</code></td>
                            <td>@bank.BankName</td>
                            <td>
                                @if (!string.IsNullOrEmpty(bank.Country))
                                {
                                    <span class="badge bg-secondary">@bank.Country</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (bank.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Inactive</span>
                                }
                            </td>
                            <td>@bank.DateCreated.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Bank websites pagination">
                <ul class="pagination justify-content-center mb-0 mt-3">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="/BankWebsites?page=@(Model.CurrentPage - 1)@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")@(Model.IsActive != null ? $"&isActive={Model.IsActive}" : "")">Previous</a>
                    </li>

                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                        if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="/BankWebsites?page=1@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")@(Model.IsActive != null ? $"&isActive={Model.IsActive}" : "")">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="/BankWebsites?page=@i@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")@(Model.IsActive != null ? $"&isActive={Model.IsActive}" : "")">@i</a>
                            </li>
                        }

                        if (endPage < Model.TotalPages)
                        {
                            if (endPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="/BankWebsites?page=@Model.TotalPages@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")@(Model.IsActive != null ? $"&isActive={Model.IsActive}" : "")">@Model.TotalPages</a>
                            </li>
                        }
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="/BankWebsites?page=@(Model.CurrentPage + 1)@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")@(Model.IsActive != null ? $"&isActive={Model.IsActive}" : "")">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
