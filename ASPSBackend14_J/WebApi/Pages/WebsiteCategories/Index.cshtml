@page
@model WebApi.Pages.WebsiteCategories.IndexModel
@{
    ViewData["Title"] = "Website Categories";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Website Categories</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a asp-page="Create" class="btn btn-sm btn-primary">
            <i class="fas fa-plus"></i> Add Category
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">All Categories (@Model.TotalCount)</h6>
        <form method="get" class="d-flex" style="max-width: 600px;">
            <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm me-2" placeholder="Search name, source..." />
            <select name="parentId" class="form-select form-select-sm me-2" style="width: 200px;">
                <option value="">All Parents</option>
                @foreach (var parent in Model.AllParents)
                {
                    <option value="@parent.KeyField" selected="@(Model.ParentId == parent.KeyField)">@parent.Name</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.ParentId))
            {
                <a href="/WebsiteCategories" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            }
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="categoriesTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Parent (Category Group)</th>
                        <th>Source</th>
                        <th>Date Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.Categories)
                    {
                        <tr>
                            <td><strong>@category.Name</strong></td>
                            <td>
                                @if (category.Parent != null)
                                {
                                    <span class="badge bg-info">@category.Parent.Name</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(category.Source))
                                {
                                    <code>@category.Source</code>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@category.DateCreated.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                <a asp-page="Edit" asp-route-name="@category.Name" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Website categories pagination">
                <ul class="pagination justify-content-center mb-0 mt-3">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="/WebsiteCategories?page=@(Model.CurrentPage - 1)@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")@(string.IsNullOrEmpty(Model.ParentId) ? "" : $"&parentId={Model.ParentId}")">Previous</a>
                    </li>

                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                        if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="/WebsiteCategories?page=1@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")@(string.IsNullOrEmpty(Model.ParentId) ? "" : $"&parentId={Model.ParentId}")">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="/WebsiteCategories?page=@i@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")@(string.IsNullOrEmpty(Model.ParentId) ? "" : $"&parentId={Model.ParentId}")">@i</a>
                            </li>
                        }

                        if (endPage < Model.TotalPages)
                        {
                            if (endPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="/WebsiteCategories?page=@Model.TotalPages@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")@(string.IsNullOrEmpty(Model.ParentId) ? "" : $"&parentId={Model.ParentId}")">@Model.TotalPages</a>
                            </li>
                        }
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="/WebsiteCategories?page=@(Model.CurrentPage + 1)@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")@(string.IsNullOrEmpty(Model.ParentId) ? "" : $"&parentId={Model.ParentId}")">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
