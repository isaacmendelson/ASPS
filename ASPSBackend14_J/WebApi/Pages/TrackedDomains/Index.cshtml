@page
@model WebApi.Pages.TrackedDomains.IndexModel
@{
    ViewData["Title"] = "Tracked Domains";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Tracked Domains</h1>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Add Tracked Domain</h6>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Add" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="NewDomain">Domain <span class="text-danger">*</span></label>
                <input type="text" class="form-control form-control-sm" id="NewDomain"
                       asp-for="NewDomain" required placeholder="evil-bank.example" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="NewCategory">Category</label>
                <select class="form-select form-select-sm" id="NewCategory" asp-for="NewCategory">
                    @foreach (var wt in Model.CategoryNames)
                    {
                        <option value="@wt" selected="@(Model.NewCategory == wt)">@wt</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="NewTrackMode">Track mode</label>
                <select class="form-select form-select-sm" id="NewTrackMode" asp-for="NewTrackMode">
                    <option value="0">None</option>
                    <option value="1" selected>Surf (once per domain)</option>
                    <option value="2">Click (every navigation)</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="NewUserKey">User key</label>
                <input type="text" class="form-control form-control-sm" id="NewUserKey"
                       asp-for="NewUserKey" placeholder="(all devices of user)" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="NewReason">Reason</label>
                <input type="text" class="form-control form-control-sm" id="NewReason"
                       asp-for="NewReason" placeholder="optional" />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-sm btn-primary w-100">Add</button>
            </div>
        </form>
        <small class="text-muted d-block mt-2">
            Persists the domain and syncs it to every device of the given user
            (empty user key = persist only, no device fan-out).
        </small>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Tracking Domains (@Model.TotalCount)</h6>
        <form method="get" class="d-flex" style="max-width: 400px;">
            <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm me-2" placeholder="Search domain, category..." />
            <select name="category" class="form-select form-select-sm me-2" style="width: auto;">
                <option value="">All Categories</option>
                @foreach (var wt in Model.CategoryNames)
                {
                    <option value="@wt" selected="@(Model.Category == wt)">@wt</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Category))
            {
                <a href="/TrackedDomains" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            }
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="trackedDomainsTable">
                <thead>
                    <tr>
                        <th>Key</th>
                        <th>Domain</th>
                        <th>Category</th>
                        <th>Track Mode</th>
                        <th>User name</th>
                        <th>User Key</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Date Created</th>
                        <th>Date Modified</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var domain in Model.TrackedDomains)
                    {
                        <tr>
                            <td>@domain.Id</td>
                            <td><code>@domain.Domain</code></td>
                            <td>
                                @if (domain.Category == "Analytics")
                                {
                                    <span class="badge bg-primary">@domain.Category</span>
                                }
                                else if (domain.Category == "Advertising")
                                {
                                    <span class="badge bg-warning text-dark">@domain.Category</span>
                                }
                                else if (domain.Category == "Social")
                                {
                                    <span class="badge bg-info">@domain.Category</span>
                                }
                                else if (domain.Category == "Tracking")
                                {
                                    <span class="badge bg-danger">@domain.Category</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@domain.Category</span>
                                }
                            </td>
                            <td>
                                @switch (domain.TrackMode)
                                {
                                    case 0:
                                        <span class="badge bg-secondary">None</span>
                                        break;
                                    case 2:
                                        <span class="badge bg-danger">Click</span>
                                        break;
                                    default:
                                        <span class="badge bg-info">Surf</span>
                                        break;
                                }
                            </td>
                            <td>@Model.DisplayUserName(domain.UserKey)</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(domain.UserKey))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <code>@domain.UserKey</code>
                                }
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(domain.Reason))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <span title="@domain.Reason">@domain.Reason</span>
                                }
                            </td>
                            <td>
                                @if (domain.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>@domain.DateCreated.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@domain.DateModified.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <form method="post" asp-page-handler="NotifyUser" class="m-0">
                                                <input type="hidden" name="domain" value="@domain.Domain" />
                                                <input type="hidden" name="userKey" value="@domain.UserKey" />
                                                <button type="submit"
                                                        class="dropdown-item @(string.IsNullOrWhiteSpace(domain.UserKey) ? "disabled" : "")"
                                                        @(string.IsNullOrWhiteSpace(domain.UserKey) ? "disabled" : "")>
                                                    <i class="fas fa-bell me-2"></i>Notify @Model.DisplayUserName(domain.UserKey) only
                                                </button>
                                            </form>
                                        </li>
                                        <li>
                                            <form method="post" asp-page-handler="NotifyAll" class="m-0">
                                                <input type="hidden" name="domain" value="@domain.Domain" />
                                                <button type="submit" class="dropdown-item">
                                                    <i class="fas fa-broadcast-tower me-2"></i>Notify all user devices
                                                </button>
                                            </form>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button type="button" class="dropdown-item js-edit-td"
                                                    data-id="@domain.Id"
                                                    data-domain="@domain.Domain"
                                                    data-category="@domain.Category"
                                                    data-userkey="@domain.UserKey"
                                                    data-scamkey="@domain.ScamInProgressKey"
                                                    data-trackmode="@domain.TrackMode"
                                                    data-reason="@domain.Reason"
                                                    data-isactive="@(domain.IsActive ? "true" : "false")"
                                                    data-bs-toggle="modal" data-bs-target="#editTdModal">
                                                <i class="fas fa-edit me-2"></i>Edit
                                            </button>
                                        </li>
                                        <li>
                                            <form method="post" asp-page-handler="Delete" class="m-0"
                                                  onsubmit="return confirm('Delete tracked domain @domain.Domain?');">
                                                <input type="hidden" name="id" value="@domain.Id" />
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="fas fa-trash me-2"></i>Delete
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Tracked domains pagination">
                <ul class="pagination justify-content-center mb-0 mt-3">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="/TrackedDomains?page=@(Model.CurrentPage - 1)@(BuildQueryString(Model.Search, Model.Category))">Previous</a>
                    </li>

                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                        if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="/TrackedDomains?page=1@(BuildQueryString(Model.Search, Model.Category))">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="/TrackedDomains?page=@i@(BuildQueryString(Model.Search, Model.Category))">@i</a>
                            </li>
                        }

                        if (endPage < Model.TotalPages)
                        {
                            if (endPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="/TrackedDomains?page=@Model.TotalPages@(BuildQueryString(Model.Search, Model.Category))">@Model.TotalPages</a>
                            </li>
                        }
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="/TrackedDomains?page=@(Model.CurrentPage + 1)@(BuildQueryString(Model.Search, Model.Category))">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

<!-- Shared Edit modal — populated by JS from the clicked row's data-* attrs -->
<div class="modal fade" id="editTdModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Tracked Domain</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="edit-id" />
                    <div class="mb-3">
                        <label class="form-label">Domain</label>
                        <input type="text" name="domain" id="edit-domain" class="form-control form-control-sm" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select name="category" id="edit-category" class="form-select form-select-sm">
                            @foreach (var wt in Model.CategoryNames)
                            {
                                <option value="@wt">@wt</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Track mode</label>
                        <select name="trackMode" id="edit-trackmode" class="form-select form-select-sm">
                            <option value="0">None</option>
                            <option value="1">Surf (once per domain)</option>
                            <option value="2">Click (every navigation)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">User key</label>
                        <input type="text" name="userKey" id="edit-userkey" class="form-control form-control-sm" placeholder="(none / global)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Scam-in-progress key</label>
                        <input type="text" name="scamInProgressKey" id="edit-scamkey" class="form-control form-control-sm" placeholder="(optional)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reason</label>
                        <textarea name="reason" id="edit-reason" class="form-control form-control-sm" rows="2" maxlength="500" placeholder="(optional)"></textarea>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" name="isActive" id="edit-isactive" value="true" class="form-check-input" />
                        <label class="form-check-label" for="edit-isactive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Runs from the layout's Scripts section — AFTER bootstrap.bundle.min.js,
    // so `bootstrap` is guaranteed to be defined here.
    (function () {
        document.querySelectorAll('.js-edit-td').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('edit-id').value = btn.dataset.id || '';
                document.getElementById('edit-domain').value = btn.dataset.domain || '';
                document.getElementById('edit-category').value = btn.dataset.category || '';
                document.getElementById('edit-trackmode').value = btn.dataset.trackmode || '1';
                document.getElementById('edit-reason').value = btn.dataset.reason || '';
                document.getElementById('edit-userkey').value = btn.dataset.userkey || '';
                document.getElementById('edit-scamkey').value = btn.dataset.scamkey || '';
                document.getElementById('edit-isactive').checked = (btn.dataset.isactive === 'true');
            });
        });

        // Fix: the Actions dropdown is clipped by .table-responsive
        // (overflow:auto). Pre-create each dropdown with Popper
        // strategy:'fixed' so the menu is positioned against the viewport
        // and escapes the scroll box.
        document.querySelectorAll('#trackedDomainsTable [data-bs-toggle="dropdown"]').forEach(function (el) {
            bootstrap.Dropdown.getOrCreateInstance(el, {
                popperConfig: function (defaultConfig) {
                    return Object.assign({}, defaultConfig, { strategy: 'fixed' });
                }
            });
        });
    })();
</script>
}

@functions {
    string BuildQueryString(string? search, string? category)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(search))
            parts.Add($"search={Uri.EscapeDataString(search)}");
        if (!string.IsNullOrEmpty(category))
            parts.Add($"category={Uri.EscapeDataString(category)}");
        return parts.Count > 0 ? "&" + string.Join("&", parts) : "";
    }
}
