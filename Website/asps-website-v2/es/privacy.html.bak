<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<link rel="icon" href="../favicon.svg" type="image/svg+xml"/>
<link rel="apple-touch-icon" href="../favicon.svg"/>
<meta name="description" content="Privacy Policy ASPS Anti-Scam Protection Systems."/>
<meta property="og:type" content="website"/>
<meta property="og:title" content="Privacy Policy ASPS"/>
<meta property="og:description" content="How ASPS collects, uses, and protects your personal data."/>
<meta property="og:image" content="https://asps.io/assets/og/og-FINAL.png"/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:image" content="https://asps.io/assets/og/og-FINAL.png"/>
  <meta property="og:url" content="https://asps.io/privacy.html"/>
<link rel="canonical" href="https://asps.io/privacy.html"/>
<title>Privacidad - ASPS</title>
<link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700;800;900&family=Newsreader:ital,opsz,wght@0,16..72,400;0,16..72,500;0,16..72,600;0,16..72,700;1,16..72,400;1,16..72,500&family=Instrument+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:'Instrument Sans',sans-serif;background:#FAFAF8;color:#1A1814;overflow-x:clip}

/* ── SKIP LINK ── */
.skip-link{
  position:absolute;
  top:-100%;
  left:1rem;
  background:#BE3A4B;
  color:#fff;
  padding:8px 16px;
  border-radius:0 0 8px 8px;
  font-weight:700;
  z-index:9999;
  transition:top 0.2s;
  text-decoration:none;
}
.skip-link:focus{top:0}

/* ── FOCUS STYLES ── */
a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
[role="button"]:focus-visible,
[tabindex]:not([tabindex="-1"]):focus-visible{
  outline:3px solid #BE3A4B;
  outline-offset:3px;
}

/* Nav login remove permanent outline, only show on keyboard focus */
.nav-login{
  outline:none;
}
.nav-login:focus-visible{
  outline:3px solid #BE3A4B;
  outline-offset:3px;
}

/* ── REDUCED MOTION ── */
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{
    animation-duration:0.01ms !important;
    animation-iteration-count:1 !important;
    transition-duration:0.01ms !important;
  }
}

/* ── NAV ── */
nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  height:68px;padding:0 60px;
  display:flex;align-items:center;gap:40px;
  background:rgba(26,24,20,0.95);
  backdrop-filter:blur(20px);
  border-bottom:1px solid rgba(255,255,255,0.12);
}
.logo{margin-right:auto;display:block}
.logo-svg{display:block;flex-shrink:0}
nav a{font-size:.84rem;color:#7880A8;text-decoration:none;transition:.2s}
nav a:hover{color:#C8CCE8}
.nav-login{padding:9px 20px;border-radius:8px;background:transparent;border:1.5px solid rgba(255,255,255,0.2);color:#C8CCE8;font-size:.84rem;font-weight:600;transition:.2s;cursor:pointer;text-decoration:none;font-family:'Instrument Sans',sans-serif}
.nav-login:hover{border-color:rgba(255,255,255,0.45);color:#fff;background:rgba(255,255,255,0.05)}
.nav-cta{padding:9px 20px;border-radius:8px;background:#fff;color:#1A1814;font-size:.84rem;font-weight:700;transition:.2s;cursor:pointer}
.nav-cta:hover{background:#EEF0FF}

/* ── PAGE HERO ── */
.page-hero{background:#1A1814;padding:120px 24px 60px;text-align:center}
.page-hero-eyebrow{
  font-family:'Syne',sans-serif;font-weight:700;font-size:.75rem;
  letter-spacing:.12em;text-transform:uppercase;
  color:#BE3A4B;margin-bottom:12px;
}
.page-hero h1{
  font-family:'Syne',sans-serif;font-weight:800;
  font-size:2.2rem;color:#fff;
  margin:0 0 12px;line-height:1.2;
}
.page-hero p{color:#7880A8;font-size:1rem;margin:0}

/* ── CONTENT ── */
.privacy-wrap{
  max-width:760px;
  margin:0 auto;
  padding:64px 24px 100px;
}
.effective-date{
  font-size:.82rem;color:#7880A8;
  margin-bottom:48px;
  padding-bottom:20px;
  border-bottom:1px solid rgba(26,34,85,0.1);
}
.privacy-section{margin-bottom:44px}
.privacy-section h2{
  font-family:'Syne',sans-serif;font-weight:600;
  font-size:1.15rem;color:#1A1814;
  margin:0 0 12px;
}
.privacy-section p,
.privacy-section ul{
  font-family:'Instrument Sans',sans-serif;font-size:.95rem;
  color:#4A5280;line-height:1.8;margin:0;
}
.privacy-section ul{padding-left:20px;margin-top:8px}
.privacy-section ul li{margin-bottom:6px}
.privacy-section a{color:#BE3A4B;text-decoration:none}
.privacy-section a:hover{text-decoration:underline}
.notice-box{
  background:#EDF8F1;
  border-left:4px solid #BE3A4B;
  border-radius:0 8px 8px 0;
  padding:14px 18px;
  margin-top:12px;
  font-family:'Instrument Sans',sans-serif;font-size:.88rem;
  color:#1A4A2E;line-height:1.65;
}

/* ── FOOTER ── */
footer{
  background:#0E1428;
  padding:40px 60px;
  display:flex;align-items:center;justify-content:space-between;
  border-top:1px solid rgba(255,255,255,0.10);
}
.f-copy{font-size:.78rem;color:#404870}
.f-links{display:flex;gap:24px}
.f-links a{font-size:.78rem;color:#3A4068;text-decoration:none}
.f-links a:hover{color:#BE3A4B}

/* ── MOBILE ── */
/* ═══════════════════════════════════════════════════════════
   EXTRA LARGE SCREENS  1440px+
═══════════════════════════════════════════════════════════ */
@media(min-width:1440px){
  nav{
    padding:0 calc((100vw - 1320px) / 2);
  }
  footer{
    padding-left:calc((100vw - 1320px) / 2);
    padding-right:calc((100vw - 1320px) / 2);
  }
}

/* ═══════════════════════════════════════════════════════════
   ULTRA WIDE SCREENS  1920px+
═══════════════════════════════════════════════════════════ */
@media(min-width:1920px){
  nav{
    padding:0 calc((100vw - 1600px) / 2);
  }
  footer{
    padding-left:calc((100vw - 1600px) / 2);
    padding-right:calc((100vw - 1600px) / 2);
  }
}

@media(max-width:768px){
  nav{padding:0 20px;gap:0;height:60px}
  nav a:not(.nav-cta):not(.logo){display:none}
  .logo{margin-right:auto}
  .nav-cta{font-size:.78rem;padding:7px 14px;flex-shrink:0}
  .page-hero{padding:100px 20px 48px}
  .page-hero h1{font-size:1.8rem}
  footer{flex-direction:column;align-items:center;text-align:center;gap:20px;padding:36px 20px}
  .f-links{flex-wrap:wrap;justify-content:center;gap:14px 20px}
}
@media(max-width:480px){
  nav{padding:0 14px}
  .nav-cta{padding:6px 12px;font-size:.73rem}
  .nav-login{padding:6px 12px;font-size:.73rem}
  footer{padding:28px 16px;gap:16px}
  .f-links{gap:10px 16px}
}
/* Language Dropdown */
.lang-dropdown {
  position: relative;
}
.lang-dropdown-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 8px;
  color: #E2E8F0;
  font-size: 0.8125rem;
  font-weight: 600;
  cursor: pointer;
  transition: 0.25s;
}
.lang-dropdown-btn:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.25);
}
.lang-dropdown-menu {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  min-width: 140px;
  padding: 8px 0;
  background: #1A1814;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 12px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px);
  transition: 0.25s;
  z-index: 100;
}
.lang-dropdown:hover .lang-dropdown-menu,
.lang-dropdown:focus-within .lang-dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}
.lang-option {
  display: block;
  padding: 10px 16px;
  font-size: 0.875rem;
  color: #94A3B8;
  transition: 0.25s;
  text-decoration: none;
}
.lang-option:hover {
  background: rgba(255,255,255,0.05);
  color: #FFFFFF;
}
.lang-option.active {
  color: #BE3A4B;
  font-weight: 600;
}

</style>

<style>
/* EDITORIAL THEME OVERRIDE */
:root{--ed-paper:#FAF7F2;--ed-paper-2:#F3EFE8;--ed-ink:#1A1814;--ed-ink-2:#4A4640;--ed-ink-3:#6B655C;--ed-accent:#BE3A4B;--ed-accent-strong:#8E1A2A;--ed-rule:#E4DDD2;--ed-rule-2:#D7CFC2;--ed-serif:'Frank Ruhl Libre','Newsreader',Georgia,serif}
body{background:var(--ed-paper) !important;color:var(--ed-ink)}
h1,h2,h3,h4,h5,.hero-title,.section-title,.page-hero h1{font-family:var(--ed-serif) !important;font-weight:500 !important;letter-spacing:0 !important}
.hero-title,.section-title{letter-spacing:-.01em !important}
.section-eyebrow,.hero-eyebrow,.hero-badge,.stat-label,.step-num,.stat-value,.footer-col h4,.nav-link,.nav-btn,.btn{font-family:'Syne',Georgia,serif !important}
.why-now,.human-section,.pain-cards-grid,.stats,section[class*="warm"]{background:var(--ed-paper-2) !important}
.hero,.partners,.how-it-works,.footer,footer.footer{background-color:var(--ed-ink) !important}
.hero{background-image:linear-gradient(145deg,var(--ed-ink) 0%,#2A2620 60%,var(--ed-ink) 100%) !important}
.partners,.how-it-works{background-image:none !important}
.nav{background:rgba(26,24,20,0.96) !important}
.nav-link.active{color:var(--ed-accent) !important}
.nav-link.active::after{background:var(--ed-accent) !important}
.btn-green,.cf-btn,button[type="submit"].cf-btn{background:var(--ed-accent) !important;background-image:linear-gradient(135deg,var(--ed-accent),var(--ed-accent-strong)) !important;color:#fff !important;box-shadow:0 4px 20px rgba(190,58,75,0.30) !important}
.hero-badge{background:rgba(190,58,75,0.10) !important;border-color:rgba(190,58,75,0.30) !important}
.hero-badge-dot{background:var(--ed-accent) !important;box-shadow:0 0 12px var(--ed-accent) !important}
.threat-pill-dot.green{background:var(--ed-accent) !important;box-shadow:0 0 8px var(--ed-accent) !important}
.stat-value.green,.stat-value.dark{color:var(--ed-accent) !important}
.hero-stat-value,.hero-title-accent{color:var(--ed-accent) !important}
.pain-card:hover,.intel-card:hover{border-color:var(--ed-accent) !important;box-shadow:0 8px 30px rgba(190,58,75,0.10) !important}
.footer-col a:hover,a:hover{color:var(--ed-accent)}
.origin-body p,.mission-statement,.princ-body,.pullquote-text,.pain-card p,.step-card p,.intel-card p,.human-section p,.epidemic p{font-family:'Newsreader',Georgia,serif}
.cf-input,.cf-textarea,input[type="text"],input[type="email"],textarea,select{background:#FFFFFF !important;border-color:var(--ed-rule-2) !important;color:var(--ed-ink) !important}
.cf-input:focus,.cf-textarea:focus,input:focus,textarea:focus,select:focus{border-color:var(--ed-accent) !important;outline:none !important}
.pain-card,.intel-card,.step-card,.partner-logo{background:#FFFFFF !important;border-color:var(--ed-rule) !important}
.footer a{color:#94A3B8}
.footer a:hover{color:var(--ed-accent)}
section[style*="background:#fff"],section[style*="background:#FFFFFF"],main[style*="background:#fff"]{background:var(--ed-paper) !important}
.page-hero{background:var(--ed-ink) !important}
.contact-info-label,.contact-press strong{color:var(--ed-ink) !important}
.ci-icon{background:rgba(190,58,75,0.10) !important}
.ci-icon svg{stroke:var(--ed-accent) !important}
.contact-press{border-left-color:var(--ed-accent) !important}
.ci-row:hover{color:var(--ed-accent) !important}
html[lang="he"] body{font-family:'Heebo',sans-serif}
.skip-link{background:var(--ed-accent) !important}
</style>
</head>
<body>

<!-- SKIP LINK -->
<a href="#main-content" class="skip-link">Skip to main content</a>

<!-- NAV -->
<nav aria-label="Main navigation">
  <a href="index.html" class="logo" aria-label="ASPS Home">
    <svg class="logo-svg" width="148" height="40" viewBox="0 0 148 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="0" y="0" width="3" height="40" rx="1.5" fill="url(#navBarGradPriv)"/>
      <text x="12" y="26" font-family="'Syne', sans-serif" font-weight="800" font-size="22" fill="#FFFFFF" letter-spacing="-0.5">ASPS</text>
      <circle cx="20" cy="6" r="4" fill="#BE3A4B"/>
      <circle cx="20" cy="6" r="4" fill="#BE3A4B" opacity="0.35">
        <animate attributeName="r" values="4;7;4" dur="2.5s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="0.35;0;0.35" dur="2.5s" repeatCount="indefinite"/>
      </circle>
      <circle cx="20" cy="6" r="2" fill="#FFFFFF"/>
      <defs>
        <linearGradient id="navBarGradPriv" x1="0" y1="0" x2="0" y2="40" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#BE3A4B"/>
          <stop offset="100%" stop-color="#8E1A2A"/>
        </linearGradient>
      </defs>
    </svg>
  </a>
  <a href="index.html#vision">Mission</a>
  <a href="index.html#stats">Numbers</a>
  <a href="index.html#approach">Approach</a>
  <a href="index.html#team">Team</a>
  <div class="nav-cta" role="button" tabindex="0" onclick="location.href='index.html#contact'" onkeydown="if(event.key==='Enter'||event.key===' '){location.href='index.html#contact'}">Talk to us</div>
</nav>

<!-- PAGE HERO -->
<div class="page-hero">
  <div class="page-hero-eyebrow">Legal</div>
  <h1>Politique de confidentialité</h1>
  <p>How we handle your data clearly and honestly.</p>
</div>

<!-- CONTENT -->
<main id="main-content" role="main" style="background:#FAFAF8">
  <div class="privacy-wrap">

    <div class="effective-date">
      <strong>Effective Date:</strong> February 26, 2026
    </div>

    <!-- 1. Who We Are -->
    <div class="privacy-section">
      <h2>1. Who We Are</h2>
      <p>ASPS (Anti-Scam Protection Systems) is a US-based company building consumer scam protection technology. Our mission is to give every person access to the kind of real-time fraud protection that was previously only available to enterprises.</p>
      <p style="margin-top:12px">If you have any questions about this Privacy Policy or your data, you can reach us at: <a href="mailto:info@asps.io">info@asps.io</a></p>
    </div>

    <!-- 2. What We Collect -->
    <div class="privacy-section">
      <h2>2. What We Collect</h2>
      <p>At this pre-launch stage, we collect only what is necessary to operate our waitlist and respond to inquiries:</p>
      <ul>
        <li><strong>Email address</strong> submitted voluntarily when you join our waitlist.</li>
        <li><strong>Contact form submissions</strong> your name, email address, and message if you reach out through our contact form.</li>
        <li><strong>Usage data</strong> basic browser data (cookies and local storage) used solely for site functionality. We do not use advertising or tracking cookies.</li>
      </ul>
      <p style="margin-top:12px">We do not collect financial data, government IDs, or any sensitive personal information.</p>
    </div>

    <!-- 3. How We Use It -->
    <div class="privacy-section">
      <h2>3. How We Use Your Data</h2>
      <p>We use the information we collect for the following purposes only:</p>
      <ul>
        <li>To send you waitlist updates and product launch notifications.</li>
        <li>To respond to your inquiries submitted via the contact form.</li>
        <li>To understand how visitors interact with our site and improve it over time.</li>
      </ul>
      <div class="notice-box">
        🔒 <strong>We do not sell your data.</strong> We do not share your email or personal information with advertisers, data brokers, or any third party for commercial purposes.
      </div>
    </div>

    <!-- 4. Data Sharing -->
    <div class="privacy-section">
      <h2>4. Data Sharing</h2>
      <p>We keep your data as close as possible. The only third-party service that may receive your personal data is:</p>
      <ul>
        <li><strong>Formspree (<a href="https://formspree.io" target="_blank" rel="noopener">formspree.io</a>)</strong> used to process contact form submissions. Formspree's own <a href="https://formspree.io/legal/privacy-policy/" target="_blank" rel="noopener">Politique de confidentialité</a> governs how they handle data submitted through their service.</li>
      </ul>
      <p style="margin-top:12px">No other third parties receive your personal data. We do not use Google Analytics, Facebook Pixel, or similar tracking services.</p>
    </div>

    <!-- 5. Data Retention -->
    <div class="privacy-section">
      <h2>5. Data Retention</h2>
      <ul>
        <li><strong>Waitlist emails</strong> retained until you unsubscribe or until the ASPS product officially launches, whichever comes first.</li>
        <li><strong>Contact form submissions</strong> retained for up to 12 months from the date of submission, then deleted.</li>
      </ul>
      <p style="margin-top:12px">You may request deletion of your data at any time (see Section 6).</p>
    </div>

    <!-- 6. Your Rights -->
    <div class="privacy-section">
      <h2>6. Your Rights</h2>
      <p>You have the right to access, correct, or delete your personal data at any time. To exercise any of these rights, email us at <a href="mailto:info@asps.io">info@asps.io</a> with the subject line "Data Request."</p>
      <ul>
        <li><strong>Right to access</strong> Request a copy of the data we hold about you.</li>
        <li><strong>Right to correction</strong> Ask us to correct inaccurate data.</li>
        <li><strong>Right to deletion</strong> Ask us to delete your data. We will respond within 30 days.</li>
        <li><strong>Right to opt out</strong> Unsubscribe from waitlist emails at any time via the unsubscribe link in any email we send.</li>
      </ul>
    </div>

    <!-- 7. Cookies -->
    <div class="privacy-section">
      <h2>7. Cookies</h2>
      <p>We use minimal functional cookies only small files stored in your browser that help the site work correctly (e.g., remembering your preferences).</p>
      <ul>
        <li>We do <strong>not</strong> use tracking cookies.</li>
        <li>We do <strong>not</strong> use advertising cookies.</li>
        <li>We do <strong>not</strong> use analytics cookies from third-party platforms.</li>
      </ul>
      <p style="margin-top:12px">You can disable cookies in your browser settings at any time. This will not affect your ability to browse our site.</p>
    </div>

    <!-- 8. Children -->
    <div class="privacy-section">
      <h2>8. Children's Privacy</h2>
      <p>Our service is not directed to children under the age of 13. We do not knowingly collect personal information from anyone under 13. If you believe a child has provided us with their information, please contact us at <a href="mailto:info@asps.io">info@asps.io</a> and we will delete it promptly.</p>
    </div>

    <!-- 9. Changes -->
    <div class="privacy-section">
      <h2>9. Changes to This Policy</h2>
      <p>We may update this Privacy Policy as our product evolves. When we make material changes, we will notify waitlist members via email and update the "Effective Date" at the top of this page.</p>
      <p style="margin-top:12px">We encourage you to review this policy periodically. Continued use of our site after changes are posted constitutes acceptance of the updated policy.</p>
    </div>

    <!-- 10. Contact -->
    <div class="privacy-section">
      <h2>10. Contact Us</h2>
      <p>If you have any questions, concerns, or requests regarding this Privacy Policy or your personal data, please reach out:</p>
      <ul>
        <li><strong>Email:</strong> <a href="mailto:info@asps.io">info@asps.io</a></li>
        <li><strong>Company:</strong> ASPS (Anti-Scam Protection Systems)</li>
        <li><strong>Location:</strong> United States</li>
      </ul>
      <p style="margin-top:16px">We are committed to responding to all data-related requests within 30 days.</p>
    </div>

    <div style="text-align:center;margin-top:60px;padding-top:40px;border-top:1px solid rgba(26,34,85,0.08)">
      <div style="font-family:'Syne',sans-serif;font-weight:700;font-size:1.1rem;color:#1A1814;margin-bottom:8px">Have a question about your data?</div>
      <div style="font-family:'Instrument Sans',sans-serif;font-size:.9rem;color:#4A5280;margin-bottom:24px">We'll respond within 30 days usually much sooner.</div>
      <a href="mailto:info@asps.io" style="display:inline-block;background:linear-gradient(135deg,#BE3A4B,#8E1A2A);color:#fff;font-family:'Syne',sans-serif;font-weight:700;font-size:.95rem;padding:14px 32px;border-radius:10px;text-decoration:none;transition:.2s" onmouseover="this.style.opacity='.9'" onmouseout="this.style.opacity='1'">Email Us →</a>
    </div>

  </div>
</main>

<!-- FOOTER -->
<footer role="contentinfo">
  <div style="display:flex;flex-direction:column;gap:6px">
    <svg width="130" height="36" viewBox="0 0 148 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="0" y="0" width="3" height="40" rx="1.5" fill="url(#footBarGradPriv)"/>
      <text x="12" y="26" font-family="'Syne', sans-serif" font-weight="800" font-size="22" fill="#FFFFFF" letter-spacing="-0.5">ASPS</text>
      <circle cx="20" cy="6" r="4" fill="#BE3A4B"/>
      <circle cx="20" cy="6" r="4" fill="#BE3A4B" opacity="0.3">
        <animate attributeName="r" values="4;7;4" dur="2.5s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values="0.3;0;0.3" dur="2.5s" repeatCount="indefinite"/>
      </circle>
      <circle cx="20" cy="6" r="2" fill="#FFFFFF"/>
      <text x="13" y="37" font-family="'Instrument Sans', sans-serif" font-weight="500" font-size="7.5" fill="rgba(255,255,255,0.28)" letter-spacing="2">ANTI-SCAM PROTECTION</text>
      <defs>
        <linearGradient id="footBarGradPriv" x1="0" y1="0" x2="0" y2="40" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#BE3A4B"/>
