<!-- FEATURE -->
<section class="feature">
  <div class="container">
    <div class="feature-grid">
      <article>
        <div class="feature-meta">
          <span class="tag tag-alert">Alerte</span>
          <span class="feature-date">May 10, 2026</span>
        </div>
        <h2><a href="https://news.trendmicro.com/2026/04/16/ai-voice-cloning/" target="_blank" rel="noopener">Les arnaques au clonage vocal IA s'accélèrent à l'échelle mondiale — and the gap is closing on detection.</a></h2>
        <p class="feature-dek">Synthetic voice attacks are no longer a parlour trick. Impersonations of family members, bank employees, and public officials are now being assembled from seconds of audio and deployed at industrial scale. Defenders who relied on "you'll just know" have run out of intuition.</p>
        <a href="https://news.trendmicro.com/2026/04/16/ai-voice-cloning/" target="_blank" rel="noopener" class="feature-source">Source · <strong>Trend Micro</strong></a>
      </article>

      <aside class="feature-aside">
        <div class="feature-aside-head">Also worth your time</div>
        <ol class="aside-list">
          <li>
            <a href="https://www.vectra.ai/topics/ai-scams" target="_blank" rel="noopener">
              <div>
                <h4>Même les experts peinent à détecter les voix générées par IA</h4>
                <span class="src">Recherche · Vectra AI</span>
              </div>
            </a>
          </li>
          <li>
            <a href="https://www.threatmark.com/six-months-of-psr-scam-reimbursement/" target="_blank" rel="noopener">
              <div>
                <h4>Les règles britanniques de remboursement remodèlent la prévention de la fraude</h4>
                <span class="src">Réglementation · ThreatMark</span>
              </div>
            </a>
          </li>
          <li>
            <a href="https://www.cnbc.com/2026/05/09/ai-powered-scam-calls-getting-more-convincing.html" target="_blank" rel="noopener">
              <div>
                <h4>Les arnaques par IA s'industrialisent à grande échelle</h4>
                <span class="src">Rapport · CNBC</span>
              </div>
            </a>
          </li>
        </ol>
