@page
@model WebApi.Pages.BlacklistedPhoneNumbers.IndexModel
@{
    ViewData["Title"] = "Blacklisted Phone Numbers";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Blacklisted Phone Numbers</h1>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Blacklisted Phone Numbers (@Model.TotalCount)</h6>
        <form method="get" class="d-flex" style="max-width: 400px;">
            <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm me-2" placeholder="Search phone number, source..." />
            <button type="submit" class="btn btn-sm btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a href="/BlacklistedPhoneNumbers" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            }
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="phoneNumbersTable">
                <thead>
                    <tr>
                        <th>Key</th>
                        <th>Phone Number</th>
                        <th>Source</th>
                        <th>Notes</th>
                        <th>Date Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var phoneNumber in Model.PhoneNumbers)
                    {
                        <tr>
                            <td>@phoneNumber.Id</td>
                            <td><code>@phoneNumber.PhoneNumber</code></td>
                            <td>
                                @if (!string.IsNullOrEmpty(phoneNumber.Source))
                                {
                                    <span class="badge bg-info">@phoneNumber.Source</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(phoneNumber.Notes))
                                {
                                    <span class="text-muted">@phoneNumber.Notes</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@phoneNumber.DateCreated.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Blacklisted phone numbers pagination">
                <ul class="pagination justify-content-center mb-0 mt-3">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="/BlacklistedPhoneNumbers?page=@(Model.CurrentPage - 1)@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")">Previous</a>
                    </li>

                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                        if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="/BlacklistedPhoneNumbers?page=1@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")">1</a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="/BlacklistedPhoneNumbers?page=@i@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")">@i</a>
                            </li>
                        }

                        if (endPage < Model.TotalPages)
                        {
                            if (endPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="/BlacklistedPhoneNumbers?page=@Model.TotalPages@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")">@Model.TotalPages</a>
                            </li>
                        }
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="/BlacklistedPhoneNumbers?page=@(Model.CurrentPage + 1)@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
