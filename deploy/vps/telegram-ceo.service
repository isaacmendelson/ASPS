# ASPS Telegram CEO bot — systemd unit (ASPS-744, Phase 5).
#
# TEMPLATE — placeholders @ASPSBOT_USER@ / @CLONE_PATH@ / @SECRETS_DIR@ are
# substituted by deploy/vps/05-service.sh (sed, from deploy/vps/config.env)
# before this file is installed to /etc/systemd/system/telegram-ceo.service.
# Do not install this file as-is with literal @...@ tokens — run
# 05-service.sh, which renders + installs + enables + starts it.
#
# NOT YET EXECUTED — authored ahead of the VPS existing (Phase 0, ASPS-739).
# See deploy/vps/README.md "Phase 5" and
# docs/task-memory/VPS_TELEGRAM_MIGRATION_HANDOFF.md.

[Unit]
Description=ASPS Telegram CEO bot (Claude Agent SDK)
Documentation=https://github.com/isaacmendelson/ASPS/blob/main/apps/telegram-ceo/README.md
After=network-online.target docker.service
Wants=network-online.target
# Deliberately NOT "Requires=docker.service" — most Telegram turns don't
# touch Docker at all (Read/Grep/Glob/Bash/git); if dockerd is briefly down
# the bot should keep polling Telegram and only fail the specific tool call
# that needed Docker, not refuse to start entirely.

[Service]
Type=simple
User=@ASPSBOT_USER@
# Ubuntu's useradd (01-harden.sh) creates a private group matching the
# username by default (USERGROUPS_ENAB=yes) — @ASPSBOT_USER@'s primary
# group is assumed to be named the same as the user.
Group=@ASPSBOT_USER@
SupplementaryGroups=docker
WorkingDirectory=@CLONE_PATH@/apps/telegram-ceo

# Secrets live OUTSIDE the git clone (D2 / ASPS-745 item 1) — two separate
# EnvironmentFile= directives:
#   1. the bot's own runtime config (Telegram/Claude auth, working dir)
#   2. the CEO agent's OWN GitHub/JIRA tokens, so the agent's Bash-tool
#      calls (git push via the Phase 3 credential helper, curl against the
#      JIRA REST API) see them as ordinary process environment variables —
#      chosen over relying solely on the git credential-helper file because
#      JIRA_API_TOKEN/JIRA_EMAIL/GITHUB_TOKEN-as-a-bare-env-var have no git
#      equivalent; the credential-helper file only ever serves `git push`
#      itself, not arbitrary curl calls the agent makes.
# Both files: chmod 600, owned by @ASPSBOT_USER@, created from the
# *.env.example templates by 03-clone.sh, filled in by the operator. Systemd
# refuses a missing EnvironmentFile silently only if prefixed with "-"; we
# deliberately do NOT use that prefix — a missing secrets file should fail
# the service loudly, not start the bot half-configured.
EnvironmentFile=@SECRETS_DIR@/telegram-ceo.env
EnvironmentFile=@SECRETS_DIR@/ACCESS_KEYS.env

ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=telegram-ceo

# --- Hardening -------------------------------------------------------------
# See deploy/vps/README.md "Phase 5 — systemd hardening tradeoffs" for full
# reasoning. Summary: everything below is compatible with node/git/npm/
# dotnet and the docker CLIENT (talking to the already-running dockerd over
# its unix socket), and with D4 (the agent reads/writes its own clone and
# can run `docker compose`). ProtectHome, PrivateDevices, syscall/memory
# filtering are DELIBERATELY NOT enabled — see the commented-out block below
# and the README for why each is a real, reasoned tension (not an
# oversight), flagged for Security to decide/test at the Phase 1 execution
# gate rather than guessed here against a host that doesn't exist yet.

NoNewPrivileges=yes
ProtectSystem=strict
# ReadWritePaths (ASPS-745 audit M5 + live override, folded 2026-09-07):
#   - @SECRETS_DIR@ is deliberately NOT listed here (was, before this fix).
#     Systemd injects EnvironmentFile= content as PID 1, BEFORE the sandbox
#     is applied, so the process needs zero filesystem access to
#     @SECRETS_DIR@ to see its own secrets as env vars — only
#     git-credential-store needs to READ github-credentials for `git push`,
#     which ProtectSystem=strict's default read-only already provides
#     without a ReadWritePaths entry. Granting read+WRITE let an injected
#     agent overwrite github-credentials with attacker creds or exfiltrate
#     the raw token files at a known path; removing it closes that class
#     (M3's docker-group escape remains the ceiling on all of this — see
#     README.md).
#   - The three /home/@ASPSBOT_USER@/.* paths were added live (not in the
#     original template) because the Claude Code CLI + npm write state
#     under $HOME (~/.claude, ~/.config, ~/.npm caches) even when cwd is
#     @CLONE_PATH@ — under ProtectSystem=strict the whole FS is read-only
#     except ReadWritePaths, so the service failed to start until these
#     were added. 05-service.sh creates them (mkdir -p, owned
#     @ASPSBOT_USER@) before start so ProtectSystem=strict has something to
#     bind read-write.
ReadWritePaths=@CLONE_PATH@ /home/@ASPSBOT_USER@/.claude /home/@ASPSBOT_USER@/.config /home/@ASPSBOT_USER@/.cache /home/@ASPSBOT_USER@/.npm
ProtectControlGroups=yes
RestrictSUIDSGID=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
# RestrictNamespaces (ASPS-764, ADR-005 -- scoped down from the blanket
# `yes` deny-all): the SDK's built-in Linux sandbox (bwrap) needs to create
# a user namespace (for the unprivileged uid map) and a mount namespace (for
# the ro-bind / tmpfs-mask filesystem view); a pid namespace is included too
# so the sandboxed process tree is isolated from the rest of the host, which
# the SDK's sandbox also expects. net/uts/ipc/cgroup namespaces stay denied
# -- the sandboxed command keeps network access via the INHERITED net
# namespace (no `unshare-net` in the bwrap invocation), not by this unit
# being allowed to create a *new* one. Validated on the live box: `bwrap
# --unshare-user --unshare-pid ...` succeeds under this scoping (see
# docs/cloud/VPS_TELEGRAM_HARDENING.md "bubblewrap sandbox enablement").
RestrictNamespaces=user pid mnt
# UMask (ASPS-745 audit m3, applied+verified live 2026-09-07): systemd's
# default UMask=0022 leaves service-created files world-readable. Any
# secret-ish artifact the agent writes (logs, caches, tmp files under the
# ReadWritePaths above) would otherwise be group/other-readable. Zero
# functional cost — every writer here is this single service/user.
UMask=0077

# NOT enabled — see README.md "Phase 5 — systemd hardening tradeoffs" and
# "Phase 6 audit fixes". These four (plus the capability/address-family/
# ProtectProc nits) are DEFERRED ASPS-745 follow-ups, not oversights — each
# is reasoned below and needs an on-box `systemd-analyze security` pass +
# a live tool-call smoke test (real `git push` + `docker compose` + `dotnet
# build` + a representative Bash-tool turn) before enabling, because a
# wrong guess here fails CLOSED (crash-loop, no one local to debug an
# unattended 24/7 bot over Telegram) rather than open:
#
# ProtectHome=yes
#   Would make ~/.gitconfig (holding the Phase 3 credential-helper config,
#   git user.name/email, safe.directory) INACCESSIBLE (not merely
#   read-only) — it lives directly under /home/@ASPSBOT_USER@, outside the
#   ReadWritePaths entries above. ProtectSystem=strict already makes the
#   ENTIRE filesystem read-only except the declared paths, which already
#   satisfies "the bot can only write to its clone + its own $HOME state"
#   without also hiding ~/.gitconfig from reads. Read access to
#   ~/.gitconfig under ProtectSystem=strict's read-only (not invisible)
#   mode is unaffected. Correctly reasoned as OFF in the ASPS-745 audit —
#   keep OFF.
#
# PrivateDevices=yes
#   Probably safe: the docker CLIENT only needs the unix socket
#   (/run/docker.sock, which stays reachable for connect() even on a
#   read-only mount), not /dev/* — and /dev/null|zero|random|urandom|tty
#   remain available under PrivateDevices regardless. Deferred: needs a
#   live `docker compose` smoke test on the real box before enabling.
#
# SystemCallFilter=@system-service SystemCallArchitectures=native
# SystemCallErrorNumber=EPERM
#   Reduces kernel attack surface materially from a network-facing,
#   injection-reachable Node process. @system-service is Node-compatible
#   by design, but no safe filter set could be derived without live
#   testing against node + git + npm + dotnet + the docker CLI + every
#   Bash-tool command the agent might ever run. Deferred: enable, run one
#   real docker compose + git push + dotnet turn, watch for EPERM, iterate
#   with `systemd-analyze security`.
#
# CapabilityBoundingSet= (empty) / AmbientCapabilities=
#   Node/git/docker-client need no elevated capabilities under
#   NoNewPrivileges=yes. Graceful no-op if wrong, but not yet smoke-tested
#   live — deferred alongside the syscall filter pass so all sandbox
#   changes get one combined verification pass rather than several
#   separate service restarts.
#
# RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
#   The service only needs Telegram/Anthropic/GitHub/JIRA HTTPS (AF_INET/
#   AF_INET6) and the Docker socket (AF_UNIX) — no other family should be
#   reachable. Deferred alongside the syscall filter pass for the same
#   reason (one combined smoke test).
#
# ProtectProc=invisible
#   Hides other users' /proc entries — this is a single-user box so the
#   confinement value is marginal, but it's a cheap addition. Deferred
#   alongside the syscall filter pass rather than added in isolation.
#
# MemoryDenyWriteExecute=yes
#   Node's V8 JIT requires W+X pages; MDWE would crash-loop the bot —
#   systemd's own docs list JIT compilers as the known-incompatible case.
#   Correctly reasoned as OFF in the ASPS-745 audit — keep OFF.

[Install]
WantedBy=multi-user.target
