@page
@model WebApi.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Error!</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <div class="alert alert-info mt-2">
        <strong>Troubleshooting:</strong>
        <ul class="mb-0">
            <li>Ensure ASPSBackend is running: <code>dotnet run --project ASPSBackend</code></li>
            <li>Check logs for "CQRS Gateway started (tcp://*:5556)"</li>
            <li>Verify port 5556 is listening: <code>netstat -an | grep 5556</code></li>
        </ul>
    </div>
}

<!-- Dashboard Cards -->
<div class="row">
    <!-- Users Card -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="/Users" class="text-decoration-none">
            <div class="dashboard-card">
                <h5><i class="fas fa-users me-2"></i>Total Users</h5>
                <div class="count">@Model.UsersCount</div>
                <small class="text-muted">Registered users</small>
            </div>
        </a>
    </div>

    <!-- Devices Card -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="/Devices" class="text-decoration-none">
            <div class="dashboard-card">
                <h5><i class="fas fa-mobile-alt me-2"></i>Total Devices</h5>
                <div class="count">@Model.DevicesCount</div>
                <small class="text-muted">Connected devices</small>
            </div>
        </a>
    </div>

    <!-- Alerts Card -->
    <div class="col-xl-3 col-md-6 mb-4">
        <a href="/DeviceAlerts" class="text-decoration-none">
            <div class="dashboard-card">
                <h5><i class="fas fa-bell me-2"></i>Alerts (24h)</h5>
                <div class="count" style="color: #f39c12;">@Model.AlertsCount</div>
                <small class="text-muted">Last 24 hours</small>
            </div>
        </a>
    </div>

    <!-- Phishing Sites Card -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="dashboard-card">
            <h5><i class="fas fa-shield-alt me-2"></i>Phishing Sites</h5>
            <div class="count" style="color: #e74c3c;">@Model.PhishingWebsitesCount</div>
            <small class="text-muted">In database</small>
        </div>
    </div>
</div>

<!-- System Status -->
<div class="row">
    <div class="col-12">
        <div class="dashboard-card">
            <h5><i class="fas fa-server me-2"></i>System Status</h5>
            <div class="alert alert-success mb-3" role="alert">
                <i class="fas fa-check-circle"></i> <strong>All systems operational</strong>
            </div>
            <p><strong>Server Time:</strong> @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss UTC")</p>
            <p><strong>Environment:</strong> Development</p>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row">
    <div class="col-12">
        <div class="dashboard-card">
            <h5><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
            <a href="/Users" class="btn btn-success me-2">
                <i class="fas fa-users"></i> Manage Users
            </a>
            <a href="/Devices" class="btn btn-primary me-2" style="background: var(--sidebar-bg); border-color: var(--sidebar-bg);">
                <i class="fas fa-mobile-alt"></i> View Devices
            </a>
            <a href="/DeviceAlerts" class="btn btn-warning me-2">
                <i class="fas fa-list"></i> View Alerts
            </a>
            <button class="btn btn-secondary" onclick="location.reload()">
                <i class="fas fa-sync"></i> Refresh
            </button>
        </div>
    </div>
</div>
