@page
@model WebApi.Pages.WebsiteCategories.IndexModel
@{
    ViewData["Title"] = "Website Categories";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Website Categories</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a asp-page="Create" class="btn btn-sm btn-primary">
            <i class="fas fa-plus"></i> Add Category
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Categories == null || Model.Categories.Count == 0)
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> No categories found. <a asp-page="Create">Create the first one</a>.
    </div>
}
else
{
    <div class="mb-3">
        <span class="badge bg-primary">@Model.Categories.Count categories</span>
    </div>

    <div class="accordion" id="categoriesAccordion">
        @{
            var parents = Model.Categories
                .Where(c => !string.IsNullOrEmpty(c.ParentId))
                .Select(c => c.ParentId)
                .Distinct()
                .ToList();
            
            var topLevelCategories = Model.Categories.Where(c => string.IsNullOrEmpty(c.ParentId)).ToList();
        }
        
        @* Top-level categories (no parent) *@
        @if (topLevelCategories.Any())
        {
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-toplevel">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-toplevel" aria-expanded="true">
                        <i class="fas fa-layer-group me-2"></i> Parent Categories (@parents.Count)
                    </button>
                </h2>
                <div id="collapse-toplevel" class="accordion-collapse collapse show" aria-labelledby="heading-toplevel">
                    <div class="accordion-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Source</th>
                                    <th>Date Created</th>
                                    <th>Child Count</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var parent in Model.AllParents.Where(p => topLevelCategories.Any(t => t.Name == p.Name)))
                                {
                                    var childCount = Model.Categories.Count(c => c.ParentId == parent.KeyField);
                                    <tr>
                                        <td>
                                            <i class="fas fa-folder text-warning me-2"></i>
                                            <strong>@parent.Name</strong>
                                        </td>
                                        <td><code>@(parent.Source ?? "-")</code></td>
                                        <td>@parent.DateCreated.ToString("yyyy-MM-dd")</td>
                                        <td><span class="badge bg-secondary">@childCount children</span></td>
                                        <td>
                                            <a asp-page="Edit" asp-route-name="@parent.Name" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        
        @* Child categories grouped by parent *@
        @foreach (var parent in Model.AllParents.Where(p => Model.Categories.Any(c => c.ParentId == p.KeyField)))
        {
            var children = Model.Categories.Where(c => c.ParentId == parent.KeyField).ToList();
            if (!children.Any()) continue;
            
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-@parent.KeyField">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@parent.KeyField" aria-expanded="false">
                        <i class="fas fa-folder-open me-2"></i> @parent.Name (@children.Count children)
                    </button>
                </h2>
                <div id="collapse-@parent.KeyField" class="accordion-collapse collapse" aria-labelledby="heading-@parent.KeyField">
                    <div class="accordion-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Source</th>
                                    <th>Date Created</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var child in children)
                                {
                                    <tr>
                                        <td>
                                            <span class="ms-4 text-muted">└</span> @child.Name
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(child.Source))
                                            {
                                                <code>@child.Source</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>@child.DateCreated.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <a asp-page="Edit" asp-route-name="@child.Name" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .accordion-item {
        border: 1px solid rgba(0,0,0,.125);
        border-radius: 0.25rem;
        margin-bottom: 0.5rem;
    }
    .accordion-button:not(.collapsed) {
        background-color: #e7f1ff;
        color: #0d6efd;
    }
    .accordion-button {
        font-weight: 600;
    }
</style>
