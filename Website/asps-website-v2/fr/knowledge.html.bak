<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<link rel="icon" href="../favicon.svg" type="image/svg+xml"/>
<meta name="description" content="ASPS Knowledge Center — scam intelligence, threat alerts, regulation tracker and research on AI-era fraud."/>
<title>Centre de connaissances · ASPS</title>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,16..72,400;0,16..72,500;0,16..72,600;0,16..72,700;1,16..72,400;1,16..72,500;1,16..72,600&family=Syne:wght@700;800&display=swap" rel="stylesheet"/>
<style>
:root {
  --bg-dark: #070B14;
  --bg-paper: #FAF7F2;
  --bg-paper-2: #F3EFE8;
  --bg-paper-3: #ECE5D8;

  --accent: #BE3A4B;
  --accent-strong: #8E1A2A;

  --ink: #1A1814;
  --ink-2: #4A4640;
  --ink-3: #6B655C;
  --rule: #E4DDD2;
  --rule-2: #D7CFC2;

  --tag-alert: #BE3A4B;
  --tag-research: #4A5C8B;
  --tag-regulation: #6B5938;
  --tag-guide: #2F6B4A;
  --tag-news: #4A4640;

  --font-body: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-serif: 'Newsreader', Georgia, serif;
  --font-display: 'Syne', Georgia, serif;
  --transition: 0.25s cubic-bezier(0.4,0,0.2,1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-body);
  background: var(--bg-paper);
  color: var(--ink);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; }

.container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
@media (min-width: 768px) { .container { padding: 0 40px; } }
@media (min-width: 1024px) { .container { padding: 0 60px; } }

/* ───────── NAV ───────── */
.nav {
  position: sticky; top: 0; z-index: 1000; height: 72px;
  background: rgba(15,18,56,0.97);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.nav-inner {
  max-width: 1400px; margin: 0 auto; padding: 0 40px;
  height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 32px;
}
.nav-logo { display: flex; align-items: center; flex-shrink: 0; }
.nav-links { display: none; align-items: center; gap: 8px; }
@media (min-width: 1024px) { .nav-links { display: flex; } }
.nav-link {
  padding: 8px 16px; font-size: 0.875rem; font-weight: 500;
  color: #94A3B8; border-radius: 8px; transition: var(--transition);
}
.nav-link:hover { color: #fff; background: rgba(255,255,255,0.05); }
.nav-link.active { color: #fff; position: relative; }
.nav-link.active::after {
  content: ''; position: absolute; left: 16px; right: 16px; bottom: 0;
  height: 2px; background: var(--accent);
}
.nav-actions { display: flex; align-items: center; gap: 12px; }
.nav-btn {
  padding: 10px 20px; font-size: 0.875rem; font-weight: 600;
  border-radius: 8px; transition: var(--transition); border: none;
}
.nav-btn-ghost {
  background: transparent; color: #94A3B8; border: 1px solid rgba(255,255,255,0.12);
}
.nav-btn-ghost:hover { color: #fff; border-color: rgba(255,255,255,0.25); }
.nav-btn-primary { background: #fff; color: #0F1238; }
.nav-btn-primary:hover { background: #EEF0FF; }
.lang-dropdown { position: relative; }
.lang-dropdown-btn {
  display: flex; align-items: center; gap: 6px; padding: 8px 12px;
  background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);
  border-radius: 8px; color: #E2E8F0; font-size: 0.8125rem; font-weight: 600;
  cursor: pointer; transition: var(--transition);
}
.lang-dropdown-btn:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.25); }
.lang-dropdown-menu {
  position: absolute; top: calc(100% + 8px); right: 0;
  min-width: 140px; padding: 8px 0;
  background: #0F1238; border: 1px solid rgba(255,255,255,0.12);
  border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  opacity: 0; visibility: hidden; transform: translateY(-8px);
  transition: var(--transition); z-index: 100;
}
.lang-dropdown:hover .lang-dropdown-menu,
.lang-dropdown:focus-within .lang-dropdown-menu {
  opacity: 1; visibility: visible; transform: translateY(0);
}
.lang-option { display: block; padding: 10px 16px; font-size: 0.875rem; color: #94A3B8; transition: var(--transition); }
.lang-option:hover { background: rgba(255,255,255,0.05); color: #FFFFFF; }
.lang-option.active { color: var(--accent); font-weight: 600; }

/* ───────── MASTHEAD (newspaper) ───────── */
.masthead {
  background: var(--bg-paper);
  border-bottom: 1px solid var(--rule);
  padding: 56px 0 28px;
}
.masthead-rule {
  height: 6px;
  background: var(--ink);
  position: relative;
  margin-bottom: 28px;
}
.masthead-rule::after {
  content: ''; position: absolute; left: 0; right: 0; top: 10px;
  height: 1px; background: var(--ink);
}
.masthead-meta {
  display: flex; justify-content: space-between; align-items: baseline;
  gap: 16px; flex-wrap: wrap;
  font-family: var(--font-display);
  font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em;
  text-transform: uppercase; color: var(--ink-3);
  padding-bottom: 8px;
  border-bottom: 1px solid var(--rule);
  margin-bottom: 36px;
}
.masthead-meta .left { color: var(--accent); }
.masthead-title-block {
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
  align-items: end;
}
@media (min-width: 900px) {
  .masthead-title-block { grid-template-columns: 1.4fr 1fr; gap: 64px; }
}
.masthead-eyebrow {
  display: inline-flex; align-items: center; gap: 14px;
  margin-bottom: 20px;
  font-family: var(--font-display);
  font-weight: 700; font-size: 0.7rem;
  letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--accent);
}
.masthead-eyebrow::before {
  content: ''; width: 32px; height: 1px; background: var(--accent); opacity: 0.5;
}
.masthead h1 {
  font-family: var(--font-serif);
  font-weight: 500;
  font-size: clamp(2.4rem, 5.5vw, 4.4rem);
  line-height: 1.02;
  letter-spacing: -0.025em;
  color: var(--ink);
}
.masthead h1 .em {
  font-style: italic;
  font-weight: 500;
  color: var(--accent-strong);
}
.masthead-deck {
  font-family: var(--font-serif);
  font-size: 1.125rem;
  line-height: 1.55;
  color: var(--ink-2);
  border-left: 2px solid var(--accent);
  padding-left: 20px;
  max-width: 460px;
}

/* ───────── FILTER BAR ───────── */
.filterbar {
  position: sticky; top: 72px; z-index: 90;
  background: var(--bg-paper);
  border-bottom: 1px solid var(--rule);
}
.filterbar-inner {
  display: flex; align-items: center; justify-content: space-between;
  gap: 24px; flex-wrap: wrap;
  padding: 14px 0;
}
.filter-tabs {
  display: flex; flex-wrap: wrap; gap: 4px;
  font-family: var(--font-display);
  font-size: 0.72rem; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase;
}
.filter-tab {
  padding: 8px 14px;
  background: transparent; border: none;
  color: var(--ink-3);
  cursor: pointer; transition: var(--transition);
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
}
.filter-tab:hover { color: var(--ink); }
.filter-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
.filter-count {
  font-family: var(--font-display);
  font-size: 0.7rem; font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--ink-3);
}
.filter-count strong { color: var(--ink); }

/* ───────── FEATURE — top story ───────── */
.feature {
  padding: 72px 0 32px;
}
.feature-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 56px;
}
@media (min-width: 900px) {
  .feature-grid { grid-template-columns: 1.2fr 1fr; gap: 80px; align-items: start; }
}
.feature-meta {
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  margin-bottom: 18px;
  font-family: var(--font-display);
  font-size: 0.7rem; font-weight: 700;
  letter-spacing: 0.18em; text-transform: uppercase;
}
.tag {
  padding: 4px 10px; border: 1px solid currentColor;
  border-radius: 2px;
}
.tag-alert    { color: var(--tag-alert); }
.tag-research { color: var(--tag-research); }
.tag-regulation { color: var(--tag-regulation); }
.tag-policy   { color: var(--tag-regulation); }
.tag-guide    { color: var(--tag-guide); }
.tag-news     { color: var(--tag-news); }
.feature-date { color: var(--ink-3); font-weight: 600; }
.feature h2 {
  font-family: var(--font-serif);
  font-weight: 500;
  font-style: italic;
  font-size: clamp(1.9rem, 3.6vw, 2.8rem);
  line-height: 1.08;
  letter-spacing: -0.02em;
  color: var(--ink);
  margin-bottom: 22px;
}
.feature h2 a { transition: var(--transition); background-image: linear-gradient(var(--accent),var(--accent)); background-repeat: no-repeat; background-size: 0 1px; background-position: 0 100%; }
.feature h2 a:hover { background-size: 100% 1px; }
.feature-dek {
  font-family: var(--font-serif);
  font-size: 1.1875rem;
  line-height: 1.65;
  color: var(--ink-2);
  margin-bottom: 24px;
}
.feature-source {
  font-family: var(--font-display);
  font-size: 0.72rem; font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--ink-3);
}
.feature-source strong { color: var(--ink); }
.feature-source::after {
  content: '→'; margin-left: 10px; color: var(--accent); font-family: var(--font-body);
}

.feature-aside {
  border-left: 1px solid var(--rule);
  padding-left: 40px;
}
@media (max-width: 899px) {
  .feature-aside { border-left: none; border-top: 1px solid var(--rule); padding-left: 0; padding-top: 40px; }
}
.feature-aside-head {
  font-family: var(--font-display);
  font-weight: 700; font-size: 0.7rem;
  letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 24px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--accent);
}
.aside-list { list-style: none; counter-reset: alsoread; }
.aside-list li {
  counter-increment: alsoread;
  padding: 18px 0;
  border-bottom: 1px dashed var(--rule-2);
}
.aside-list li:last-child { border-bottom: none; }
.aside-list li a { display: grid; grid-template-columns: 32px 1fr; gap: 14px; align-items: start; transition: var(--transition); }
.aside-list li a::before {
  content: counter(alsoread, decimal-leading-zero);
  font-family: var(--font-display);
  font-weight: 700; font-size: 0.78rem;
  letter-spacing: 0.1em; color: var(--accent);
  padding-top: 2px;
}
.aside-list h4 {
  font-family: var(--font-serif);
  font-weight: 600; font-size: 1.0625rem;
  line-height: 1.25; color: var(--ink);
  margin-bottom: 6px;
}
.aside-list .src {
  font-family: var(--font-display);
  font-size: 0.66rem; font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--ink-3);
}
.aside-list li a:hover h4 { color: var(--accent-strong); }

/* ───────── INTELLIGENCE FEED ───────── */
.feed {
  padding: 64px 0 100px;
  border-top: 1px solid var(--rule);
}
.feed-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 24px; flex-wrap: wrap;
  padding-bottom: 24px; margin-bottom: 48px;
  border-bottom: 1px solid var(--rule-2);
}
.section-eyebrow {
  display: inline-block; margin-bottom: 14px;
  font-family: var(--font-display);
  font-weight: 700; font-size: 0.7rem;
  letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--accent);
}
.section-title {
  font-family: var(--font-serif);
  font-weight: 500;
  font-size: clamp(1.8rem, 3.4vw, 2.5rem);
  line-height: 1.05;
  letter-spacing: -0.02em;
  color: var(--ink);
}
.feed-meta {
  font-family: var(--font-display);
  font-weight: 700; font-size: 0.72rem;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
  padding-bottom: 6px;
}

.feed-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 48px;
}
@media (min-width: 1024px) {
  .feed-grid { grid-template-columns: 7fr 4fr; gap: 80px; align-items: start; }
}

.article-list {
  list-style: none; counter-reset: art;
}
.article-list > li {
  counter-increment: art;
  scroll-margin-top: 140px;
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
  padding: 36px 0;
  border-top: 1px solid var(--rule);
  transition: var(--transition);
}
.article-list > li:last-child { border-bottom: 1px solid var(--rule); }
@media (min-width: 720px) {
  .article-list > li { grid-template-columns: 80px 1fr; gap: 36px; align-items: start; }
}
.article-num {
  font-family: var(--font-display);
  font-weight: 700; font-size: 0.78rem;
  letter-spacing: 0.16em; color: var(--ink-3);
  padding-top: 4px;
}
.article-num::before { content: counter(art, decimal-leading-zero); }
.article-list > li:hover .article-num { color: var(--accent); }
.article-card-meta {
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  margin-bottom: 12px;
  font-family: var(--font-display);
  font-size: 0.68rem; font-weight: 700;
  letter-spacing: 0.18em; text-transform: uppercase;
}
.article-date { color: var(--ink-3); font-weight: 600; }
.article-list h3 {
  font-family: var(--font-serif);
  font-weight: 500;
  font-size: 1.5rem;
  line-height: 1.2;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin-bottom: 14px;
}
.article-list h3 a { transition: var(--transition); }
.article-list > li:hover h3 a { color: var(--accent-strong); }
.article-list p {
  font-family: var(--font-serif);
  font-size: 1.0625rem;
  line-height: 1.6;
  color: var(--ink-2);
  margin-bottom: 14px;
}
.article-source {
  font-family: var(--font-display);
  font-size: 0.68rem; font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--ink-3);
}
.article-source strong { color: var(--ink); }
.article-source::after {
  content: ' ↗'; margin-left: 6px; color: var(--accent); font-family: var(--font-body); font-weight: 400;
}

/* ───────── SIDEBAR ───────── */
.sidebar { display: flex; flex-direction: column; gap: 40px; }
.side-block { padding-top: 4px; }
.side-block + .side-block { padding-top: 36px; border-top: 1px solid var(--rule); }
.side-head {
  font-family: var(--font-display);
  font-weight: 700; font-size: 0.7rem;
  letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--accent);
  padding-bottom: 14px;
  border-bottom: 1px solid var(--accent);
  margin-bottom: 22px;
}

.alert-card {
  padding: 22px 22px 24px;
  background: var(--ink);
  color: #F5F0E7;
  position: relative;
}
.alert-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0;
  height: 3px; background: var(--accent);
}
.alert-card .label {
  display: flex; align-items: center; gap: 10px;
  font-family: var(--font-display);
  font-weight: 700; font-size: 0.7rem;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 14px;
}
.alert-card .label .dot {
  width: 8px; height: 8px; border-radius: 50%; background: var(--accent);
  animation: dotPulse 1.6s ease-in-out infinite;
}
@keyframes dotPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.3); }
}
.alert-card h4 {
  font-family: var(--font-serif);
  font-weight: 500; font-style: italic;
  font-size: 1.25rem; line-height: 1.25;
  color: #fff; margin-bottom: 10px;
}
.alert-card p {
  font-family: var(--font-serif);
  font-size: 0.95rem; line-height: 1.55;
  color: #D6CDBE;
}

.topics { display: flex; flex-wrap: wrap; gap: 6px; }
.topic-tag {
  padding: 7px 12px;
  font-family: var(--font-display);
  font-size: 0.68rem; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--ink-2); background: var(--bg-paper-2);
  border: 1px solid var(--rule);
  transition: var(--transition);
}
.topic-tag:hover { border-color: var(--accent); color: var(--accent); }
.topic-tag .count { color: var(--ink-3); margin-left: 6px; font-weight: 600; }

.quick-list { list-style: none; }
.quick-list li {
  padding: 14px 0;
  border-top: 1px solid var(--rule);
}
.quick-list li:first-child { border-top: none; padding-top: 0; }
.quick-list li a {
  display: flex; align-items: baseline; justify-content: space-between; gap: 14px;
  font-family: var(--font-serif);
  font-size: 1.0625rem;
  color: var(--ink);
  transition: var(--transition);
}
.quick-list li a::after {
  content: '→'; color: var(--accent); font-family: var(--font-body);
  transform: translateX(0); transition: var(--transition);
}
.quick-list li a:hover { color: var(--accent-strong); }
.quick-list li a:hover::after { transform: translateX(4px); }

.subscribe-card {
  background: var(--bg-paper-2);
  border: 1px solid var(--rule);
  padding: 26px;
}
.subscribe-card h4 {
  font-family: var(--font-serif);
  font-weight: 500; font-style: italic;
  font-size: 1.4rem; line-height: 1.2;
  color: var(--ink); margin-bottom: 12px;
}
.subscribe-card p {
  font-family: var(--font-serif);
  font-size: 0.95rem; line-height: 1.55;
  color: var(--ink-2); margin-bottom: 18px;
}
.subscribe-form { display: flex; flex-direction: column; gap: 10px; }
.subscribe-input {
  padding: 12px 14px;
  font-family: var(--font-body);
  font-size: 0.95rem;
  background: #fff;
  border: 1px solid var(--rule-2);
  outline: none;
  transition: var(--transition);
}
.subscribe-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(190,58,75,0.12); }
.subscribe-btn {
  padding: 12px 16px;
  font-family: var(--font-display);
  font-size: 0.74rem; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase;
  background: var(--accent); color: #fff;
  border: none; cursor: pointer;
  transition: var(--transition);
}
.subscribe-btn:hover { background: var(--accent-strong); }
.subscribe-note {
  font-family: var(--font-display);
  font-size: 0.62rem; font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--ink-3); margin-top: 10px;
}

/* ───────── STAT BAND (dark) ───────── */
.stats {
  background: var(--ink);
  color: #F5F0E7;
  padding: 96px 0;
  position: relative; overflow: hidden;
}
.stats::before {
  content: ''; position: absolute; inset: 0;
  background-image:
    radial-gradient(circle at 15% 30%, rgba(190,58,75,0.18), transparent 50%),
    radial-gradient(circle at 85% 70%, rgba(190,58,75,0.10), transparent 55%);
  pointer-events: none;
}
.stats-inner { position: relative; }
.stats-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 32px; flex-wrap: wrap;
  margin-bottom: 56px; padding-bottom: 24px;
  border-bottom: 1px solid rgba(245,240,231,0.12);
}
.stats .section-eyebrow { color: var(--accent); }
.stats .section-title { color: #fff; max-width: 640px; }
.stats-head-meta {
  font-family: var(--font-display);
  font-weight: 700; font-size: 0.72rem;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: #A19888; padding-bottom: 6px;
}
.stats-grid {
  display: grid; grid-template-columns: 1fr; gap: 0;
}
@media (min-width: 700px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .stats-grid { grid-template-columns: repeat(4, 1fr); } }
.stat {
  padding: 32px 32px 32px 0;
  border-top: 1px solid rgba(245,240,231,0.12);
}
@media (min-width: 1024px) {
  .stat { padding: 0 32px; border-top: none; }
  .stat + .stat { border-left: 1px solid rgba(245,240,231,0.12); }
  .stat:first-child { padding-left: 0; }
}
.stat-num {
  font-family: var(--font-serif);
  font-weight: 500;
  font-size: clamp(2.4rem, 4vw, 3.4rem);
  line-height: 1;
  letter-spacing: -0.02em;
  color: #fff;
  margin-bottom: 14px;
}
.stat-num .accent { color: var(--accent); font-style: italic; font-weight: 400; }
.stat-label {
  font-family: var(--font-display);
  font-weight: 700; font-size: 0.7rem;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 12px;
}
.stat-body {
  font-family: var(--font-serif);
  font-size: 0.95rem; line-height: 1.55;
  color: #D6CDBE;
}
.stat-src {
  display: block; margin-top: 14px;
  font-family: var(--font-display);
  font-size: 0.62rem; font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: #8A8175;
}

/* ───────── REGULATION TIMELINE ───────── */
.timeline { padding: 110px 0; background: var(--bg-paper-2); border-top: 1px solid var(--rule-2); border-bottom: 1px solid var(--rule-2); }
.timeline-head { max-width: 720px; margin-bottom: 56px; }
.timeline-head p {
  margin-top: 16px;
  font-family: var(--font-serif);
  font-size: 1.125rem; line-height: 1.65;
  color: var(--ink-2);
}
.timeline-list { list-style: none; }
.timeline-list li {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
  padding: 30px 0;
  border-top: 1px solid var(--rule);
}
.timeline-list li:last-child { border-bottom: 1px solid var(--rule); }
@media (min-width: 700px) {
  .timeline-list li {
    grid-template-columns: 110px 110px 1fr auto;
    gap: 32px; align-items: baseline;
  }
}
.tl-date {
  font-family: var(--font-display);
  font-weight: 700; font-size: 0.78rem;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--accent);
}
.tl-region {
  font-family: var(--font-display);
  font-weight: 700; font-size: 0.7rem;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--ink-3);
}
.tl-title {
  font-family: var(--font-serif);
  font-weight: 500; font-size: 1.25rem;
  line-height: 1.3; color: var(--ink);
}
.tl-title em { font-style: italic; color: var(--accent-strong); font-weight: 500; }
.tl-source {
  font-family: var(--font-display);
  font-size: 0.66rem; font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--ink-3);
  transition: var(--transition);
}
.tl-source:hover { color: var(--accent); }

/* ───────── PULL QUOTE ───────── */
.pullquote-section { padding: 100px 0; background: var(--bg-paper); }
.pullquote { max-width: 980px; margin: 0 auto; text-align: center; }
.pullquote::before {
  content: ''; display: block; width: 64px; height: 2px;
  background: var(--accent); margin: 0 auto 32px;
}
.pullquote-text {
  font-family: var(--font-serif);
  font-style: italic; font-weight: 400;
  font-size: clamp(1.5rem, 3.5vw, 2.5rem);
  line-height: 1.25; letter-spacing: -0.015em;
  color: var(--ink);
}
.pullquote-text strong {
  font-weight: 600; font-style: normal;
  background: linear-gradient(180deg, transparent 62%, rgba(190,58,75,0.18) 62%, rgba(190,58,75,0.18) 92%, transparent 92%);
  padding: 0 0.08em;
}
.pullquote-cite {
  display: block; margin-top: 28px;
  font-family: var(--font-display);
  font-size: 0.72rem; font-weight: 700;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-3);
}

/* ───────── CTA ───────── */
.cta { padding: 110px 0; background: var(--ink); color: #F5F0E7; text-align: center; position: relative; overflow: hidden; }
.cta::before {
  content: ''; position: absolute; inset: 0;
  background-image: radial-gradient(circle at 50% 0%, rgba(190,58,75,0.20), transparent 60%);
  pointer-events: none;
}
.cta-inner { max-width: 760px; margin: 0 auto; position: relative; }
.cta-eyebrow {
  display: inline-block; margin-bottom: 24px;
  font-family: var(--font-display);
  font-weight: 700; font-size: 0.7rem;
  letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--accent);
}
.cta h2 {
  font-family: var(--font-serif);
  font-style: italic; font-weight: 400;
  font-size: clamp(2rem, 4.5vw, 3.25rem);
  line-height: 1.1; letter-spacing: -0.025em;
  color: #fff; margin-bottom: 24px;
}
.cta h2 .em { font-style: normal; font-weight: 600; color: var(--accent); }
.cta p {
  font-family: var(--font-serif);
  font-size: 1.1875rem; line-height: 1.65;
  color: #D6CDBE; margin-bottom: 40px;
}
.cta-buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
.btn {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 14px 28px;
  font-family: var(--font-display);
  font-size: 0.84rem; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase;
  border-radius: 4px; border: none;
  transition: var(--transition); cursor: pointer;
}
.btn-accent { background: var(--accent); color: #fff; }
.btn-accent:hover { background: var(--accent-strong); }
.btn-ghost {
  background: transparent; color: #F5F0E7;
  border: 1px solid rgba(245,240,231,0.25);
}
.btn-ghost:hover { border-color: rgba(245,240,231,0.55); }

/* ───────── FOOTER ───────── */
.footer { padding: 80px 0 40px; background: var(--bg-dark); color: #94A3B8; }
.footer-grid {
  display: grid; grid-template-columns: 1fr; gap: 48px; margin-bottom: 64px;
}
@media (min-width: 768px) { .footer-grid { grid-template-columns: 2fr 1fr 1fr 1fr; } }
.footer-brand p { font-size: 0.9375rem; line-height: 1.7; max-width: 320px; margin-top: 20px; }
.footer-col h4 {
  font-family: var(--font-display);
  font-size: 0.72rem; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: #E2E8F0; margin-bottom: 20px;
}
.footer-col a { display: block; font-size: 0.9375rem; margin-bottom: 14px; transition: var(--transition); }
.footer-col a:hover { color: var(--accent); }
.footer-bottom {
  padding-top: 32px; border-top: 1px solid rgba(255,255,255,0.08);
  display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center;
  gap: 16px; font-size: 0.84rem; color: #64748B;
}
.footer-links { display: flex; gap: 24px; }
.footer-links a:hover { color: #E2E8F0; }


/* Newsletter — CAPTCHA + honeypot */
.subscribe-btn:disabled, .subscribe-btn[aria-disabled="true"] { background: #C4B5A8; cursor: not-allowed; }
.nl-honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
.newsletter-captcha { position: relative; min-height: 60px; background: rgba(0,0,0,0.04); border: 1px solid var(--rule, #E2E8F0); border-radius: 8px; overflow: hidden; }
.newsletter-captcha[data-state="verified"] { background: rgba(31,139,92,0.06); border-color: rgba(31,139,92,0.30); }
.newsletter-captcha[data-state="verified"] .turnstile-spinner { border-color: var(--accent, #1F8B5C); animation: none; }
.newsletter-captcha[data-state="verified"] .turnstile-spinner::after { content: "\2713"; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 700; color: var(--accent, #1F8B5C); }
.newsletter-captcha[data-state="verified"] .turnstile-label { color: var(--accent-strong, #16734C); font-weight: 600; }
.turnstile-placeholder { display: flex; align-items: center; gap: 12px; padding: 12px 14px; }
.turnstile-spinner { position: relative; width: 16px; height: 16px; border: 2px solid var(--rule, #E2E8F0); border-top-color: var(--accent, #1F8B5C); border-radius: 50%; animation: nl-spin 0.9s linear infinite; flex-shrink: 0; }
@keyframes nl-spin { to { transform: rotate(360deg); } }
.turnstile-label { font-size: 0.85rem; color: var(--ink, #0F172A); flex-grow: 1; }
.turnstile-brand { font-family: var(--font-display, Syne, sans-serif); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3, #475569); }
.nl-message { font-size: 0.8rem; line-height: 1.4; padding: 2px; min-height: 1em; }
.nl-message.error { color: #B91C1C; }
.nl-message.success { color: var(--accent-strong, #16734C); }
</style>
</head>
