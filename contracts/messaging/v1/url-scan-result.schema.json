{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asps.local/contracts/messaging/v1/url-scan-result.schema.json",
  "title": "ASPS URL scan result v1",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "properties": {
        "messageType": { "const": "url_scan.result" },
        "outcome": {
          "type": "object",
          "required": ["status", "result"],
          "properties": {
            "status": { "const": "success" },
            "result": { "type": "object" }
          }
        }
      }
    }
  ]
}
