            <form class="subscribe-form" id="newsletter-form" novalidate>
              <input type="email" class="subscribe-input" name="email" placeholder="you@example.com" required/>

              <!-- Honeypot — hidden field bots tend to fill. -->
              <div aria-hidden="true" class="nl-honeypot">
                <label for="nl-website">Website (leave blank)</label>
                <input type="text" id="nl-website" name="website" tabindex="-1" autocomplete="off"/>
              </div>

              <!-- Cloudflare Turnstile CAPTCHA placeholder.
                   To activate (free, ~5 min):
                     1. Sign up at https://www.cloudflare.com/products/turnstile/
                     2. Replace data-sitekey="PLACEHOLDER" with your real sitekey
                     3. Uncomment the Turnstile <script> tag at the end of <body>. -->
              <div class="cf-turnstile newsletter-captcha"
                   data-sitekey="PLACEHOLDER"
                   data-callback="onNewsletterCaptchaSuccess"
                   data-theme="light">
                <div class="turnstile-placeholder" role="status" aria-live="polite">
                  <span class="turnstile-spinner" aria-hidden="true"></span>
                  <span class="turnstile-label">Vérification que vous êtes humain&hellip;</span>
                  <span class="turnstile-brand">Protégé par ASPS</span>
                </div>
              </div>

              <button type="submit" class="subscribe-btn" id="nl-submit">S'abonner</button>
              <div class="nl-message" role="status" aria-live="polite"></div>
            </form>
            <div class="subscribe-note">Gratuit · Désabonnement à tout moment</div>
          </div>
        </div>

      </aside>
    </div>
  </div>
</section>

