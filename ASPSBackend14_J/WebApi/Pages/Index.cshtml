@page
@model WebApi.Pages.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts: Syne + Inter (ASPS Brand) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Syne:wght@700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body style="font-family: 'Inter', sans-serif;">
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-2 d-md-block sidebar vh-100" style="background: #1A2255;">
                <div class="position-sticky pt-3">
                    <!-- ASPS Logo -->
                    <div class="px-3 pb-3 mb-3" style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <svg width="90" height="28" viewBox="0 0 120 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="0" y="0" width="5" height="28" rx="2.5" fill="url(#logo-grad)"/>
                                <defs><linearGradient id="logo-grad" x1="2.5" y1="0" x2="2.5" y2="28" gradientUnits="userSpaceOnUse"><stop stop-color="#22C55E"/><stop offset="1" stop-color="#16A34A"/></linearGradient></defs>
                                <text x="12" y="21" font-family="Syne, sans-serif" font-weight="800" font-size="18" fill="white" letter-spacing="0.05em">ASPS</text>
                                <circle cx="19" cy="5" r="3" fill="#22C55E" class="pulse-dot"/>
                                <circle cx="19" cy="5" r="1.2" fill="white"/>
                            </svg>
                            <span style="color:#7880A8;font-size:0.7rem;font-weight:500;">Admin</span>
                        </div>
                    </div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link active text-white" href="/" style="background: #22C55E; border-radius: 6px; margin: 2px 10px;">
                                <i class="fas fa-home"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" href="/Users" style="margin: 2px 10px;">
                                <i class="fas fa-users"></i> Users
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" href="/Devices" style="margin: 2px 10px;">
                                <i class="fas fa-mobile-alt"></i> Devices
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" href="/DeviceAlerts" style="margin: 2px 10px;">
                                <i class="fas fa-exclamation-triangle"></i> Alerts
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-10 ms-sm-auto px-md-4" style="background: #f8f9fa;">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2" style="font-family: 'Syne', sans-serif; color: #1A2255;">Dashboard</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Error!</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <div class="alert alert-info mt-2">
        <strong>Troubleshooting:</strong>
        <ul class="mb-0">
            <li>Ensure ASPSBackend is running: <code>dotnet run --project ASPSBackend</code></li>
            <li>Check logs for "CQRS Gateway started (tcp://*:5556)"</li>
            <li>Verify port 5556 is listening: <code>netstat -an | grep 5556</code></li>
        </ul>
    </div>
}
                    <div class="text-muted">
                        <i class="fas fa-clock"></i> @DateTime.Now.ToString("MMM dd, yyyy HH:mm")
                    </div>
                </div>

                <!-- Dashboard Cards -->
                <div class="row">
                    <!-- Users Card -->
                    <div class="col-xl-3 col-md-6 mb-4">
                        <a href="/Users" class="text-decoration-none">
                            <div class="card shadow h-100 py-2 hover-card" style="border-left: 4px solid #22C55E;">
                                <div class="card-body">
                                    <div class="row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #22C55E;">
                                                Total Users
                                            </div>
                                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                                @Model.UsersCount
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <i class="fas fa-users fa-2x" style="color: #22C55E;"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Devices Card -->
                    <div class="col-xl-3 col-md-6 mb-4">
                        <a href="/Devices" class="text-decoration-none">
                            <div class="card shadow h-100 py-2 hover-card" style="border-left: 4px solid #1A2255;">
                                <div class="card-body">
                                    <div class="row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <div class="text-xs font-weight-bold text-uppercase mb-1" style="color: #1A2255;">
                                                Total Devices
                                            </div>
                                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                                @Model.DevicesCount
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <i class="fas fa-mobile-alt fa-2x" style="color: #1A2255;"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Alerts Card -->
                    <div class="col-xl-3 col-md-6 mb-4">
                        <a href="/DeviceAlerts" class="text-decoration-none">
                            <div class="card shadow h-100 py-2 hover-card" style="border-left: 4px solid #f6c23e;">
                                <div class="card-body">
                                    <div class="row no-gutters align-items-center">
                                        <div class="col mr-2">
                                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                                Alerts (24h)
                                            </div>
                                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                                @Model.AlertsCount
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <i class="fas fa-exclamation-triangle fa-2x text-warning"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Phishing Websites Card -->
                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card shadow h-100 py-2" style="border-left: 4px solid #e74a3b;">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                            Phishing Sites
                                        </div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                                            @Model.PhishingWebsitesCount
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-shield-alt fa-2x text-danger"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- System Status -->
                <div class="row">
                    <div class="col-12">
                        <div class="card shadow mb-4">
                            <div class="card-header py-3" style="background: #1A2255; color: white;">
                                <h6 class="m-0 font-weight-bold">System Status</h6>
                            </div>
                            <div class="card-body">
                                <p><strong>Server Time:</strong> @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss UTC")</p>
                                <p><strong>Environment:</strong> Development</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="row">
                    <div class="col-12">
                        <div class="card shadow mb-4">
                            <div class="card-header py-3" style="background: #1A2255; color: white;">
                                <h6 class="m-0 font-weight-bold">Quick Actions</h6>
                            </div>
                            <div class="card-body">
                                <a href="/Users" class="btn me-2" style="background: #22C55E; color: white;">
                                    <i class="fas fa-users"></i> Manage Users
                                </a>
                                <a href="/Devices" class="btn me-2" style="background: #1A2255; color: white;">
                                    <i class="fas fa-mobile-alt"></i> View Devices
                                </a>
                                <a href="/DeviceAlerts" class="btn btn-warning me-2">
                                    <i class="fas fa-list"></i> View Alerts
                                </a>
                                <button class="btn btn-secondary" onclick="location.reload()">
                                    <i class="fas fa-sync"></i> Refresh
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <style>
        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
            padding: 48px 0 0;
            box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
        }
        .sidebar .nav-link {
            font-weight: 500;
            padding: 0.75rem 1rem;
            transition: all 0.3s;
        }
        .sidebar .nav-link:hover {
            background-color: #0F1238;
            color: white !important;
            border-radius: 6px;
        }
        .hover-card {
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15)!important;
        }
        .pulse-dot {
            animation: pulse 2s ease-in-out infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
    </style>
</body>
</html>
