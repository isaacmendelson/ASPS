<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<link rel="icon" href="../favicon.svg" type="image/svg+xml"/>
<meta name="description" content="Share your scam experience. Your story can protect others. There's nothing to be ashamed of."/>
<meta property="og:title" content="Share Your Story - ASPS"/>
<meta property="og:description" content="Your experience matters. Sharing your story can help protect others from scams."/>
<title>Comparte tu historia - ASPS</title>
<link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700;800;900&family=Newsreader:ital,opsz,wght@0,16..72,400;0,16..72,500;0,16..72,600;0,16..72,700;1,16..72,400;1,16..72,500&family=Instrument+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet"/>
<style>
:root {
  --bg-dark: #100E0B;
  --bg-navy: #1A1814;
  --bg-navy-2: #1A1814;
  --bg-white: #FFFFFF;
  --bg-light: #F3EFE8;
  --bg-warm-pink: #F3EFE8;
  --bg-warm-purple: #F3EFE8;
  --green-500: #BE3A4B;
  --green-400: #BE3A4B;
  --green-dim: rgba(190, 58, 75, 0.12);
  --purple: #7C3AED;
  --purple-dim: rgba(124,58,237,0.12);
  --pink: #EC4899;
  --pink-dim: rgba(236,72,153,0.12);
  --orange: #FF6B35;
  --text-white: #FFFFFF;
  --text-light: #E2E8F0;
  --text-muted: #94A3B8;
  --text-dark: #1A1814;
  --text-dark-2: #4A4640;
  --text-dark-3: #6B655C;
  --on-light-heading: #1A1814;
  --on-light-body: #475569;
  --border-dark: rgba(255,255,255,0.08);
  --border-light: #E4DDD2;
  --font-body: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-display: 'Syne', Georgia, serif;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --radius-full: 9999px;
  --transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-body);
  background: var(--bg-white);
  color: var(--text-dark);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}
@media (min-width: 768px) { .container { padding: 0 40px; } }

/* Navigation */
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  height: 72px;
  background: rgba(26,24,20,0.97);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border-dark);
}
.nav-inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 40px;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
}
.nav-logo { display: flex; align-items: center; }
.nav-links { display: none; align-items: center; gap: 8px; }
@media (min-width: 1024px) { .nav-links { display: flex; } }
.nav-link {
  padding: 8px 16px;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-muted);
  border-radius: var(--radius-sm);
  transition: var(--transition);
}
.nav-link:hover { color: var(--text-white); background: rgba(255,255,255,0.05); }
.nav-link.active { color: var(--pink); }
.nav-actions { display: flex; align-items: center; gap: 12px; }
.nav-btn {
  display: inline-flex;
  align-items: center;
  padding: 10px 20px;
  font-size: 0.875rem;
  font-weight: 600;
  border-radius: var(--radius-sm);
  transition: var(--transition);
  border: none;
}
.nav-btn-ghost {
  background: transparent;
  color: var(--text-muted);
  border: 1px solid var(--border-dark);
}
.nav-btn-ghost:hover { color: var(--text-white); border-color: rgba(255,255,255,0.25); }
.nav-btn-primary { background: var(--text-white); color: var(--bg-navy); }
.nav-btn-primary:hover { background: var(--bg-light); }

/* Hero */
.hero {
  padding: 140px 0 80px;
  background: linear-gradient(135deg, var(--bg-warm-pink) 0%, var(--bg-warm-purple) 100%);
  text-align: center;
  position: relative;
  overflow: hidden;
}
.hero-pattern {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle at 2px 2px, rgba(236,72,153,0.08) 1px, transparent 0);
  background-size: 32px 32px;
}
.hero-icon {
  width: 80px;
  height: 80px;
  margin: 0 auto 32px;
  background: linear-gradient(135deg, var(--pink), var(--purple));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.5rem;
  box-shadow: 0 8px 32px rgba(236,72,153,0.3);
}
.hero-title {
  font-family: var(--font-display);
  font-size: clamp(2.25rem, 5vw, 3.5rem);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.03em;
  color: var(--on-light-heading);
  margin-bottom: 24px;
}
.hero-title-accent { color: var(--pink); }
.hero-subtitle {
  font-size: 1.25rem;
  line-height: 1.8;
  color: var(--on-light-body);
  max-width: 700px;
  margin: 0 auto;
}

/* Section */
.section { padding: 80px 0; }
.section-warm { background: linear-gradient(180deg, var(--bg-warm-purple) 0%, var(--bg-white) 100%); }
.section-light { background: var(--bg-white); }
.section-gray { background: var(--bg-light); }

/* Why Share Section */
.why-share-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  margin-top: 48px;
}
@media (min-width: 768px) { .why-share-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .why-share-grid { grid-template-columns: repeat(3, 1fr); } }

.why-card {
  padding: 40px 32px;
  background: var(--bg-white);
  border-radius: var(--radius-xl);
  box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  transition: var(--transition);
}
.why-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(236,72,153,0.12);
}
.why-card-icon {
  width: 64px;
  height: 64px;
  background: var(--pink-dim);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.75rem;
  margin-bottom: 24px;
}
.why-card h3 {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--on-light-heading);
  margin-bottom: 12px;
}
.why-card p {
  font-size: 1rem;
  color: var(--on-light-body);
  line-height: 1.75;
}

/* Truth Section */
.truth-section {
  padding: 100px 0;
  background: linear-gradient(135deg, var(--bg-navy) 0%, var(--bg-navy-2) 100%);
}
.truth-content {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
}
.truth-quote {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 800;
  color: var(--text-white);
  line-height: 1.5;
  margin-bottom: 32px;
}
.truth-quote .highlight {
  color: var(--pink);
}
.truth-text {
  font-size: 1.125rem;
  color: var(--text-light);
  line-height: 1.85;
  margin-bottom: 24px;
}
.truth-stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 48px;
  margin-top: 48px;
  padding-top: 48px;
  border-top: 1px solid var(--border-dark);
}
.truth-stat {
  text-align: center;
}
.truth-stat-value {
  font-family: var(--font-display);
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--pink);
  margin-bottom: 8px;
}
.truth-stat-label {
  font-size: 0.9375rem;
  color: var(--text-muted);
}

/* Myths Section */
.myths-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
  margin-top: 48px;
}
@media (min-width: 768px) { .myths-grid { grid-template-columns: repeat(2, 1fr); } }

.myth-card {
  padding: 32px;
  background: var(--bg-white);
  border: 2px solid var(--border-light);
  border-radius: var(--radius-xl);
}
.myth-label {
  display: inline-block;
  padding: 6px 12px;
  background: #FEE2E2;
  color: #DC2626;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-radius: var(--radius-full);
  margin-bottom: 16px;
}
.myth-text {
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--text-dark-2);
  margin-bottom: 16px;
  text-decoration: line-through;
  text-decoration-color: #DC2626;
}
.truth-label {
  display: inline-block;
  padding: 6px 12px;
  background: var(--green-dim);
  color: var(--green-500);
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-radius: var(--radius-full);
  margin-bottom: 12px;
}
.reality-text {
  font-size: 1rem;
  color: var(--on-light-body);
  line-height: 1.75;
}

/* Stories Examples */
.stories-examples {
  margin-top: 48px;
}
.story-example {
  padding: 40px;
  background: linear-gradient(135deg, var(--bg-warm-pink), var(--bg-warm-purple));
  border-radius: var(--radius-xl);
  margin-bottom: 24px;
}
.story-example-quote {
  font-size: 1.1875rem;
  font-style: italic;
  color: var(--on-light-heading);
  line-height: 1.8;
  margin-bottom: 20px;
}
.story-example-author {
  font-size: 0.9375rem;
  color: var(--on-light-body);
  font-weight: 600;
}
.story-example-context {
  font-size: 0.875rem;
  color: var(--text-dark-3);
  margin-top: 4px;
}

/* Promise Section */
.promise-section {
  padding: 80px 0;
  background: var(--bg-light);
}
.promise-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
  margin-top: 40px;
}
@media (min-width: 768px) { .promise-grid { grid-template-columns: repeat(3, 1fr); } }

.promise-card {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 24px;
  background: var(--bg-white);
  border-radius: var(--radius-lg);
}
.promise-icon {
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  background: var(--green-dim);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
}
.promise-card h4 {
  font-size: 1rem;
  font-weight: 700;
  color: var(--on-light-heading);
  margin-bottom: 6px;
}
.promise-card p {
  font-size: 0.9375rem;
  color: var(--on-light-body);
  line-height: 1.6;
}

/* Form Section */
.form-section {
  padding: 100px 0;
  background: var(--bg-white);
}
.form-container {
  max-width: 700px;
  margin: 0 auto;
}
.form-header {
  text-align: center;
  margin-bottom: 48px;
}
.form-title {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 800;
  color: var(--on-light-heading);
  margin-bottom: 16px;
}
.form-subtitle {
  font-size: 1.0625rem;
  color: var(--on-light-body);
  line-height: 1.7;
}

.story-form {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.form-label {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--on-light-heading);
}
.form-label-optional {
  font-weight: 400;
  color: var(--text-dark-3);
}
.form-input,
.form-select,
.form-textarea {
  padding: 16px 20px;
  font-size: 1rem;
  font-family: var(--font-body);
  color: var(--text-dark);
  background: var(--bg-light);
  border: 2px solid transparent;
  border-radius: var(--radius-md);
  transition: var(--transition);
}
.form-input:focus,
.form-select:focus,
.form-textarea:focus {
  outline: none;
  border-color: var(--pink);
  background: var(--bg-white);
}
.form-textarea {
  min-height: 200px;
  resize: vertical;
}
.form-hint {
  font-size: 0.8125rem;
  color: var(--text-dark-3);
  line-height: 1.5;
}

.form-checkbox-group {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}
.form-checkbox {
  width: 20px;
  height: 20px;
  margin-top: 2px;
  accent-color: var(--pink);
}
.form-checkbox-label {
  font-size: 0.9375rem;
  color: var(--on-light-body);
  line-height: 1.6;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 16px 32px;
  font-size: 1rem;
  font-weight: 600;
  border-radius: var(--radius-md);
  border: none;
  cursor: pointer;
  transition: var(--transition);
}
.btn-pink {
  background: linear-gradient(135deg, var(--pink), var(--purple));
  color: var(--text-white);
  box-shadow: 0 4px 20px rgba(236,72,153,0.35);
}
.btn-pink:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(236,72,153,0.45);
}

.form-success {
  display: none;
  text-align: center;
  padding: 48px;
  background: var(--green-dim);
  border-radius: var(--radius-xl);
}
.form-success-icon {
  font-size: 3rem;
  margin-bottom: 16px;
}
.form-success h3 {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--green-500);
  margin-bottom: 12px;
}
.form-success p {
  font-size: 1rem;
  color: var(--on-light-body);
  line-height: 1.7;
}

/* Section Headers */
.section-header {
  max-width: 700px;
  margin-bottom: 48px;
}
.section-header.center {
  text-align: center;
  margin-left: auto;
  margin-right: auto;
}
.section-label {
  display: inline-block;
  padding: 8px 16px;
  background: var(--pink-dim);
  color: var(--pink);
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  border-radius: var(--radius-full);
  margin-bottom: 20px;
}
.section-title {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.03em;
  color: var(--on-light-heading);
  margin-bottom: 16px;
}
.section-subtitle {
  font-size: 1.125rem;
  line-height: 1.8;
  color: var(--on-light-body);
}

/* Footer */
.footer {
  padding: 80px 0 40px;
  background: var(--bg-dark);
}
.footer-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 48px;
  margin-bottom: 64px;
}
@media (min-width: 768px) { .footer-grid { grid-template-columns: 2fr 1fr 1fr 1fr; } }
.footer-brand p {
  font-size: 0.9375rem;
  color: var(--text-muted);
  line-height: 1.75;
  max-width: 320px;
  margin-top: 20px;
}
.footer-col h4 {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--text-light);
  margin-bottom: 20px;
}
.footer-col a {
  display: block;
  font-size: 0.9375rem;
  color: var(--text-muted);
  margin-bottom: 14px;
  transition: var(--transition);
}
.footer-col a:hover { color: var(--green-400); }
.footer-bottom {
  padding-top: 32px;
  border-top: 1px solid var(--border-dark);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
}
.footer-bottom p { font-size: 0.875rem; color: #64748B; }
.footer-links { display: flex; gap: 24px; }
.footer-links a { font-size: 0.875rem; color: #64748B; transition: var(--transition); }
.footer-links a:hover { color: var(--text-light); }
/* Language Dropdown */
.lang-dropdown {
  position: relative;
}
.lang-dropdown-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 8px;
  color: #E2E8F0;
  font-size: 0.8125rem;
  font-weight: 600;
  cursor: pointer;
  transition: 0.25s;
}
.lang-dropdown-btn:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.25);
}
.lang-dropdown-menu {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  min-width: 140px;
  padding: 8px 0;
  background: #1A1814;
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 12px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px);
  transition: 0.25s;
  z-index: 100;
}
.lang-dropdown:hover .lang-dropdown-menu,
.lang-dropdown:focus-within .lang-dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}
.lang-option {
  display: block;
  padding: 10px 16px;
  font-size: 0.875rem;
  color: #94A3B8;
  transition: 0.25s;
  text-decoration: none;
}
.lang-option:hover {
  background: rgba(255,255,255,0.05);
  color: #FFFFFF;
}
.lang-option.active {
  color: #BE3A4B;
  font-weight: 600;
}

</style>

<style>
/* EDITORIAL THEME OVERRIDE */
:root{--ed-paper:#FAF7F2;--ed-paper-2:#F3EFE8;--ed-ink:#1A1814;--ed-ink-2:#4A4640;--ed-ink-3:#6B655C;--ed-accent:#BE3A4B;--ed-accent-strong:#8E1A2A;--ed-rule:#E4DDD2;--ed-rule-2:#D7CFC2;--ed-serif:'Frank Ruhl Libre','Newsreader',Georgia,serif}
body{background:var(--ed-paper) !important;color:var(--ed-ink)}
h1,h2,h3,h4,h5,.hero-title,.section-title,.page-hero h1{font-family:var(--ed-serif) !important;font-weight:500 !important;letter-spacing:0 !important}
.hero-title,.section-title{letter-spacing:-.01em !important}
.section-eyebrow,.hero-eyebrow,.hero-badge,.stat-label,.step-num,.stat-value,.footer-col h4,.nav-link,.nav-btn,.btn{font-family:'Syne',Georgia,serif !important}
.why-now,.human-section,.pain-cards-grid,.stats,section[class*="warm"]{background:var(--ed-paper-2) !important}
.hero,.partners,.how-it-works,.footer,footer.footer{background-color:var(--ed-ink) !important}
.hero{background-image:linear-gradient(145deg,var(--ed-ink) 0%,#2A2620 60%,var(--ed-ink) 100%) !important}
.partners,.how-it-works{background-image:none !important}
.nav{background:rgba(26,24,20,0.96) !important}
.nav-link.active{color:var(--ed-accent) !important}
.nav-link.active::after{background:var(--ed-accent) !important}
.btn-green,.cf-btn,button[type="submit"].cf-btn{background:var(--ed-accent) !important;background-image:linear-gradient(135deg,var(--ed-accent),var(--ed-accent-strong)) !important;color:#fff !important;box-shadow:0 4px 20px rgba(190,58,75,0.30) !important}
.hero-badge{background:rgba(190,58,75,0.10) !important;border-color:rgba(190,58,75,0.30) !important}
.hero-badge-dot{background:var(--ed-accent) !important;box-shadow:0 0 12px var(--ed-accent) !important}
.threat-pill-dot.green{background:var(--ed-accent) !important;box-shadow:0 0 8px var(--ed-accent) !important}
.stat-value.green,.stat-value.dark{color:var(--ed-accent) !important}
.hero-stat-value,.hero-title-accent{color:var(--ed-accent) !important}
.pain-card:hover,.intel-card:hover{border-color:var(--ed-accent) !important;box-shadow:0 8px 30px rgba(190,58,75,0.10) !important}
.footer-col a:hover,a:hover{color:var(--ed-accent)}
.origin-body p,.mission-statement,.princ-body,.pullquote-text,.pain-card p,.step-card p,.intel-card p,.human-section p,.epidemic p{font-family:'Newsreader',Georgia,serif}
.cf-input,.cf-textarea,input[type="text"],input[type="email"],textarea,select{background:#FFFFFF !important;border-color:var(--ed-rule-2) !important;color:var(--ed-ink) !important}
.cf-input:focus,.cf-textarea:focus,input:focus,textarea:focus,select:focus{border-color:var(--ed-accent) !important;outline:none !important}
.pain-card,.intel-card,.step-card,.partner-logo{background:#FFFFFF !important;border-color:var(--ed-rule) !important}
.footer a{color:#94A3B8}
.footer a:hover{color:var(--ed-accent)}
section[style*="background:#fff"],section[style*="background:#FFFFFF"],main[style*="background:#fff"]{background:var(--ed-paper) !important}
.page-hero{background:var(--ed-ink) !important}
.contact-info-label,.contact-press strong{color:var(--ed-ink) !important}
.ci-icon{background:rgba(190,58,75,0.10) !important}
.ci-icon svg{stroke:var(--ed-accent) !important}
.contact-press{border-left-color:var(--ed-accent) !important}
.ci-row:hover{color:var(--ed-accent) !important}
html[lang="he"] body{font-family:'Heebo',sans-serif}
.skip-link{background:var(--ed-accent) !important}
</style>
</head>
<body>

<!-- Navigation -->
<nav class="nav">
  <div class="nav-inner">
    <a href="index.html" class="nav-logo">
      <svg width="120" height="32" viewBox="0 0 148 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="0" y="0" width="3" height="40" rx="1.5" fill="url(#logoGrad)"/>
        <text x="12" y="27" font-family="'Syne', serif" font-weight="800" font-size="22" fill="#FFFFFF" letter-spacing="-0.5">ASPS</text>
        <circle cx="20" cy="6" r="4" fill="#BE3A4B"/>
        <circle cx="20" cy="6" r="4" fill="#BE3A4B" opacity="0.4">
          <animate attributeName="r" values="4;8;4" dur="2.5s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.4;0;0.4" dur="2.5s" repeatCount="indefinite"/>
        </circle>
        <circle cx="20" cy="6" r="2" fill="#FFFFFF"/>
        <defs>
          <linearGradient id="logoGrad" x1="0" y1="0" x2="0" y2="40" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#BE3A4B"/>
            <stop offset="100%" stop-color="#8E1A2A"/>
          </linearGradient>
        </defs>
      </svg>
    </a>
    
    <div class="nav-links">
       <a href="#epidemic" class="nav-link">La amenaza</a>
      <a href="platform.html" class="nav-link">Cómo funciona</a>
