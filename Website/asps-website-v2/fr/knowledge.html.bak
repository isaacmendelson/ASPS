<script>
// Filtrer tabs
document.addEventListener('DOMContentLoaded', function() {
  const tabs = document.querySelectorAll('.filter-tab');
  const items = document.querySelectorAll('#articleList > li');
  const count = document.getElementById('filterCount');

  function applyFiltrer(filter) {
    let n = 0;
    items.forEach(li => {
      const cat = li.dataset.cat;
      const match = filter === 'all' || cat === filter;
      li.style.display = match ? '' : 'none';
      if (match) n++;
    });
    count.innerHTML = '<strong>' + n + '</strong> ' + (n === 1 ? 'entry' : 'entries');
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', function() {
      tabs.forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      applyFiltrer(this.dataset.filter);
    });
  });

  // Topic tag jumps to filter
  document.querySelectorAll('.topic-tag[data-jump]').forEach(tag => {
    tag.addEventListener('click', function(e) {
      const target = this.dataset.jump;
      const matching = document.querySelector('.filter-tab[data-filter="' + target + '"]');
      if (matching) {
        tabs.forEach(t => t.classList.remove('active'));
        matching.classList.add('active');
        applyFiltrer(target);
      }
    });
  });
});
</script>


<script>
(function () {
  const form = document.getElementById("newsletter-form");
  if (!form) return;
  const emailInput = form.querySelector(".subscribe-input");
  const submitBtn  = form.querySelector(".subscribe-btn");
  const honeypot   = form.querySelector("#nl-website");
  const captchaBox = form.querySelector(".newsletter-captcha");
  const captchaLbl = form.querySelector(".turnstile-label");
  const msg        = form.querySelector(".nl-message");

  let captchaToken = null;
  submitBtn.setAttribute("aria-disabled", "true");

  function showMsg(text, kind) {
    msg.textContent = text || "";
    msg.className = "nl-message" + (kind ? " " + kind : "");
  }

  window.onNewsletterCaptchaSuccess = function (token) {
    captchaToken = token || "verified";
    captchaBox.setAttribute("data-state", "verified");
    if (captchaLbl) captchaLbl.textContent = "Verified — you're human";
    submitBtn.removeAttribute("aria-disabled");
  };

  // Placeholder mode: simulate verification if no real sitekey.
  const sitekey = captchaBox && captchaBox.getAttribute("data-sitekey");
  if (!sitekey || sitekey === "PLACEHOLDER") {
    setTimeout(function () { if (!captchaToken) window.onNewsletterCaptchaSuccess("placeholder-token"); }, 1400);
  }

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    const email = (emailInput.value || "").trim();

    // Honeypot tripped → silently succeed.
    if (honeypot && honeypot.value) {
      showMsg("Thanks — we'll be in touch.", "success");
      emailInput.value = "";
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showMsg("Please enter a valid email address.", "error");
      emailInput.focus();
      return;
    }
    if (!captchaToken) {
      showMsg("Hang on — still verifying you're human.", "error");
      return;
    }

    // Success — real backend would POST email + captchaToken here.
    const orig = submitBtn.textContent;
    submitBtn.textContent = "✓ S'abonnerd!";
    emailInput.value = "";
    emailInput.disabled = true;
    submitBtn.disabled = true;
    showMsg("You're in. Watch for the weekly brief in your inbox.", "success");
    setTimeout(function () {
      submitBtn.textContent = orig;
      emailInput.disabled = false;
      submitBtn.disabled = false;
    }, 4000);
  });
})();
</script>
</body>
