@page
@model WebApi.Pages.Devices.DetailsModel
@{
    ViewData["Title"] = "Device Details";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Device Details</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a href="/Devices" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Devices
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Device != null)
{
    <div class="row">
        <!-- Device Information Card -->
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-laptop"></i> Device Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Device UID:</dt>
                        <dd class="col-sm-8"><code>@Model.Device.DeviceUid</code></dd>

                        <dt class="col-sm-4">Type:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Device.DeviceType == Common.Enums.DeviceType.MobilePhone)
                            {
                                <span class="badge bg-primary"><i class="fas fa-mobile-alt"></i> SmartPhone</span>
                            }
                            else
                            {
                                <span class="badge bg-info"><i class="fas fa-desktop"></i> PC</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Operating System:</dt>
                        <dd class="col-sm-8">
                            @Model.Device.OperatingSystem
                        </dd>

                        <dt class="col-sm-4">Make/Model:</dt>
                        <dd class="col-sm-8">@Model.Device.Make @Model.Device.Model</dd>

                        <dt class="col-sm-4">MAC Address:</dt>
                        <dd class="col-sm-8"><code>@Model.Device.MAC</code></dd>

                        <dt class="col-sm-4">Monitoring Status:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Device.MonitoringStatus == Common.Enums.DeviceMonitoringStatus.Enabled)
                            {
                                <span class="badge bg-success"><i class="fas fa-shield-alt"></i> Enabled</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Model.Device.MonitoringStatus</span>
                            }
                        </dd>

                        @if (Model.Device is Common.Entities.PersonalComputer pc)
                        {
                            <dt class="col-sm-4">Motherboard:</dt>
                            <dd class="col-sm-8"><code>@pc.MotherboardSerial</code></dd>
                        }

                        @if (Model.Device is Common.Entities.SmartPhone phone)
                        {
                            <dt class="col-sm-4">Phone Number:</dt>
                            <dd class="col-sm-8">@phone.PhoneNumber</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <!-- Owner Information Card -->
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-user"></i> Owner Information</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.OwnerName))
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Owner:</dt>
                            <dd class="col-sm-8">@Model.OwnerName</dd>

                            <dt class="col-sm-4">User Key:</dt>
                            <dd class="col-sm-8"><code>@Model.Device.UserKeyField</code></dd>
                        </dl>
                        <div class="mt-3">
                            <button class="btn btn-sm btn-primary" onclick="viewUser('@Model.Device.UserKeyField')">
                                <i class="fas fa-eye"></i> View User Profile
                            </button>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">This device is not registered to any user.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Alerts Section -->
    <div class="card shadow mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Recent Alerts (Last 7 Days)</h5>
        </div>
        <div class="card-body">
            @if (Model.RecentAlerts.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Type</th>
                                <th>Priority</th>
                                <th>Details</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alert in Model.RecentAlerts.Take(10))
                            {
                                <tr>
                                    <td>@alert.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@alert.AlertType</td>
                                    <td>
                                        @{
                                            var priorityClass = alert.Priority switch
                                            {
                                                Common.Enums.Priority.Critical => "danger",
                                                Common.Enums.Priority.High => "warning",
                                                Common.Enums.Priority.Medium => "info",
                                                _ => "secondary"
                                            };
                                        }
                                        <span class="badge bg-@priorityClass">@alert.Priority</span>
                                    </td>
                                    <td>
                                        @if (alert is Common.Entities.UrlAlertEntity urlAlert)
                                        {
                                            <small>@urlAlert.Url</small>
                                        }
                                        else if (alert is Common.Entities.RemoteAccessAlertEntity raAlert)
                                        {
                                            <small>@raAlert.RemoteAccessApp - @raAlert.ConnectionUrl</small>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-primary" onclick="viewAlert('@alert.KeyField')">
                                            <i class="fas fa-eye"></i> View
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No recent alerts for this device.</p>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i> Device not found.
    </div>
}
