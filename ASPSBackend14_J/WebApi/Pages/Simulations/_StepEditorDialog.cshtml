<!-- Step Editor Modal -->
<div class="modal fade" id="stepEditorModal" tabindex="-1" aria-labelledby="stepEditorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="stepEditorModalLabel">
                    <i class="fas fa-edit"></i> Edit Simulation Step
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="step-editor-form">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="step-sequence" class="form-label">Sequence # <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="step-sequence" min="1" required />
                            <div class="form-text">Execution order (1 = first)</div>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label for="step-delay-ms" class="form-label">Delay (ms) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="step-delay-ms" min="0" required />
                            <div class="form-text">Wait time before this step (milliseconds)</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="step-user-search" class="form-label">Target User <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="step-user-search" 
                               placeholder="Start typing user name, email or phone..." 
                               autocomplete="off" />
                        <input type="hidden" id="step-user-id" />
                        <div id="user-autocomplete-list" class="autocomplete-items"></div>
                        <div class="form-text">Search by first name, last name, email, or phone</div>
                    </div>

                    <div class="mb-3">
                        <label for="step-device-uid" class="form-label">Target Device <span class="text-danger">*</span></label>
                        <select class="form-select" id="step-device-uid" required disabled>
                            <option value="">-- Select a user first --</option>
                        </select>
                        <div class="form-text">Select a device from the user's registered devices</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="step-alert-type" class="form-label">Alert Type <span class="text-danger">*</span></label>
                            <select class="form-select" id="step-alert-type" required>
                                <option value="UrlAlert">URL Alert</option>
                                <option value="RemoteAccessAlert">Remote Access Alert</option>
                                <option value="TrackUrlAlert">Track URL Alert</option>
                            </select>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label for="step-priority" class="form-label">Priority</label>
                            <select class="form-select" id="step-priority">
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High" selected>High</option>
                                <option value="Critical">Critical</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="step-alert-json" class="form-label">Alert JSON Data <span class="text-danger">*</span></label>
                        <textarea class="form-control font-monospace" id="step-alert-json" rows="8" required 
                                  placeholder='{"Url": "https://example.com", "Title": "Test Alert", ...}'></textarea>
                        <div class="form-text">JSON representation of the alert object (UrlAlert, RemoteAccessAlert, etc.)</div>
                    </div>

                    <div class="alert alert-warning">
                        <strong><i class="fas fa-exclamation-triangle"></i> Note:</strong>
                        Make sure the Alert JSON matches the selected Alert Type structure.
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveStep()">
                    <i class="fas fa-save"></i> Save Step
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.autocomplete-items {
    position: absolute;
    border: 1px solid #d4d4d4;
    border-top: none;
    z-index: 99;
    max-height: 200px;
    overflow-y: auto;
    width: calc(100% - 2rem);
    background-color: #fff;
}
.autocomplete-items div {
    padding: 10px;
    cursor: pointer;
    border-bottom: 1px solid #d4d4d4;
}
.autocomplete-items div:hover {
    background-color: #e9e9e9;
}
.autocomplete-items .user-info {
    font-size: 0.875rem;
}
.autocomplete-items .user-info .name {
    font-weight: bold;
}
.autocomplete-items .user-info .details {
    color: #6c757d;
    font-size: 0.8rem;
}
.device-option-details {
    font-size: 0.8rem;
    color: #6c757d;
}
</style>

<script>
// User autocomplete functionality
let userSearchTimeout = null;
const userSearchInput = document.getElementById('step-user-search');
const userIdInput = document.getElementById('step-user-id');
const deviceSelect = document.getElementById('step-device-uid');
const autocompleteList = document.getElementById('user-autocomplete-list');

userSearchInput.addEventListener('input', function() {
    clearTimeout(userSearchTimeout);
    const searchText = this.value.trim();
    
    if (searchText.length < 2) {
        autocompleteList.innerHTML = '';
        return;
    }
    
    userSearchTimeout = setTimeout(() => {
        searchUsers(searchText);
    }, 300);
});

userSearchInput.addEventListener('blur', function() {
    // Delay hiding to allow click on autocomplete item
    setTimeout(() => {
        autocompleteList.innerHTML = '';
    }, 200);
});

async function searchUsers(searchText) {
    try {
        const response = await fetch(`/api/simulations/users?search=${encodeURIComponent(searchText)}`);
        if (!response.ok) throw new Error('Failed to search users');
        
        const users = await response.json();
        renderUserAutocomplete(users);
    } catch (error) {
        console.error('Error searching users:', error);
        autocompleteList.innerHTML = '<div class="text-danger p-2">Error loading users</div>';
    }
}

function renderUserAutocomplete(users) {
    if (users.length === 0) {
        autocompleteList.innerHTML = '<div class="text-muted p-2">No users found</div>';
        return;
    }
    
    let html = '';
    users.forEach(user => {
        const displayName = `${user.firstName} ${user.lastName}`.trim() || 'Unnamed User';
        const details = [user.email, user.phoneNumber].filter(x => x).join(' | ');
        
        html += `<div onclick="selectUser('${user.userKey.keyField}', '${escapeHtml(displayName)}', '${escapeHtml(details)}')" class="user-info">
            <div class="name">${escapeHtml(displayName)}</div>
            <div class="details">${escapeHtml(details)}</div>
        </div>`;
    });
    
    autocompleteList.innerHTML = html;
}

function selectUser(userKeyField, displayName, details) {
    userIdInput.value = userKeyField;
    userSearchInput.value = displayName + (details ? ` (${details})` : '');
    autocompleteList.innerHTML = '';
    
    // Load devices for selected user
    loadUserDevices(userKeyField);
}

async function loadUserDevices(userKeyField) {
    deviceSelect.innerHTML = '<option value="">Loading devices...</option>';
    deviceSelect.disabled = true;
    
    try {
        const response = await fetch(`/api/simulations/users/${encodeURIComponent(userKeyField)}/devices`);
        if (!response.ok) throw new Error('Failed to load devices');
        
        const devices = await response.json();
        renderDeviceOptions(devices);
    } catch (error) {
        console.error('Error loading devices:', error);
        deviceSelect.innerHTML = '<option value="">Error loading devices</option>';
    }
}

function renderDeviceOptions(devices) {
    if (devices.length === 0) {
        deviceSelect.innerHTML = '<option value="">No devices found for this user</option>';
        deviceSelect.disabled = true;
        return;
    }
    
    let html = '<option value="">-- Select a device --</option>';
    devices.forEach(device => {
        const deviceType = getDeviceTypeDisplay(device.deviceType);
        const displayText = `${device.deviceUid} - ${deviceType}`;
        const osInfo = device.operatingSystem ? ` (${device.operatingSystem})` : '';
        
        html += `<option value="${escapeHtml(device.deviceUid)}">${escapeHtml(displayText)}${escapeHtml(osInfo)}</option>`;
    });
    
    deviceSelect.innerHTML = html;
    deviceSelect.disabled = false;
}

function getDeviceTypeDisplay(deviceType) {
    const types = {
        'Desktop': '🖥️ Desktop',
        'Laptop': '💻 Laptop',
        'Mobile': '📱 Mobile',
        'Tablet': '📱 Tablet',
        'Phone': '📱 Phone',
        'Computer': '🖥️ Computer',
        'Unknown': '❓ Unknown'
    };
    return types[deviceType] || deviceType || 'Unknown';
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Override saveStep to use the hidden user ID
const originalSaveStep = window.saveStep;
window.saveStep = function() {
    // Validate user selection
    if (!userIdInput.value) {
        alert('Please select a user from the autocomplete list');
        userSearchInput.focus();
        return;
    }
    
    // Validate device selection
    if (!deviceSelect.value) {
        alert('Please select a device');
        deviceSelect.focus();
        return;
    }
    
    const editingIndex = document.getElementById('stepEditorModal').dataset.editingIndex;
    
    const step = {
        Sequence: parseInt(document.getElementById('step-sequence').value),
        DelayMs: parseInt(document.getElementById('step-delay-ms').value),
        UserId: userIdInput.value,
        DeviceUid: deviceSelect.value,
        AlertType: document.getElementById('step-alert-type').value,
        AlertJson: document.getElementById('step-alert-json').value,
        Priority: document.getElementById('step-priority').value
    };
    
    if (editingIndex !== null && editingIndex !== 'null') {
        steps[editingIndex] = step;
    } else {
        steps.push(step);
    }
    
    renderSteps();
    updateStepsJson();
    
    const modal = bootstrap.Modal.getInstance(document.getElementById('stepEditorModal'));
    modal.hide();
};

// Modify openStepEditor to populate user and device fields
const originalOpenStepEditor = window.openStepEditor;
window.openStepEditor = function(stepIndex) {
    const modal = new bootstrap.Modal(document.getElementById('stepEditorModal'));
    
    // Clear form
    document.getElementById('step-sequence').value = steps.length + 1;
    document.getElementById('step-delay-ms').value = '0';
    userIdInput.value = '';
    userSearchInput.value = '';
    deviceSelect.innerHTML = '<option value="">-- Select a user first --</option>';
    deviceSelect.disabled = true;
    document.getElementById('step-alert-type').value = 'UrlAlert';
    document.getElementById('step-alert-json').value = '{}';
    document.getElementById('step-priority').value = 'High';
    
    // If editing, populate form
    if (stepIndex !== null && steps[stepIndex]) {
        const step = steps[stepIndex];
        document.getElementById('step-sequence').value = step.Sequence;
        document.getElementById('step-delay-ms').value = step.DelayMs;
        userIdInput.value = step.UserId;
        userSearchInput.value = step.UserId; // Will be replaced when user data loads
        document.getElementById('step-alert-type').value = step.AlertType;
        document.getElementById('step-alert-json').value = step.AlertJson;
        document.getElementById('step-priority').value = step.Priority;
        
        // Load user info and devices if we have a user ID
        if (step.UserId) {
            loadUserDevices(step.UserId).then(() => {
                // Pre-select the device
                if (step.DeviceUid) {
                    deviceSelect.value = step.DeviceUid;
                }
            });
            // Try to load user display name
            loadUserDisplayName(step.UserId);
        }
    }
    
    // Store current index for save
    document.getElementById('stepEditorModal').dataset.editingIndex = stepIndex;
    
    modal.show();
};

async function loadUserDisplayName(userKeyField) {
    try {
        const response = await fetch(`/api/simulations/users?search=${encodeURIComponent(userKeyField)}`);
        if (response.ok) {
            const users = await response.json();
            const user = users.find(u => u.userKey.keyField === userKeyField);
            if (user) {
                const displayName = `${user.firstName} ${user.lastName}`.trim() || 'Unnamed User';
                const details = [user.email, user.phoneNumber].filter(x => x).join(' | ');
                userSearchInput.value = displayName + (details ? ` (${details})` : '');
            }
        }
    } catch (error) {
        console.error('Error loading user display name:', error);
    }
}
</script>
