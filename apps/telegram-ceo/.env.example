# Deployment note (ASPS-743/ASPS-745): in production this file (as `.env`,
# never this example) should live OUTSIDE the agent's working tree
# (`WORKING_DIR`, the git clone the agent reads/writes), so a path-guard
# bypass or an over-broad Read can never reach it by construction. The path
# guard in src/security.ts also unconditionally denies `.env`/`ACCESS_KEYS*`/
# key-file patterns even inside the tree, but "outside cwd" is the primary
# control; actual secret relocation on the VPS is tracked separately
# (ASPS-745), out of scope for local dev.

# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Claude auth — provide ONE of the two (CLAUDE_CODE_OAUTH_TOKEN is preferred):

# Subscription auth token for the Claude Agent SDK. Generate locally with:
#   claude setup-token
# Full native toolset, billed against the Claude subscription, no per-token cost.
CLAUDE_CODE_OAUTH_TOKEN=your-oauth-token-here

# Raw Anthropic API key — fallback for local dev without a subscription token.
# Leave unset if CLAUDE_CODE_OAUTH_TOKEN is set.
ANTHROPIC_API_KEY=your-api-key-here

# Comma-separated Telegram user IDs allowed to use the bot
AUTHORIZED_USERS=123456789

# Project root — the bot's working directory. Passed to the SDK as `cwd`.
# NOTE: settingSources is deliberately [] (SDK isolation mode) — .claude/settings.json
# is NOT auto-loaded (its permissions.allow would bypass canUseTool). CLAUDE.md
# and .mcp.json are read from here by hand instead (src/context.ts) and passed
# explicitly. See README.md's "Permission model" section for why.
WORKING_DIR=C:\Jobs\ASPS\GitHub\Software

# Claude model to use. Leave unset to use the Claude Code CLI default.
MODEL=

# Maximum number of agent turns per Telegram message before the SDK stops
# (safety limit on the agentic loop). Default: 20.
MAX_TURNS=20

# How long a Telegram approval prompt (Write/Edit/Bash/etc.) waits for the
# authorized user to tap Approve/Deny before it is treated as denied.
# Milliseconds. Default: 60000 (60s).
APPROVAL_TIMEOUT_MS=60000

# --- Read-only JIRA + GitHub MCP servers (ASPS-748) ---------------------
# Two extra MCP servers are wired in by hand in src/agent.ts (NOT via
# .mcp.json — they are bot-process-scoped, not shared with interactive
# Claude Code sessions in this repo) so JIRA/GitHub project questions are
# answered with native tools instead of the agent shelling out to `curl`/
# `gh` via Bash. Both are auto-allowed like the knowledge-engine tools
# because both are read-only by construction (see the AUTO_ALLOW_MCP_WILDCARDS
# comment in src/agent.ts), not merely by policy.

# GitHub — read-only remote MCP server (https://api.githubcopilot.com/mcp/readonly).
# Reuses the same token the agent already uses for `gh`/git operations.
GITHUB_TOKEN=your-github-token-here

# JIRA — reuses the same box vars the agent already uses for JIRA REST calls.
# Consumed by the `sooperset/mcp-atlassian` server, run as a throwaway
# `docker run --rm -i` container per session (see src/agent.ts). Requires
# Docker available on PATH. The image tag is pinned in code
# (MCP_ATLASSIAN_IMAGE_TAG in src/agent.ts) — NOT `latest` (supply-chain) —
# currently a TODO placeholder pending a verified release tag from
# https://github.com/sooperset/mcp-atlassian/pkgs/container/mcp-atlassian.
JIRA_BASE_URL=https://your-instance.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token-here
