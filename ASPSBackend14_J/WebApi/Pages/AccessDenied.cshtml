@page
@model WebApi.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied - ASPS Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root { --navy: #1A2255; --danger: #ef4444; }
        body { font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #f0f2f8 0%, #e5e7ef 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card { border: none; border-radius: 24px; box-shadow: 0 8px 40px rgba(26,34,85,.12); max-width: 450px; }
        .icon-wrapper { width: 80px; height: 80px; border-radius: 50%; background: rgba(239,68,68,.1); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; }
        .icon-wrapper i { font-size: 36px; color: var(--danger); }
        h1 { font-family: 'Syne', sans-serif; font-weight: 800; color: var(--navy); }
    </style>
</head>
<body>
    <div class="card p-5 text-center">
        <div class="icon-wrapper">
            <i class="fas fa-shield-halved"></i>
        </div>
        <h1 class="mb-3">Access Denied</h1>
        <p class="text-muted mb-4">
            You don't have permission to access the ASPS Admin panel.<br>
            Only members of the <strong>Administrators</strong> group can access this area.
        </p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <p class="small text-muted mb-4">
                Logged in as: <strong>@(User.FindFirst("preferred_username")?.Value ?? User.Identity.Name)</strong>
            </p>
            <a href="/Logout" class="btn btn-outline-danger">
                <i class="fas fa-sign-out-alt me-2"></i>Sign out and try another account
            </a>
        }
        else
        {
            <a href="/Login" class="btn btn-primary">
                <i class="fas fa-sign-in-alt me-2"></i>Sign in
            </a>
        }
    </div>
</body>
</html>
