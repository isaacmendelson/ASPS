    #region AlertFlagRepository Tests

    public class AlertFlagRepositoryTests : IDisposable
    {
        private readonly AppDbContext _context;
        private readonly AlertFlagRepository _sut;

        public AlertFlagRepositoryTests()
        {
            var options = new DbContextOptionsBuilder<AppDbContext>()
                .UseInMemoryDatabase(databaseName: Guid.NewGuid().ToString())
                .Options;

            _context = new AppDbContext(options);
            _sut = new AlertFlagRepository(_context);
        }

        [Fact]
        public async Task AddAsync_SetsCreatedAndModifiedTimestamps()
        {
            // Arrange
            var flag = new AlertFlag { UserKey = 1, Status = AlertFlagStatus.Open };

            // Act
            var result = await _sut.AddAsync(flag);

            // Assert
            result.Created.Should().BeCloseTo(DateTime.UtcNow, TimeSpan.FromSeconds(5));
            result.Modified.Should().BeCloseTo(DateTime.UtcNow, TimeSpan.FromSeconds(5));
        }

        [Fact]
        public async Task GetOpenFlagsByUserAsync_ReturnsOnlyOpenFlags()
        {
            // Arrange
            await _context.AlertFlags.AddRangeAsync(
                new AlertFlag { UserKey = 1, Status = AlertFlagStatus.Open, IsDeleted = false, Created = DateTime.UtcNow, Modified = DateTime.UtcNow },
                new AlertFlag { UserKey = 1, Status = AlertFlagStatus.Closed, IsDeleted = false, Created = DateTime.UtcNow, Modified = DateTime.UtcNow },
                new AlertFlag { UserKey = 2, Status = AlertFlagStatus.Open, IsDeleted = false, Created = DateTime.UtcNow, Modified = DateTime.UtcNow }
            );
            await _context.SaveChangesAsync();

            // Act
            var result = await _sut.GetOpenFlagsByUserAsync(1);

            // Assert
            result.Should().HaveCount(1);
            result.Should().OnlyContain(f => f.UserKey == 1 && f.Status == AlertFlagStatus.Open);
        }

        [Fact]
        public async Task CloseFlag_UpdatesStatusToClosed()
        {
            // Arrange
            var flag = new AlertFlag
            {
                UserKey = 1,
                Status = AlertFlagStatus.Open,
                Created = DateTime.UtcNow,
                Modified = DateTime.UtcNow
            };
            await _context.AlertFlags.AddAsync(flag);
            await _context.SaveChangesAsync();

            // Act
            await _sut.CloseFlag(flag.Key);

            // Assert
            var updated = await _context.AlertFlags.FindAsync(flag.Key);
            updated.Status.Should().Be(AlertFlagStatus.Closed);
            updated.Modified.Should().BeAfter(updated.Created);
        }

        public void Dispose()
        {
            _context.Database.EnsureDeleted();
            _context.Dispose();
        }
    }

    #endregion
}
