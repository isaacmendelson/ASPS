@page
@model WebApi.Pages.DeviceAlerts.IndexModel
@{
    ViewData["Title"] = "Device Alerts";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Device Alerts</h1>
    <div class="btn-group">
        <a href="?hours=1@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")" class="btn btn-sm @(Model.TimeFilter == 1 ? "btn-primary" : "btn-outline-primary")">Last Hour</a>
        <a href="?hours=24@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")" class="btn btn-sm @(Model.TimeFilter == 24 ? "btn-primary" : "btn-outline-primary")">Last 24h</a>
        <a href="?hours=168@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")" class="btn btn-sm @(Model.TimeFilter == 168 ? "btn-primary" : "btn-outline-primary")">Last Week</a>
        <a href="?hours=720@(string.IsNullOrEmpty(Model.Search) ? "" : $"&search={Uri.EscapeDataString(Model.Search)}")" class="btn btn-sm @(Model.TimeFilter == 720 ? "btn-primary" : "btn-outline-primary")">Last Month</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">
            Alerts from Last @Model.TimeFilter Hours (@Model.AlertsWithInfo.Count)
        </h6>
        <form method="get" class="d-flex" style="max-width: 400px;">
            <input type="hidden" name="hours" value="@Model.TimeFilter" />
            <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm me-2" placeholder="Search type, device UID..." />
            <button type="submit" class="btn btn-sm btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a href="/DeviceAlerts?hours=@Model.TimeFilter" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            }
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="alertsTable">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>Type</th>
                        <th>Priority</th>
                        <th>User</th>
                        <th>Device UID</th>
                        <th>Device Type</th>
                        <th>OS</th>
                        <th>IP Address</th>
                        <th>Details</th>
                        <th>Key</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.AlertsWithInfo)
                    {
                        var alert = item.Alert;
                        <tr>
                            <td>@alert.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                @if (alert.AlertType.Contains("TrackUrl", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-info"><i class="fas fa-clock"></i> Track URL</span>
                                }
                                else if (alert.AlertType.Contains("Url", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-warning"><i class="fas fa-link"></i> URL Alert</span>
                                }
                                else if (alert.AlertType.Contains("RemoteAccess", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-danger"><i class="fas fa-desktop"></i> Remote Access</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">@alert.AlertType</span>
                                }
                            </td>
                            <td>
                                @switch (alert.Priority)
                                {
                                    case Common.Enums.Priority.Critical:
                                        <span class="badge bg-danger">Critical</span>
                                        break;
                                    case Common.Enums.Priority.High:
                                        <span class="badge bg-warning">High</span>
                                        break;
                                    case Common.Enums.Priority.Medium:
                                        <span class="badge bg-info">Medium</span>
                                        break;
                                    case Common.Enums.Priority.Low:
                                        <span class="badge bg-secondary">Low</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@alert.Priority</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.UserName))
                                {
                                    <a href="/Users/Details?key=@alert.UserKeyField" class="text-primary" style="cursor: pointer; text-decoration: underline;">
                                        @item.UserName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Unknown</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(alert.DeviceKeyField))
                                {
                                    <a href="/Devices/Details?key=@alert.DeviceKeyField" class="text-primary" style="cursor: pointer;">
                                        <code>@alert.DeviceUid</code>
                                    </a>
                                }
                                else if (!string.IsNullOrEmpty(alert.DeviceUid))
                                {
                                    <a href="/Devices/Details?uid=@Uri.EscapeDataString(alert.DeviceUid)" class="text-primary" style="cursor: pointer;">
                                        <code>@alert.DeviceUid</code>
                                    </a>
                                }
                                else
                                {
                                    <code>@alert.DeviceUid</code>
                                }
                            </td>
                            <td>
                                @if (alert.DeviceType == Common.Enums.DeviceType.MobilePhone)
                                {
                                    <span class="badge bg-primary"><i class="fas fa-mobile-alt"></i> Phone</span>
                                }
                                else if (alert.DeviceType == Common.Enums.DeviceType.PersonalComputer)
                                {
                                    <span class="badge bg-info"><i class="fas fa-desktop"></i> PC</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@alert.DeviceType</span>
                                }
                            </td>
                            <td>@alert.OperatingSystem</td>
                            <td>
                                @if (!string.IsNullOrEmpty(alert.IPAddress))
                                {
                                    <code>@alert.IPAddress</code>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (alert is Common.Entities.TrackUrlAlertEntity trackAlert)
                                {
                                    var tooltipText = $"Url: {trackAlert.Url}&#10;From Url: {trackAlert.FromUrl}&#10;Time on page: {trackAlert.Duration} seconds";
                                    <small class="text-truncate d-inline-block" style="max-width: 200px;" title="@tooltipText">
                                        @trackAlert.Url
                                    </small>
                                }
                                else if (alert is Common.Entities.UrlAlertEntity urlAlert)
                                {
                                    <small class="text-truncate d-inline-block" style="max-width: 200px;" title="@urlAlert.Url">
                                        @urlAlert.Url
                                    </small>
                                }
                                else if (alert is Common.Entities.RemoteAccessAlertEntity raAlert)
                                {
                                    <small>@raAlert.RemoteAccessApp — @raAlert.SessionStatus</small>
                                }
                            </td>
                            <td><small><code>@alert.KeyField</code></small></td>
                            <td>
                                <a href="/DeviceAlerts/Details?key=@alert.KeyField" class="btn btn-sm btn-primary">
                                    <i class="fas fa-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">

<script>
    $(document).ready(function() {
        $('#alertsTable').DataTable({
            order: [[0, 'desc']],
            pageLength: 25
        });
    });
</script>
}
