<!-- Features for Individuals -->
<section id="individuals" class="section section-light">
  <div class="container">
    <div class="section-header center">
      <span class="section-label purple">Personal protection</span>
      <h2 class="section-title">Protection that fits your life.</h2>
      <p class="section-subtitle">Whether you're tech-savvy or not, ASPS provides simple, effective protection against the scams targeting you every day.</p>
    </div>
    
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">📞</div>
        <h3>הגנה על שיחות</h3>
        <p>Get real-time alerts during suspicious calls. AI detects voice cloning, impersonation, and manipulation tactics before you make a decision.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">💬</div>
        <h3>סינון הודעות</h3>
        <p>Automatic scanning of texts and messages for phishing links, scam patterns, and suspicious requests for money or information.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">📧</div>
        <h3>הגנה על מיילים</h3>
        <p>Identify spoofed senders, malicious attachments, and social engineering attempts in your inbox before you click.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">🌐</div>
        <h3>גלישה בטוחה</h3>
        <p>Real-time warnings about fake websites, phishing pages, and malicious downloads while you browse.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">🔔</div>
        <h3>Alertes intelligentes</h3>
        <p>Non-intrusive notifications that explain exactly why something is suspicious, helping you make informed decisions.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">📱</div>
        <h3>All your devices</h3>
        <p>Seamless protection across your phone, tablet, and computer. One account protects everything.</p>
      </div>
    </div>
  </div>
</section>

<!-- Family Protection -->
