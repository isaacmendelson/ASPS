@page
@model WebApi.Pages.SystemConfigurations.IndexModel
@{
    ViewData["Title"] = "System Configuration";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">System Configuration</h1>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">ASView Management</h6>
    </div>
    <div class="card-body">
        <p class="text-muted">Re-initialize the ASView to reload all cached data from the database.</p>
        <form method="post">
            <button type="submit" asp-page-handler="InitializeASView" class="btn btn-primary">
                <i class="fas fa-sync-alt"></i> Initialize ASView
            </button>
        </form>
    </div>
</div>
