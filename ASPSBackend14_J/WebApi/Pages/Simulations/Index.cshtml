@page
@model WebApi.Pages.Simulations.IndexModel
@{
    ViewData["Title"] = "Simulations";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-vial"></i> Device Alert Simulations</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a href="/Simulations/Create" class="btn btn-sm btn-primary">
            <i class="fas fa-plus"></i> New Simulation
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">All Simulations (@Model.Simulations.Count)</h6>
        <form method="get" class="d-flex" style="max-width: 400px;">
            <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm me-2" placeholder="Search name or description..." />
            <button type="submit" class="btn btn-sm btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a href="/Simulations" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            }
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="simulationsTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Creator</th>
                        <th>Steps</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var simulation in Model.Simulations)
                    {
                        int stepCount = 0;
                        if (!string.IsNullOrEmpty(simulation.SimulationStepsJson))
                        {
                            try
                            {
                                var steps = System.Text.Json.JsonSerializer.Deserialize<Common.Models.SimulationStep[]>(simulation.SimulationStepsJson);
                                stepCount = steps?.Length ?? 0;
                            }
                            catch { /* ignore parsing errors */ }
                        }

                        <tr>
                            <td>
                                <strong>@simulation.Name</strong>
                            </td>
                            <td>
                                <small class="text-muted">@simulation.Description</small>
                            </td>
                            <td>
                                <span class="badge bg-info">@simulation.CreatorKeyField</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@stepCount steps</span>
                            </td>
                            <td>
                                <small>@simulation.DateCreated.ToString("yyyy-MM-dd HH:mm")</small>
                            </td>
                            <td class="table-actions">
                                <form method="post" class="d-inline" asp-page-handler="Run" asp-route-simulationKey="@simulation.KeyField" 
                                      onsubmit="return confirm('Are you sure you want to run this simulation?');">
                                    <button type="submit" class="btn btn-sm btn-success" title="Run Simulation">
                                        <i class="fas fa-play"></i> Run
                                    </button>
                                </form>
                                
                                <a href="/Simulations/Edit?key=@simulation.KeyField" class="btn btn-sm btn-primary" title="Edit">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                
                                <form method="post" class="d-inline" asp-page-handler="Delete" asp-route-simulationKey="@simulation.KeyField" 
                                      onsubmit="return confirm('Are you sure you want to delete this simulation?');">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                        <i class="fas fa-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    
                    @if (Model.Simulations.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fas fa-info-circle"></i> No simulations found.
                                @if (!string.IsNullOrEmpty(Model.Search))
                                {
                                    <a href="/Simulations">Clear search</a>
                                }
                                else
                                {
                                    <a href="/Simulations/Create">Create your first simulation</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">

<script>
    $(document).ready(function() {
        $('#simulationsTable').DataTable({
            order: [[4, 'desc']], // Sort by created date descending
            pageLength: 25,
            columnDefs: [
                { orderable: false, targets: 5 } // Disable sorting on Actions column
            ]
        });
    });
</script>
}
