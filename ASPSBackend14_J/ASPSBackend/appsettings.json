{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Business": "Debug",
      "ASPSBackend": "Debug"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "NetMQ": {
    "BusinessEndpoint": "tcp://*:5555",
    "RealTimeListenerPort": 50001,
    "RealTimeListenerMode": "Router",
    "NotificationPublisherPort": 50002
  },
  "Python": {
    "ExecutablePath": "python",
    "AnalyzersFolderPath": ""
  },
  "Analysis": {
    "DeviceAlertExpiryDays": 30,
    "DeviceAlertDeletionDays": 90,
    "SeverityScoreThresholdCritical": 80,
    "SeverityScoreThresholdHigh": 60,
    "SeverityScoreThresholdMedium": 30,
    "CacheEnabled": true,
    "TrackedDomains": {
      "TrackTypeForRiskScoreCritical": 2,
      "TrackTypeForRiskScoreHigh": 1,
      "TrackTypeForRiskScoreMedium": 0
    }
  },
  "TokenManagement": {
    "TokenExpirationPeriod": 1440,
    "MaxExpiration": 10080
  },
  "Security": {
    "CurveEnabled": true,
    "KeysFilePath": ""
  },
  "RemoteAccess": {
    "BrowserTabsMode": "Always"
  },
  "TrackUrl": {
    "RiskThresholdToEnableTracking": 60,
    "TrackingDurationMinutes": 1440000
  }
}
