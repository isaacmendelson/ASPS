# ASPS Telegram CEO bot VPS — provisioning configuration (ASPS-740 / ASPS-741)
#
# Copy this file to `config.env` (same directory) and fill in real values
# before running 01-harden.sh / 02-toolchain.sh. `config.env` is gitignored —
# NEVER commit it with a real SSH key or real hostname/IP if that matters to you.
#
# Both scripts source this file. Nothing in this file is a secret by itself
# (an SSH *public* key is not sensitive), but keep the real file out of git
# anyway since it may accumulate box-specific values over time.

# ---------------------------------------------------------------------------
# SSH / OS user
# ---------------------------------------------------------------------------

# Non-root sudo user created by 01-harden.sh. All ASPS work (bot, repo clone,
# builds) runs as this user, never as root.
ASPSBOT_USER="aspsbot"

# REQUIRED — the SSH public key (single line, e.g. contents of
# id_ed25519.pub) that will be installed into
# /home/${ASPSBOT_USER}/.ssh/authorized_keys. This is the ONLY way in once
# password auth and root login are disabled — do not leave this blank.
ASPSBOT_SSH_PUBLIC_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... your-key-here user@host"

# Lock the root account's password (passwd -l root) IN ADDITION to
# PermitRootLogin no. OFF by default (ASPS-740 security remediation, was
# unconditional before — a review found it could leave the box with NO
# path to root: PermitRootLogin no already blocks root over SSH
# regardless of this setting, and aspsbot is created with no password
# (set manually by the operator on first login), so locking root before
# that happens = root locked AND sudo unusable = provider-rescue-only
# lockout. 01-harden.sh only actually locks root when LOCK_ROOT=true AND
# aspsbot already has a usable password (passwd -S shows "P") — otherwise
# it skips the lock with a loud warning, it never lets the box end up
# with no root path. Set to true once you've set an aspsbot password and
# confirmed `sudo -v` works as aspsbot, if you want the extra lock.
LOCK_ROOT=false

# SSH port. Default is the STANDARD port 22 (ASPS-740 security remediation
# — changed from a non-default 2222). Rationale: 01-harden.sh already
# handles Ubuntu 24.04's ssh.socket activation and asserts sshd is
# actually listening on SSH_PORT before it opens UFW, so a custom port is
# SAFE with respect to this script — but the box almost always also sits
# behind Hostinger's own cloud-level firewall/security group (separate
# from UFW, configured in Hostinger's panel, NOT by these scripts). If you
# set SSH_PORT to anything other than 22 here, you MUST also open that
# port in Hostinger's cloud firewall yourself, or you will be locked out
# even though UFW and sshd are both configured correctly. 22 is the safe
# default precisely because it avoids that extra, easy-to-forget step. A
# non-default port is still supported and is mostly cosmetic (cuts
# mass-scan log noise) — key-only auth + UFW + fail2ban are the real
# controls either way.
SSH_PORT=22

# ---------------------------------------------------------------------------
# Host
# ---------------------------------------------------------------------------

# Set to your own zone if different (see `timedatectl list-timezones`).
TIMEZONE="Asia/Jerusalem"

HOSTNAME_FQDN="asps-ceo-vps"

# Swap file size in GiB. 2G is the floor recommended for .NET/Docker builds
# on a 4 GB box (ASPS-740 spec default). Bump to 4 if the box has <4 GB RAM
# and Phase 4's D4 (agent builds/tests ASPS locally) is in active use.
SWAP_SIZE_GB=2

# ---------------------------------------------------------------------------
# Repo (used by Phase 3, not by 01/02 — kept here so all VPS config lives in
# one file; 02-toolchain.sh does not clone anything, this is documentation
# for the operator and for the Phase 3 script when it is authored)
# ---------------------------------------------------------------------------

REPO_URL="git@github.com:isaacmendelson/ASPS.git"
CLONE_PATH="/home/aspsbot/ASPS"

# Directory OUTSIDE the repo clone where secrets live (ACCESS_KEYS.env, the
# bot's own .env, the systemd EnvironmentFile). Per ASPS-745 box-level item
# (1): secrets must never live inside CLONE_PATH, so a path-guard bypass or
# an over-broad agent Read/Glob can never reach them by construction. See
# README.md "Secret placement" section. 01-harden.sh creates this directory
# (mode 700, owned by ASPSBOT_USER) but does not populate it — Phase 3/5 do.
SECRETS_DIR="/home/aspsbot/secrets"
