# =============================================================================
# Comprehensive .gitignore for ASPS Project
# Covers: Python, .NET, Node.js, IDE, OS, and project-specific artifacts
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Jupyter
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# .NET / C#
# -----------------------------------------------------------------------------
bin/
obj/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
publish/
[Dd]ebug/
[Rr]elease/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet
*.nupkg
packages/
!packages/build/

# -----------------------------------------------------------------------------
# Node.js
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn-integrity
.next/
out/

# -----------------------------------------------------------------------------
# IDEs and Editors
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/

# -----------------------------------------------------------------------------
# OS Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
nul

# -----------------------------------------------------------------------------
# Project-specific
# -----------------------------------------------------------------------------
# Duplicate/archive ZIPs
*.zip

# Test artifacts
test_result.*

# Cache directories
cache/
.cache/

# Log files
*.log

# Environment files (secrets)
.env
.env.local
.env.*.local

# Database dumps (large files - track intentionally if needed)
# Note: *.sql is NOT ignored - database dumps may be intentional

# Temporary scripts
_cleanup_*.ps1
_verify_*.ps1
_check_*.ps1
