{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5001"
      },
      "Https": {
        "Url": "https://0.0.0.0:5002"
      }
    }
  },
  "CQRS": {
    "Endpoint": "tcp://localhost:5556"
  },
  "NetMQ": {
    "BusinessEndpoint": "tcp://localhost:5555",
    "AlertListenerEndpoint": "tcp://localhost:50001"
  },
  "Security": {
    "CurveEnabled": true
  },
  "TrackUrl": {
    "RiskThresholdToEnableTracking": 40,
    "TrackingDurationMinutes": 30
  }
}
