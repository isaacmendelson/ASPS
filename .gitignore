# =============================================================================
# Comprehensive .gitignore for ASPS Project
# Covers: Python, .NET, Node.js, IDE, OS, and project-specific artifacts
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Jupyter
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# .NET / C#
# -----------------------------------------------------------------------------
bin/
obj/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
publish/
[Dd]ebug/
[Rr]elease/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet
*.nupkg
packages/
!packages/build/

# -----------------------------------------------------------------------------
# Node.js
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn-integrity
.next/
out/

# -----------------------------------------------------------------------------
# IDEs and Editors
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/

# -----------------------------------------------------------------------------
# OS Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
nul

# -----------------------------------------------------------------------------
# Project-specific
# -----------------------------------------------------------------------------
# Duplicate/archive ZIPs
*.zip

# Test artifacts
test_result.*

# Cache directories
cache/
.cache/

# Log files
*.log

# Environment files (secrets)
.env
.env.local
.env.*.local
/ACCESS_KEYS.env
appsettings.Docker.json

# Database seed dumps (too large for GitHub's 100 MB limit)
aspsbackend2db_*.sql

# Temporary scripts
_cleanup_*.ps1
_verify_*.ps1
_check_*.ps1

# Claude Code — the hat/team working system IS tracked (charter, agent
# definitions, per-role memory). Only truly-local/transient files are ignored.
.claude/settings.local.json
.claude/scheduled_tasks.lock
#.planning/

# -----------------------------------------------------------------------------
# ASP.NET Core secrets — never commit environment-specific settings
# -----------------------------------------------------------------------------
appsettings.Production.json
appsettings.Staging.json
appsettings.*.local.json

# CURVE key files (generated at runtime)
curve-server-keys.json
curve-server-public-key.txt
*.curve-keys.json

# Local-only inbox for imported memory/insights from other projects
_inbox/
/Website/NIU
