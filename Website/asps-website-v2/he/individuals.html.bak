<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<link rel="icon" href="../favicon.svg" type="image/svg+xml"/>
<meta name="description" content="ASPS for individuals and families — real-time AI protection against scam calls, messages and impersonation. Built for the people most often targeted."/>
<title>For Individuals &amp; Families · ASPS</title>
<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,16..72,400;0,16..72,500;0,16..72,600;0,16..72,700;1,16..72,400;1,16..72,500;1,16..72,600&family=Syne:wght@700;800&display=swap" rel="stylesheet"/>
<style>
:root{
  --bg-dark:#070B14; --bg-paper:#FAF7F2; --bg-paper-2:#F3EFE8;
  --accent:#BE3A4B; --accent-strong:#8E1A2A;
  --ink:#1A1814; --ink-2:#4A4640; --ink-3:#6B655C;
  --rule:#E4DDD2; --rule-2:#D7CFC2;
  --font-body:'Instrument Sans',-apple-system,sans-serif;
  --font-serif:'Newsreader',Georgia,serif;
  --font-display:'Syne',Georgia,serif;
  --transition:0.25s cubic-bezier(0.4,0,0.2,1);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font-body);background:var(--bg-paper);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer}
.container{max-width:1200px;margin:0 auto;padding:0 24px}
@media(min-width:768px){.container{padding:0 40px}}
@media(min-width:1024px){.container{padding:0 60px}}

/* NAV */
.nav{position:sticky;top:0;z-index:1000;height:72px;background:rgba(15,18,56,0.97);backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,0.08)}
.nav-inner{max-width:1400px;margin:0 auto;padding:0 40px;height:100%;display:flex;align-items:center;justify-content:space-between;gap:32px}
.nav-logo{display:flex;align-items:center;flex-shrink:0}
.nav-links{display:none;align-items:center;gap:8px}
@media(min-width:1024px){.nav-links{display:flex}}
.nav-link{padding:8px 16px;font-size:.875rem;font-weight:500;color:#94A3B8;border-radius:8px;transition:var(--transition)}
.nav-link:hover{color:#fff;background:rgba(255,255,255,0.05)}
.nav-link.active{color:#fff;position:relative}
.nav-link.active::after{content:'';position:absolute;left:16px;right:16px;bottom:0;height:2px;background:var(--accent)}
.nav-actions{display:flex;align-items:center;gap:12px}
.nav-btn{padding:10px 20px;font-size:.875rem;font-weight:600;border-radius:8px;transition:var(--transition);border:none}
.nav-btn-ghost{background:transparent;color:#94A3B8;border:1px solid rgba(255,255,255,0.12)}
.nav-btn-ghost:hover{color:#fff;border-color:rgba(255,255,255,0.25)}
.nav-btn-primary{background:#fff;color:#0F1238}
.nav-btn-primary:hover{background:#EEF0FF}
.lang-dropdown{position:relative}
.lang-dropdown-btn{display:flex;align-items:center;gap:6px;padding:8px 12px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:8px;color:#E2E8F0;font-size:.8125rem;font-weight:600;cursor:pointer;transition:var(--transition)}
.lang-dropdown-btn:hover{background:rgba(255,255,255,0.1)}
.lang-dropdown-menu{position:absolute;top:calc(100% + 8px);right:0;min-width:140px;padding:8px 0;background:#0F1238;border:1px solid rgba(255,255,255,0.12);border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.3);opacity:0;visibility:hidden;transform:translateY(-8px);transition:var(--transition);z-index:100}
.lang-dropdown:hover .lang-dropdown-menu,.lang-dropdown:focus-within .lang-dropdown-menu{opacity:1;visibility:visible;transform:translateY(0)}
.lang-option{display:block;padding:10px 16px;font-size:.875rem;color:#94A3B8;transition:var(--transition)}
.lang-option:hover{background:rgba(255,255,255,0.05);color:#fff}
.lang-option.active{color:var(--accent);font-weight:600}

/* Shared typography */
.section-eyebrow{display:inline-flex;align-items:center;gap:14px;margin-bottom:18px;font-family:var(--font-display);font-weight:700;font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)}
.section-eyebrow.with-rule::before{content:'';width:32px;height:1px;background:var(--accent);opacity:.5}
.section-title{font-family:var(--font-serif);font-weight:500;font-size:clamp(2rem,4vw,3rem);line-height:1.05;letter-spacing:-.025em;color:var(--ink)}
.section-title .em{font-style:italic;font-weight:500;color:var(--accent-strong)}
.btn{display:inline-flex;align-items:center;gap:10px;padding:14px 28px;font-family:var(--font-display);font-size:.84rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;border-radius:4px;border:none;transition:var(--transition);cursor:pointer}
.btn-accent{background:var(--accent);color:#fff}
.btn-accent:hover{background:var(--accent-strong)}
.btn-ink{background:transparent;color:var(--ink);border:1px solid var(--rule-2)}
.btn-ink:hover{border-color:var(--ink)}
.btn-ghost{background:transparent;color:#F5F0E7;border:1px solid rgba(245,240,231,0.25)}
.btn-ghost:hover{border-color:rgba(245,240,231,0.55)}

/* HERO */
.hero{padding:100px 0 80px;background:var(--bg-paper);border-bottom:1px solid var(--rule)}
.hero-grid{display:grid;grid-template-columns:1fr;gap:64px;align-items:center}
@media(min-width:1024px){.hero-grid{grid-template-columns:1.2fr 1fr;gap:80px}}
.hero-title{font-family:var(--font-serif);font-weight:500;font-style:italic;font-size:clamp(2.5rem,5.5vw,4.4rem);line-height:1.05;letter-spacing:-.025em;color:var(--ink);margin-bottom:28px}
.hero-title .em{font-style:normal;font-weight:600;color:var(--accent-strong)}
.hero-lede{font-family:var(--font-serif);font-size:1.1875rem;line-height:1.65;color:var(--ink-2);margin-bottom:36px;max-width:540px}
.hero-cta{display:flex;flex-wrap:wrap;gap:14px}

/* Phone mock card */
.phone-card{background:#fff;border:1px solid var(--rule);padding:24px 22px 22px;position:relative;box-shadow:0 1px 0 var(--rule),0 24px 60px -28px rgba(26,24,20,.25);max-width:380px;margin:0 auto}
.phone-card::before{content:'';position:absolute;top:-1px;left:-1px;right:-1px;height:4px;background:var(--accent)}
.phone-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:14px;margin-bottom:18px;border-bottom:1px solid var(--rule);font-family:var(--font-display);font-weight:700;font-size:.66rem;letter-spacing:.18em;text-transform:uppercase}
.phone-head .live{display:flex;align-items:center;gap:8px;color:var(--accent)}
.phone-head .dot{width:8px;height:8px;border-radius:50%;background:var(--accent);animation:dotPulse 1.6s ease-in-out infinite}
@keyframes dotPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.3)}}
.phone-head .time{color:var(--ink-3);font-weight:600}
.phone-caller{font-family:var(--font-display);font-size:.7rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);margin-bottom:6px}
.phone-name{font-family:var(--font-serif);font-weight:600;font-size:1.5rem;color:var(--ink);margin-bottom:18px;padding-bottom:18px;border-bottom:1px dashed var(--rule-2)}
.phone-verdict{font-family:var(--font-serif);font-style:italic;font-size:1.125rem;line-height:1.45;color:var(--ink);margin-bottom:20px}
.phone-verdict strong{font-style:normal;color:var(--accent-strong);font-weight:600}
.phone-bits{display:grid;grid-template-columns:auto 1fr;gap:10px 14px;font-size:.86rem;margin-bottom:20px}
.phone-bits dt{font-family:var(--font-display);font-size:.62rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);padding-top:3px}
.phone-bits dd{color:var(--ink);line-height:1.45}
.phone-bits dd strong{color:var(--accent-strong);font-weight:600}
.phone-actions{display:flex;gap:10px}
.phone-btn{flex:1;padding:11px 12px;font-family:var(--font-display);font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;border:1px solid var(--rule-2);background:transparent;color:var(--ink);cursor:pointer}
.phone-btn.primary{background:var(--accent);color:#fff;border-color:var(--accent)}

/* WHO IS THIS FOR — split */
.who{padding:100px 0;background:var(--bg-paper)}
.who-grid{display:grid;grid-template-columns:1fr;gap:56px}
@media(min-width:900px){.who-grid{grid-template-columns:5fr 7fr;gap:96px}}
.who-meta{position:sticky;top:100px;align-self:start}
.who-meta .section-title{margin-bottom:20px}
.who-meta-note{font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3);padding-top:18px;border-top:1px solid var(--rule);margin-top:24px}
.who-body p{font-family:var(--font-serif);font-size:1.1875rem;line-height:1.6;color:var(--ink);margin-bottom:24px}
.who-body p.lead{font-size:1.5rem;line-height:1.4;font-weight:500;padding-bottom:32px;margin-bottom:32px;border-bottom:1px solid var(--rule)}
.who-body em{font-style:normal;color:var(--accent-strong);font-weight:600}

/* AUDIENCE — two doors */
.doors{padding:110px 0;background:var(--bg-paper-2);border-top:1px solid var(--rule-2);border-bottom:1px solid var(--rule-2)}
.doors-head{max-width:720px;margin-bottom:56px}
.doors-head p{margin-top:16px;font-family:var(--font-serif);font-size:1.125rem;line-height:1.65;color:var(--ink-2)}
.doors-grid{display:grid;grid-template-columns:1fr;gap:32px}
@media(min-width:900px){.doors-grid{grid-template-columns:1fr 1fr;gap:40px}}
.door{background:#fff;border:1px solid var(--rule);padding:40px 36px 36px;position:relative;display:flex;flex-direction:column}
.door::before{content:'';position:absolute;top:-1px;left:-1px;right:-1px;height:3px;background:var(--accent)}
.door-tag{font-family:var(--font-display);font-weight:700;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin-bottom:18px}
.door h3{font-family:var(--font-serif);font-weight:500;font-style:italic;font-size:2rem;line-height:1.1;color:var(--ink);margin-bottom:16px;letter-spacing:-.01em}
.door h3 .em{font-style:normal;font-weight:600;color:var(--accent-strong)}
.door-lede{font-family:var(--font-serif);font-size:1.0625rem;line-height:1.6;color:var(--ink-2);margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid var(--rule)}
.door-list{list-style:none;display:flex;flex-direction:column;gap:12px;margin-bottom:28px}
.door-list li{font-size:.95rem;color:var(--ink);padding-left:20px;position:relative;line-height:1.55}
.door-list li::before{content:'';position:absolute;left:0;top:.65em;width:10px;height:1px;background:var(--accent)}
.door-list li strong{color:var(--accent-strong);font-weight:600}
.door-foot{margin-top:auto;padding-top:20px;border-top:1px dashed var(--rule-2);font-family:var(--font-display);font-size:.68rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3);display:flex;justify-content:space-between;align-items:center;gap:14px}
.door-foot a{color:var(--accent);transition:var(--transition)}
.door-foot a:hover{color:var(--accent-strong)}
.door-foot a::after{content:' →';font-family:var(--font-body)}

/* PROTECTS — channels (dark band) */
.protects{background:var(--ink);color:#F5F0E7;padding:110px 0;position:relative;overflow:hidden}
.protects::before{content:'';position:absolute;inset:0;background-image:radial-gradient(circle at 20% 30%,rgba(190,58,75,.18),transparent 50%),radial-gradient(circle at 80% 80%,rgba(190,58,75,.10),transparent 50%);pointer-events:none}
.protects-inner{position:relative;max-width:1320px;margin:0 auto;padding:0 40px}
.protects-head{display:flex;align-items:flex-end;justify-content:space-between;gap:40px;margin-bottom:56px;padding-bottom:24px;border-bottom:1px solid rgba(245,240,231,0.12);flex-wrap:wrap}
.protects-head .section-title{color:#fff;max-width:640px}
.protects-head-meta{font-family:var(--font-display);font-weight:700;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:#A19888;padding-bottom:6px}
.protects-grid{display:grid;grid-template-columns:1fr}
@media(min-width:700px){.protects-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1024px){.protects-grid{grid-template-columns:repeat(4,1fr)}}
.protect{padding:36px 28px 36px 0;border-top:1px solid rgba(245,240,231,0.12)}
@media(min-width:1024px){.protect{padding:0 32px;border-top:none}.protect+.protect{border-left:1px solid rgba(245,240,231,0.12)}.protect:first-child{padding-left:0}}
.protect-tag{font-family:var(--font-display);font-weight:700;font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);margin-bottom:14px}
.protect-title{font-family:var(--font-serif);font-weight:600;font-size:1.5rem;line-height:1.2;color:#fff;margin-bottom:12px}
.protect-body{font-family:var(--font-serif);font-size:1rem;line-height:1.6;color:#D6CDBE}

/* HOW IT FEELS — three vignettes */
.feel{padding:110px 0;background:var(--bg-paper);border-bottom:1px solid var(--rule)}
.feel-head{max-width:720px;margin-bottom:56px}
.feel-head p{margin-top:16px;font-family:var(--font-serif);font-size:1.125rem;line-height:1.65;color:var(--ink-2)}
.feel-grid{display:grid;grid-template-columns:1fr;gap:0;border-top:1px solid var(--rule)}
.feel-row{display:grid;grid-template-columns:1fr;gap:18px;padding:36px 0;border-bottom:1px solid var(--rule)}
@media(min-width:800px){.feel-row{grid-template-columns:80px 220px 1fr;gap:40px;align-items:start}}
.feel-num{font-family:var(--font-display);font-weight:700;font-size:.78rem;letter-spacing:.16em;color:var(--accent);padding-top:4px}
.feel-num::before{content:'01 /';margin-right:4px}
.feel-row:nth-child(2) .feel-num::before{content:'02 /'}
.feel-row:nth-child(3) .feel-num::before{content:'03 /'}
.feel-when{font-family:var(--font-display);font-weight:700;font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3)}
.feel-row h3{font-family:var(--font-serif);font-weight:500;font-style:italic;font-size:1.5rem;line-height:1.2;color:var(--ink);margin-bottom:10px}
.feel-row h3 .em{font-style:normal;font-weight:600;color:var(--accent-strong)}
.feel-row p{font-family:var(--font-serif);font-size:1.0625rem;line-height:1.6;color:var(--ink-2)}
.feel-row p+p{margin-top:10px;color:var(--ink-3);font-size:.95rem;font-family:var(--font-body);line-height:1.55}

/* PRICING */
.pricing{padding:110px 0;background:var(--bg-paper-2);border-top:1px solid var(--rule-2);border-bottom:1px solid var(--rule-2)}
.pricing-head{display:flex;align-items:flex-end;justify-content:space-between;gap:40px;margin-bottom:48px;padding-bottom:24px;border-bottom:1px solid var(--rule);flex-wrap:wrap}
.pricing-head-meta{font-family:var(--font-display);font-weight:700;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-3);padding-bottom:6px}
.tiers{display:grid;grid-template-columns:1fr;gap:24px}
@media(min-width:800px){.tiers{grid-template-columns:repeat(3,1fr)}}
.tier{background:#fff;border:1px solid var(--rule);padding:32px 28px 32px;position:relative;display:flex;flex-direction:column}
.tier.featured{border-color:var(--accent);box-shadow:0 24px 60px -28px rgba(190,58,75,.25)}
.tier.featured::before{content:'';position:absolute;top:-1px;left:-1px;right:-1px;height:3px;background:var(--accent)}
.tier-flag{position:absolute;top:-12px;left:24px;padding:5px 10px;background:var(--accent);color:#fff;font-family:var(--font-display);font-weight:700;font-size:.62rem;letter-spacing:.16em;text-transform:uppercase}
.tier-name{font-family:var(--font-display);font-weight:700;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin-bottom:14px}
.tier-price{font-family:var(--font-serif);font-weight:500;font-size:2.4rem;line-height:1;color:var(--ink);margin-bottom:6px;letter-spacing:-.02em}
.tier-price small{font-size:.95rem;color:var(--ink-3);font-weight:400;margin-left:6px}
.tier-blurb{font-family:var(--font-serif);font-size:.95rem;line-height:1.5;color:var(--ink-2);padding-bottom:20px;margin-bottom:20px;border-bottom:1px solid var(--rule)}
.tier-list{list-style:none;display:flex;flex-direction:column;gap:10px;margin-bottom:24px;flex-grow:1}
.tier-list li{font-size:.92rem;color:var(--ink);padding-left:18px;position:relative;line-height:1.5}
.tier-list li::before{content:'';position:absolute;left:0;top:.62em;width:8px;height:1px;background:var(--accent)}
.tier-btn{display:block;text-align:center;padding:12px 18px;font-family:var(--font-display);font-size:.74rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;border:1px solid var(--ink);color:var(--ink);background:transparent;transition:var(--transition)}
.tier-btn:hover{background:var(--ink);color:#fff}
.tier-btn.primary{background:var(--accent);color:#fff;border-color:var(--accent)}
.tier-btn.primary:hover{background:var(--accent-strong);border-color:var(--accent-strong)}

/* FAQ */
.faq{padding:110px 0;background:var(--bg-paper)}
.faq-head{max-width:720px;margin-bottom:48px}
.faq-list{list-style:none}
.faq-list>li{border-top:1px solid var(--rule);padding:0}
.faq-list>li:last-child{border-bottom:1px solid var(--rule)}
.faq-list details{padding:24px 0}
.faq-list summary{cursor:pointer;display:flex;justify-content:space-between;align-items:baseline;gap:18px;list-style:none;font-family:var(--font-serif);font-weight:500;font-size:1.25rem;line-height:1.3;color:var(--ink);transition:var(--transition)}
.faq-list summary::-webkit-details-marker{display:none}
.faq-list summary:hover{color:var(--accent-strong)}
.faq-list summary::after{content:'+';font-family:var(--font-display);font-weight:400;font-size:1.5rem;color:var(--accent);flex-shrink:0;transition:var(--transition)}
.faq-list details[open] summary::after{content:'−'}
.faq-list details p{margin-top:16px;font-family:var(--font-serif);font-size:1.0625rem;line-height:1.65;color:var(--ink-2);max-width:780px}

/* PULL QUOTE */
.pullquote-section{padding:100px 0;background:var(--bg-paper-2);border-top:1px solid var(--rule)}
.pullquote{max-width:980px;margin:0 auto;text-align:center}
.pullquote::before{content:'';display:block;width:64px;height:2px;background:var(--accent);margin:0 auto 32px}
.pullquote-text{font-family:var(--font-serif);font-style:italic;font-weight:400;font-size:clamp(1.5rem,3.5vw,2.5rem);line-height:1.25;letter-spacing:-.015em;color:var(--ink)}
.pullquote-text strong{font-weight:600;font-style:normal;background:linear-gradient(180deg,transparent 62%,rgba(190,58,75,.18) 62%,rgba(190,58,75,.18) 92%,transparent 92%);padding:0 .08em}
.pullquote-cite{display:block;margin-top:28px;font-family:var(--font-display);font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-3)}

/* CTA */
.cta{padding:110px 0;background:var(--ink);color:#F5F0E7;text-align:center;position:relative;overflow:hidden}
.cta::before{content:'';position:absolute;inset:0;background-image:radial-gradient(circle at 50% 0%,rgba(190,58,75,.20),transparent 60%);pointer-events:none}
.cta-inner{max-width:760px;margin:0 auto;position:relative}
.cta-eyebrow{display:inline-block;margin-bottom:24px;font-family:var(--font-display);font-weight:700;font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;color:var(--accent)}
.cta h2{font-family:var(--font-serif);font-style:italic;font-weight:400;font-size:clamp(2rem,4.5vw,3.25rem);line-height:1.1;letter-spacing:-.025em;color:#fff;margin-bottom:24px}
.cta h2 .em{font-style:normal;font-weight:600;color:var(--accent)}
.cta p{font-family:var(--font-serif);font-size:1.1875rem;line-height:1.65;color:#D6CDBE;margin-bottom:40px}
.cta-buttons{display:flex;flex-wrap:wrap;justify-content:center;gap:14px}

/* FOOTER */
.footer{padding:80px 0 40px;background:var(--bg-dark);color:#94A3B8}
.footer-grid{display:grid;grid-template-columns:1fr;gap:48px;margin-bottom:64px}
@media(min-width:768px){.footer-grid{grid-template-columns:2fr 1fr 1fr 1fr}}
.footer-brand p{font-size:.9375rem;line-height:1.7;max-width:320px;margin-top:20px}
.footer-col h4{font-family:var(--font-display);font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#E2E8F0;margin-bottom:20px}
.footer-col a{display:block;font-size:.9375rem;margin-bottom:14px;transition:var(--transition)}
.footer-col a:hover{color:var(--accent)}
.footer-bottom{padding-top:32px;border-top:1px solid rgba(255,255,255,0.08);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px;font-size:.84rem;color:#64748B}
.footer-links{display:flex;gap:24px}
.footer-links a:hover{color:#E2E8F0}

.door-talk { color: var(--accent); font-weight: 600; transition: var(--transition); }
.door-talk:hover { color: var(--accent-strong); }
