{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
 
  "CQRS": {
    "Endpoint": "tcp://localhost:5556",
    "ClientId": "asps-webapi",
    "SharedSecret": ""
  },
  "NetMQ": {
    "BusinessEndpoint": "tcp://localhost:5555",
    "AlertListenerEndpoint": "tcp://localhost:50001"
  },
  "AgentGateway": {
    "Enabled": true,
    "MaxConnectionsPerIp": 10,
    "MaxFrameSize": 262144,
    "UnauthenticatedTimeoutSeconds": 30,
    "AuthenticatedIdleTimeoutSeconds": 300,
    "BackendReqPort": 50001,
    "BackendPubPort": 50002,
    "RequestTimeoutSeconds": 10,
    "PingIntervalSeconds": 60
  },
  "Security": {
    "CurveEnabled": true,
    "CurveClientOnly": true,
    "ServerPublicKeyFilePath": ""
  },
  "TrackUrl": {
    "RiskThresholdToEnableTracking": 60,
    "TrackingDurationMinutes": 1440000
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
