using Xunit;
using Moq;
using FluentAssertions;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;
using Business.Data.EF;
using Business.Data.EF.Repositories;
using Common.Entities;
using Common.Models;
using Common.Enums;

namespace ASPS.Tests.Business.Repositories;

public class EntityRepositoriesTests
{
    #region UserRepository Tests

    public class UserRepositoryTests : IDisposable
    {
        private readonly AppDbContext _context;
        private readonly UserRepository _sut;

        public UserRepositoryTests()
        {
            var options = new DbContextOptionsBuilder<AppDbContext>()
                .UseInMemoryDatabase(databaseName: Guid.NewGuid().ToString())
                .Options;

            _context = new AppDbContext(options);
            _sut = new UserRepository(_context);
        }

        [Fact]
        public async Task GetByKeycloakIdAsync_WhenUserExists_ReturnsUser()
        {
            // Arrange
            var user = new User
            {
                KeyField = Guid.NewGuid().ToString(),
                KeycloakUserId = "kc-123",
                FirstName = "John",
                IsDeleted = false
            };
            await _context.Users.AddAsync(user);
            await _context.SaveChangesAsync();

            // Act
            var result = await _sut.GetByKeycloakIdAsync("kc-123");

            // Assert
            result.Should().NotBeNull();
            result.FirstName.Should().Be("John");
        }

        [Fact]
        public async Task GetByKeycloakIdAsync_WhenUserDeleted_ReturnsNull()
        {
            // Arrange
            var user = new User
            {
                KeyField = Guid.NewGuid().ToString(),
                KeycloakUserId = "kc-deleted",
                IsDeleted = true
            };
            await _context.Users.AddAsync(user);
            await _context.SaveChangesAsync();

            // Act
            var result = await _sut.GetByKeycloakIdAsync("kc-deleted");

            // Assert
            result.Should().BeNull();
        }

        [Fact]
        public async Task GetUserWithDetailsAsync_WhenUserExists_ReturnsUser()
        {
            // Arrange
            var keyField = Guid.NewGuid().ToString();
            var user = new User
            {
                KeyField = keyField,
                FirstName = "Jane",
                IsDeleted = false
            };
            await _context.Users.AddAsync(user);
            await _context.SaveChangesAsync();

            var key = new Key("User", keyField, "default");

            // Act
            var result = await _sut.GetUserWithDetailsAsync(key);

            // Assert
            result.Should().NotBeNull();
            result.FirstName.Should().Be("Jane");
        }

        [Fact]
        public async Task GetActiveUsersAsync_ReturnsOnlyActiveUsers()
        {
            // Arrange
            await _context.Users.AddRangeAsync(
                new User { KeyField = Guid.NewGuid().ToString(), FirstName = "Active1", IsDeleted = false, IsDisabled = false },
                new User { KeyField = Guid.NewGuid().ToString(), FirstName = "Deleted", IsDeleted = true, IsDisabled = false },
                new User { KeyField = Guid.NewGuid().ToString(), FirstName = "Disabled", IsDeleted = false, IsDisabled = true },
                new User { KeyField = Guid.NewGuid().ToString(), FirstName = "Active2", IsDeleted = false, IsDisabled = false }
            );
            await _context.SaveChangesAsync();

            // Act
            var result = await _sut.GetActiveUsersAsync();

            // Assert
            result.Should().HaveCount(2);
            result.Should().OnlyContain(u => !u.IsDeleted && !u.IsDisabled);
        }

        public void Dispose()
        {
            _context.Database.EnsureDeleted();
            _context.Dispose();
        }
    }

    #endregion

    #region UserDeviceRepository Tests

    public class UserDeviceRepositoryTests : IDisposable
    {
        private readonly AppDbContext _context;
        private readonly UserDeviceRepository _sut;

        public UserDeviceRepositoryTests()
        {
            var options = new DbContextOptionsBuilder<AppDbContext>()
                .UseInMemoryDatabase(databaseName: Guid.NewGuid().ToString())
                .Options;

            _context = new AppDbContext(options);
            _sut = new UserDeviceRepository(_context);
        }

        [Fact]
        public async Task GetByUserKeyAsync_ReturnsUserDevices()
        {
            // Arrange
            var userKeyField = Guid.NewGuid().ToString();
            await _context.UserDevices.AddRangeAsync(
                new PersonalComputer { KeyField = Guid.NewGuid().ToString(), UserKeyField = userKeyField, Model = "Device1", IsDeleted = false },
                new PersonalComputer { KeyField = Guid.NewGuid().ToString(), UserKeyField = userKeyField, Model = "Device2", IsDeleted = false },
                new PersonalComputer { KeyField = Guid.NewGuid().ToString(), UserKeyField = Guid.NewGuid().ToString(), Model = "OtherUser", IsDeleted = false }
            );
            await _context.SaveChangesAsync();

            var userKey = new Key("User", userKeyField, "default");

            // Act
            var result = await _sut.GetByUserKeyAsync(userKey);

            // Assert
            result.Should().HaveCount(2);
            result.Should().OnlyContain(d => d.UserKeyField == userKeyField);
        }

        [Fact]
        public async Task GetByDeviceUidAsync_WhenDeviceExists_ReturnsDevice()
        {
            // Arrange
            var device = new PersonalComputer
            {
                KeyField = Guid.NewGuid().ToString(),
                DeviceUid = "unique-device-id",
                Model = "Test Device",
                IsDeleted = false
            };
            await _context.UserDevices.AddAsync(device);
            await _context.SaveChangesAsync();

            // Act
            var result = await _sut.GetByDeviceUidAsync("unique-device-id");

            // Assert
            result.Should().NotBeNull();
            result.Model.Should().Be("Test Device");
        }

        [Fact]
        public async Task GetMonitoredDevicesAsync_ReturnsOnlyEnabledDevices()
        {
            // Arrange
            await _context.UserDevices.AddRangeAsync(
                new PersonalComputer { KeyField = Guid.NewGuid().ToString(), MonitoringStatus = DeviceMonitoringStatus.Enabled, Model = "Enabled1", IsDeleted = false },
                new PersonalComputer { KeyField = Guid.NewGuid().ToString(), MonitoringStatus = DeviceMonitoringStatus.Disabled, Model = "Disabled", IsDeleted = false },
                new PersonalComputer { KeyField = Guid.NewGuid().ToString(), MonitoringStatus = DeviceMonitoringStatus.Enabled, Model = "Enabled2", IsDeleted = false }
            );
            await _context.SaveChangesAsync();

            // Act
            var result = await _sut.GetMonitoredDevicesAsync();

            // Assert
            result.Should().HaveCount(2);
            result.Should().OnlyContain(d => d.MonitoringStatus == DeviceMonitoringStatus.Enabled);
        }

        public void Dispose()
        {
            _context.Database.EnsureDeleted();
            _context.Dispose();
        }
    }

