@page
@model WebApi.Pages.WebsiteCategories.IndexModel
@{
    ViewData["Title"] = "Website Categories";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Website Categories</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a asp-page="Create" class="btn btn-sm btn-primary">
            <i class="fas fa-plus"></i> Add Category
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.Categories == null || !Model.Categories.Any())
{
    <div class="alert alert-info">No categories found.</div>
}
else
{
    var topLevelParents = Model.Categories.Where(c => string.IsNullOrEmpty(c.ParentId)).OrderBy(c => c.Name).ToList();
    var childCategories = Model.Categories.Where(c => !string.IsNullOrEmpty(c.ParentId)).ToList();
    
    <div class="mb-3">
        <span class="badge bg-primary">@Model.Categories.Count categories</span>
        <span class="badge bg-secondary">@topLevelParents.Count groups</span>
    </div>

    @* Parent categories table (always visible) *@
    @if (topLevelParents.Any())
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="fas fa-layer-group me-2"></i> Parent Categories</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Group Name</th>
                            <th class="text-center">Children</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var parent in topLevelParents)
                        {
                            var childCount = childCategories.Count(c => c.ParentId == parent.KeyField);
                            <tr data-bs-toggle="collapse" data-bs-target="#child-@parent.KeyField.Replace("-", "")" style="cursor: pointer;">
                                <td>
                                    <i class="fas fa-folder text-warning me-2"></i>
                                    <strong>@parent.Name</strong>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary">@childCount</span>
                                </td>
                                <td class="text-end">
                                    <a asp-page="Edit" asp-route-name="@parent.Name" class="btn btn-sm btn-outline-primary" onclick="event.stopPropagation()">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </td>
                            </tr>
                            @* Child rows (hidden by default, shown when parent clicked) *@
                            <tr class="collapse" id="child-@parent.KeyField.Replace("-", "")">
                                <td colspan="3" class="bg-light p-3">
                                    <table class="table table-sm table-bordered mb-0 bg-white">
                                        <thead class="table-secondary">
                                            <tr>
                                                <th>Category Name</th>
                                                <th>Source</th>
                                                <th>Date Created</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var child in childCategories.Where(c => c.ParentId == parent.KeyField).OrderBy(c => c.Name))
                                            {
                                                <tr>
                                                    <td class="ps-4">└ @child.Name</td>
                                                    <td><code>@(child.Source ?? "-")</code></td>
                                                    <td>@child.DateCreated.ToString("yyyy-MM-dd")</td>
                                                    <td>
                                                        <a asp-page="Edit" asp-route-name="@child.Name" class="btn btn-sm btn-outline-primary btn-sm">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<style>
    tr[data-bs-toggle="collapse"] td:first-child::after {
        content: '\f107'; /* chevron-down */
        font-family: 'Font Awesome 5 Free';
        font-weight: 900;
        float: right;
        transition: transform 0.2s;
    }
    tr[data-bs-toggle="collapse"].collapsed td:first-child::after {
        content: '\f105'; /* chevron-right */
    }
</style>
