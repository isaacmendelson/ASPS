    #region AnalysisResultRepository Tests

    public class AnalysisResultRepositoryTests : IDisposable
    {
        private readonly AppDbContext _context;
        private readonly Mock<ILogger<AnalysisResultRepository>> _loggerMock;
        private readonly AnalysisResultRepository _sut;

        public AnalysisResultRepositoryTests()
        {
            var options = new DbContextOptionsBuilder<AppDbContext>()
                .UseInMemoryDatabase(databaseName: Guid.NewGuid().ToString())
                .Options;

            _context = new AppDbContext(options);
            _loggerMock = new Mock<ILogger<AnalysisResultRepository>>();
            _sut = new AnalysisResultRepository(_context, _loggerMock.Object);
        }

        [Fact]
        public async Task GetAllAsync_ReturnsNonDeletedResults()
        {
            // Arrange
            await _context.AnalysisResults.AddRangeAsync(
                new AnalysisResultContainer { KeyField = Guid.NewGuid().ToString(), IsDeleted = false },
                new AnalysisResultContainer { KeyField = Guid.NewGuid().ToString(), IsDeleted = true },
                new AnalysisResultContainer { KeyField = Guid.NewGuid().ToString(), IsDeleted = false }
            );
            await _context.SaveChangesAsync();

            // Act
            var result = await _sut.GetAllAsync();

            // Assert
            result.Should().HaveCount(2);
            result.Should().OnlyContain(r => !r.IsDeleted);
        }

        [Fact]
        public async Task GetByUserKeyAsync_ReturnsUserResults()
        {
            // Arrange
            var userKeyField = Guid.NewGuid().ToString();
            await _context.AnalysisResults.AddRangeAsync(
                new AnalysisResultContainer { KeyField = Guid.NewGuid().ToString(), UserKeyField = userKeyField, Timestamp = DateTime.UtcNow, IsDeleted = false },
                new AnalysisResultContainer { KeyField = Guid.NewGuid().ToString(), UserKeyField = Guid.NewGuid().ToString(), Timestamp = DateTime.UtcNow, IsDeleted = false }
            );
            await _context.SaveChangesAsync();

            var userKey = new Key("User", userKeyField, "default");

            // Act
            var result = await _sut.GetByUserKeyAsync(userKey);

            // Assert
            result.Should().HaveCount(1);
            result.First().UserKeyField.Should().Be(userKeyField);
        }

        [Fact]
        public async Task GetLatestAsync_ReturnsNewestResult()
        {
            // Arrange
            var userKeyField = Guid.NewGuid().ToString();
            await _context.AnalysisResults.AddRangeAsync(
                new AnalysisResultContainer { KeyField = Guid.NewGuid().ToString(), UserKeyField = userKeyField, Timestamp = DateTime.UtcNow.AddHours(-2), IsDeleted = false },
                new AnalysisResultContainer { KeyField = Guid.NewGuid().ToString(), UserKeyField = userKeyField, Timestamp = DateTime.UtcNow.AddHours(-1), IsDeleted = false }
            );
            await _context.SaveChangesAsync();

            var userKey = new Key("User", userKeyField, "default");

            // Act
            var result = await _sut.GetLatestAsync(userKey);

            // Assert
            result.Should().NotBeNull();
            result.Timestamp.Should().BeCloseTo(DateTime.UtcNow.AddHours(-1), TimeSpan.FromMinutes(1));
        }

        public void Dispose()
        {
            _context.Database.EnsureDeleted();
            _context.Dispose();
        }
    }

    #endregion

    #region DeviceAlertRepository Tests

    public class DeviceAlertRepositoryTests : IDisposable
    {
        private readonly AppDbContext _context;
        private readonly DeviceAlertRepository _sut;

        public DeviceAlertRepositoryTests()
        {
            var options = new DbContextOptionsBuilder<AppDbContext>()
                .UseInMemoryDatabase(databaseName: Guid.NewGuid().ToString())
                .Options;

            _context = new AppDbContext(options);
            _sut = new DeviceAlertRepository(_context);
        }

        [Fact]
        public async Task GetAlertsByDeviceUidAsync_ReturnsDeviceAlerts()
        {
            // Arrange
            await _context.DeviceAlerts.AddRangeAsync(
                new DeviceAlertEntity { KeyField = Guid.NewGuid().ToString(), DeviceUid = "device-123", Timestamp = DateTime.UtcNow, IsDeleted = false },
                new DeviceAlertEntity { KeyField = Guid.NewGuid().ToString(), DeviceUid = "device-123", Timestamp = DateTime.UtcNow.AddHours(-1), IsDeleted = false },
                new DeviceAlertEntity { KeyField = Guid.NewGuid().ToString(), DeviceUid = "other-device", Timestamp = DateTime.UtcNow, IsDeleted = false }
            );
            await _context.SaveChangesAsync();

            // Act
            var result = await _sut.GetAlertsByDeviceUidAsync("device-123");

            // Assert
            result.Should().HaveCount(2);
            result.Should().OnlyContain(a => a.DeviceUid == "device-123");
        }

        [Fact]
        public async Task GetRecentAlertsAsync_ReturnsAlertsWithinTimeSpan()
        {
            // Arrange
            await _context.DeviceAlerts.AddRangeAsync(
                new DeviceAlertEntity { KeyField = Guid.NewGuid().ToString(), Timestamp = DateTime.UtcNow.AddHours(-1), IsDeleted = false },
                new DeviceAlertEntity { KeyField = Guid.NewGuid().ToString(), Timestamp = DateTime.UtcNow.AddHours(-25), IsDeleted = false }
            );
            await _context.SaveChangesAsync();

            // Act
            var result = await _sut.GetRecentAlertsAsync(TimeSpan.FromHours(24));

            // Assert
            result.Should().HaveCount(1);
        }

        public void Dispose()
        {
            _context.Database.EnsureDeleted();
            _context.Dispose();
        }
    }

    #endregion

