@* WebApi/Pages/Shared/_Layout.cshtml *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ASPS Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <style>
        :root {
            --navy: #1A2255;
            --navy-dark: #111740;
            --green: #22C55E;
            --danger: #ef4444;
            --warning: #f59e0b;
            --sidebar-w: 260px;
        }
        *, *::before, *::after { box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #f0f2f8; margin: 0; display: flex; min-height: 100vh; }

        /* SIDEBAR */
        .sidebar {
            width: var(--sidebar-w); min-height: 100vh;
            background: var(--navy); display: flex; flex-direction: column;
            position: fixed; top:0; left:0; bottom:0; z-index:100;
            box-shadow: 4px 0 20px rgba(0,0,0,.18);
        }
        .sidebar-brand { padding: 12px 20px 12px; border-bottom: 1px solid rgba(255,255,255,.08); display:flex; align-items:center; min-height:64px; }
        .sidebar-section { padding:18px 16px 4px;font-size:10px;font-weight:700;color:rgba(255,255,255,.3);text-transform:uppercase;letter-spacing:.12em; }
        .sidebar .nav-link { display:flex;align-items:center;gap:12px;color:rgba(255,255,255,.65)!important;padding:10px 16px;margin:2px 10px;border-radius:8px;font-size:14px;font-weight:500;text-decoration:none;transition:all .2s; }
        .sidebar .nav-link i { width:18px;font-size:14px;text-align:center;flex-shrink:0; }
        .sidebar .nav-link:hover { background:rgba(255,255,255,.08);color:#fff!important; }
        .sidebar .nav-link.active { background:var(--green);color:#fff!important;box-shadow:0 4px 14px rgba(34,197,94,.35); }
        .sidebar-footer { margin-top:auto;padding:16px;border-top:1px solid rgba(255,255,255,.06);font-size:11px;color:rgba(255,255,255,.25);text-align:center; }

        /* TOPBAR */
        .topbar { height:64px;background:#fff;border-bottom:1px solid #e5e7ef;display:flex;align-items:center;justify-content:space-between;padding:0 28px;box-shadow:0 1px 8px rgba(26,34,85,.06);position:sticky;top:0;z-index:50; }
        .topbar-title { font-family:'Syne',sans-serif;font-size:20px;font-weight:800;color:var(--navy); }
        .topbar-right { display:flex;align-items:center;gap:20px; }
        .topbar-clock { font-size:12px;color:#6b7280;display:flex;align-items:center;gap:6px;font-family:monospace;white-space:nowrap; }
        .topbar-clock i { color:var(--green); }

        /* LAYOUT */
        .main-wrapper { margin-left:var(--sidebar-w);flex:1;display:flex;flex-direction:column;min-height:100vh; }
        .main-content { padding:24px 28px;flex:1; }

        /* STAT CARDS */
        .stat-card { background:#fff;border-radius:18px;padding:22px 90px 22px 24px;box-shadow:0 2px 16px rgba(26,34,85,.06);transition:transform .25s,box-shadow .25s;position:relative;overflow:hidden;height:100%; }
        .stat-card::before { content:'';position:absolute;top:0;left:0;right:0;height:4px; }
        .stat-card.border-blue::before   { background: var(--navy); }
        .stat-card.border-green::before  { background: var(--green); }
        .stat-card.border-amber::before  { background: var(--warning); }
        .stat-card.border-red::before    { background: var(--danger); }
        .stat-card:hover { transform:translateY(-5px);box-shadow:0 16px 40px rgba(26,34,85,.13); }
        .stat-card .card-label { font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#9ca3af;margin-bottom:10px; }
        .stat-card .card-value { font-family:'Syne',sans-serif;font-size:clamp(22px,2.2vw,34px);font-weight:800;color:var(--navy);line-height:1;margin-bottom:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
        .stat-card .card-meta { font-size:12px;color:#6b7280;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
        .stat-card .card-icon { position:absolute;right:20px;top:50%;transform:translateY(-50%);width:54px;height:54px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0; }
        .stat-card.border-blue  .card-icon { background:rgba(26,34,85,.08);color:var(--navy); }
        .stat-card.border-green .card-icon { background:rgba(34,197,94,.12);color:var(--green); }
        .stat-card.border-amber .card-icon { background:rgba(245,158,11,.12);color:var(--warning); }
        .stat-card.border-red   .card-icon { background:rgba(239,68,68,.12);color:var(--danger); }

        /* PANEL CARDS */
        .panel-card { background:#fff;border-radius:18px;box-shadow:0 2px 16px rgba(26,34,85,.06);overflow:hidden;margin-bottom:24px; }
        .panel-card .panel-header { padding:18px 24px;border-bottom:1px solid #f1f3f9;display:flex;align-items:center;justify-content:space-between; }
        .panel-card .panel-title { font-family:'Syne',sans-serif;font-size:15px;font-weight:800;color:var(--navy);display:flex;align-items:center;gap:8px; }
        .panel-card .panel-title i { font-size:14px;color:var(--green); }
        .panel-card .panel-body { padding:20px 24px; }

        /* STATUS PILLS */
        .status-pill { display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:100px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em; }
        .status-pill.ok      { background:rgba(34,197,94,.12);color:#15803d; }
        .status-pill.danger  { background:rgba(239,68,68,.12);color:#dc2626; }
        .status-pill.warning { background:rgba(245,158,11,.12);color:#b45309; }
        .status-pill .dot { width:6px;height:6px;border-radius:50%; }
        .status-pill.ok .dot      { background:var(--green); }
        .status-pill.danger .dot  { background:var(--danger); }
        .status-pill.warning .dot { background:var(--warning);animation:blink 1.2s infinite; }
        @@keyframes blink { 0%,100%{opacity:1}50%{opacity:.3} }

        /* SEVERITY */
        .sev-badge { display:inline-block;padding:2px 10px;border-radius:6px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.06em; }
        .sev-badge.high   { background:rgba(239,68,68,.13);color:#dc2626; }
        .sev-badge.medium { background:rgba(245,158,11,.13);color:#b45309; }
        .sev-badge.low    { background:rgba(34,197,94,.13);color:#15803d; }

        /* QUICK ACTIONS */
        .action-btn { display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:20px 12px;border-radius:14px;border:1.5px solid #e5e7ef;background:#fff;color:var(--navy);font-size:12px;font-weight:600;text-decoration:none;transition:all .2s;cursor:pointer;width:100%; }
        .action-btn i { font-size:22px;color:var(--green); }
        .action-btn:hover { border-color:var(--green);background:rgba(34,197,94,.05);color:var(--navy);transform:translateY(-3px);box-shadow:0 8px 24px rgba(34,197,94,.15); }

        /* SYSTEM STATUS ROW */
        .sys-row { display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f1f3f9; }
        .sys-row:last-child { border-bottom:none; }
        .sys-row .sys-name { font-size:13px;font-weight:600;color:#374151;display:flex;align-items:center;gap:8px; }
        .sys-row .sys-name i { font-size:12px;color:#9ca3af;width:16px;text-align:center; }

        /* THREAT FEED */
        .threat-row { display:flex;align-items:flex-start;gap:14px;padding:12px 0;border-bottom:1px solid #f1f3f9; }
        .threat-row:last-child { border-bottom:none; }
        .threat-icon { width:36px;height:36px;border-radius:10px;background:rgba(239,68,68,.1);color:var(--danger);display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;margin-top:2px; }
        .threat-icon.med { background:rgba(245,158,11,.1);color:var(--warning); }
        .threat-icon.low { background:rgba(34,197,94,.1);color:var(--green); }
        .threat-name { font-size:13px;font-weight:600;color:#1f2937; }
        .threat-meta { font-size:11px;color:#9ca3af;margin-top:2px; }

        /* TABLES */
        .table thead th { background:var(--navy);color:#fff;border:none;font-size:11px;text-transform:uppercase;letter-spacing:.06em; }

        /* MISC */
        .badge { padding:5px 10px;border-radius:12px;font-size:.82rem; }
        #alert-count-badge { position:relative;top:-2px; }
        .htmx-indicator { display:inline-block;width:20px;height:20px;border:3px solid #f3f3f3;border-top:3px solid var(--green);border-radius:50%;animation:spin 1s linear infinite; }
        @@keyframes spin { 0%{transform:rotate(0deg)}100%{transform:rotate(360deg)} }
        .toast-container { position:fixed;top:20px;right:20px;z-index:9999; }
        .page-section-title { font-family:'Syne',sans-serif;font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:#9ca3af;margin-bottom:16px; }
        .modal-header { background:var(--navy);color:#fff; }
        .modal-header .btn-close { filter:invert(1); }
    </style>
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>

<aside class="sidebar">
    <div class="sidebar-brand">
        <svg width="130" height="36" viewBox="0 0 150 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="0" width="3" height="40" rx="1.5" fill="url(#barGrad)"/>
            <text x="12" y="26" font-family="'Syne', sans-serif" font-weight="800" font-size="22" fill="#FFFFFF" letter-spacing="-.5">ASPS</text>
            <circle cx="20" cy="6" r="4" fill="#22C55E"/>
            <circle cx="20" cy="6" r="4" fill="#22C55E" opacity="0.3">
                <animate attributeName="r" values="4;6;4" dur="2.5s" repeatCount="indefinite"/>
                <animate attributeName="opacity" values="0.3;0;0.3" dur="2.5s" repeatCount="indefinite"/>
            </circle>
            <circle cx="20" cy="6" r="2" fill="#fff"/>
            <defs>
                <linearGradient id="barGrad" x1="0" y1="0" x2="0" y2="40" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#22C55E"/>
                    <stop offset="100%" stop-color="#16A34A"/>
                </linearGradient>
            </defs>
        </svg>
    </div>
    <div class="pt-2">
        <div class="sidebar-section">Navigation</div>
        <ul class="nav flex-column px-1">
            <li class="nav-item"><a class="nav-link" asp-page="/Index"><i class="fas fa-th-large"></i> Dashboard</a></li>
        </ul>
        <div class="sidebar-section">Management</div>
        <ul class="nav flex-column px-1">
            <li class="nav-item"><a class="nav-link" asp-page="/Users/Index"><i class="fas fa-users"></i> Users</a></li>
            <li class="nav-item"><a class="nav-link" asp-page="/Devices/Index"><i class="fas fa-mobile-alt"></i> Devices</a></li>
            <li class="nav-item">
                <a class="nav-link" asp-page="/DeviceAlerts/Index">
                    <i class="fas fa-bell"></i> Device Alerts
                    <span id="alert-count-badge" class="badge bg-danger ms-auto"></span>
                </a>
            </li>
            <li class="nav-item"><a class="nav-link" asp-page="/AnalysisResults/Index"><i class="fas fa-chart-line"></i> Analysis Results</a></li>
        </ul>
        <div class="sidebar-section">Blacklists</div>
        <ul class="nav flex-column px-1">
            <li class="nav-item"><a class="nav-link" asp-page="/KnownPhishingWebsites/Index"><i class="fas fa-ban"></i> Phishing Websites</a></li>
            <li class="nav-item"><a class="nav-link" asp-page="/BlacklistedPhoneNumbers/Index"><i class="fas fa-phone-slash"></i> Blacklisted Phone Numbers</a></li>
            <li class="nav-item"><a class="nav-link" asp-page="/BankWebsites/Index"><i class="fas fa-university"></i> Bank Websites</a></li>
        </ul>
        <div class="sidebar-section">Testing</div>
        <ul class="nav flex-column px-1">
            <li class="nav-item"><a class="nav-link" asp-page="/Simulations/Index"><i class="fas fa-play-circle"></i> Simulations</a></li>
        </ul>
        <div class="sidebar-section">System</div>
        <ul class="nav flex-column px-1">
            <li class="nav-item"><a class="nav-link" asp-page="/SystemConfigurations/Index"><i class="fas fa-cog"></i> System Config</a></li>
        </ul>
    </div>
    <div class="sidebar-footer">ASPS v1.0 &nbsp;·&nbsp; Internal Use Only</div>
</aside>

<div class="main-wrapper">
    <div class="topbar">
        <div class="topbar-title">@ViewData["Title"]</div>
        <div class="topbar-right">
            <div class="topbar-clock"><i class="fas fa-clock"></i><span id="current-time"></span></div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="dropdown">
                    <button class="btn btn-link text-decoration-none dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="color: var(--navy);">
                        <i class="fas fa-user-circle fa-lg"></i>
                        <span class="fw-medium">@(User.FindFirst("preferred_username")?.Value ?? User.Identity.Name)</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><span class="dropdown-item-text text-muted small">@User.FindFirst("email")?.Value</span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="/logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                    </ul>
                </div>
            }
        </div>
    </div>
    <div class="main-content">@RenderBody()</div>
</div>

<div class="toast-container" id="toast-container"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="https://unpkg.com/htmx.org@1.9.10"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
<script>
    function updateTime() {
        const now = new Date();
        document.getElementById('current-time').textContent = now.toUTCString().replace(' GMT','') + ' UTC';
    }
    updateTime(); setInterval(updateTime, 1000);

    document.addEventListener('DOMContentLoaded', function () {
        const p = window.location.pathname;
        document.querySelectorAll('.sidebar .nav-link').forEach(link => {
            const href = link.getAttribute('href');
            if (href && (href === p || (href === '/' && (p === '/Index' || p === '/')))) {
                link.classList.add('active');
            }
        });
    });

    function showToast(title, message, type = 'info') {
        const id = 'toast-' + Date.now();
        const bg = { success:'bg-success',error:'bg-danger',warning:'bg-warning',info:'bg-info' }[type]||'bg-info';
        document.getElementById('toast-container').insertAdjacentHTML('beforeend',
            `<div id="${id}" class="toast" role="alert"><div class="toast-header ${bg} text-white"><strong class="me-auto">${title}</strong><button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button></div><div class="toast-body">${message}</div></div>`);
        const el = document.getElementById(id);
        new bootstrap.Toast(el, {delay:5000}).show();
        el.addEventListener('hidden.bs.toast', () => el.remove());
    }

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/notificationshub").withAutomaticReconnect().build();
    connection.on("ReceiveNotification", (data) => {
        const badge = document.getElementById("alert-count-badge");
        if (badge && data.Message === "DeviceAlert") badge.textContent = (parseInt(badge.textContent)||0)+1;
        showToast("Notification", data.Message, "info");
    });
    connection.start()
        .then(() => {
            const el = document.getElementById('signalr-status');
            if (el) el.innerHTML = '<span class="dot"></span>Active';
        })
        .catch(err => {
            const el = document.getElementById('signalr-status');
            if (el) { el.innerHTML = '<span class="dot"></span>Disconnected'; el.className = 'status-pill danger'; }
        });

    document.body.addEventListener('htmx:afterSwap', function () {
        $('.data-table').DataTable({ pageLength: 25, order: [[0,'desc']] });
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
<script src="~/js/site.js"></script>
</body>
</html>
